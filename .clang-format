# The layout `omw format` holds every C++ source to, with clang-format 23.1.5 exactly (`tools/omw/pins.py`):
# LLVM's style, with the tree's width, four-space indent, and C++'s declarator layout (`int* p`, C++ Core
# Guidelines NL.18).
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
PointerAlignment: Left
AccessModifierOffset: -4
# No `} // namespace` marker: a brace's end says nothing the indentation does not.
FixNamespaceComments: false
LineEnding: LF
# OpenSceneGraph's class macros end without a semicolon, and read as declarations they swallow the next.
StatementMacros:
  - META_Object
  - META_StateAttribute
  - META_Node
