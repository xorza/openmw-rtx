#define FFX_FSR3UPSCALER_OPTION_APPLY_SHARPENING 0

#define FSR3UPSCALER_BIND_SRV_INPUT_EXPOSURE FSR_INSTABILITY_BIND_EXPOSURE
#define FSR3UPSCALER_BIND_SRV_DILATED_REACTIVE_MASKS FSR_INSTABILITY_BIND_DILATED_MASKS
#define FSR3UPSCALER_BIND_SRV_DILATED_MOTION_VECTORS FSR_INSTABILITY_BIND_DILATED_MOTION
