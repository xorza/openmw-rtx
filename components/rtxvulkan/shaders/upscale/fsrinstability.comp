// How unstable each pixel's luma has been over the last frames, which the accumulation damps by.
//
// The SDK's pass file with the renderer's binding names (`fsr.h`) and its configuration stated here
// rather than on a command line: GLSL, full floats, a frame in HDR radiance, motion vectors at the
// render extent and from the pixel's centre, and a reversed depth.

#define FFX_GPU 1
#define FFX_GLSL 1
#define FFX_HALF 0
#define FFX_FSR3UPSCALER_OPTION_HDR_COLOR_INPUT 1
#define FFX_FSR3UPSCALER_OPTION_LOW_RESOLUTION_MOTION_VECTORS 1
