#define FSR3UPSCALER_BIND_UAV_FARTHEST_DEPTH_MIP1 FSR_PYRAMID_BIND_FARTHEST_DEPTH_MIP1
#define FSR3UPSCALER_BIND_CB_FSR3UPSCALER FSR_PYRAMID_BIND_CONSTANTS
