#version 460

#extension GL_GOOGLE_include_directive : require

// Where each tile's run starts, from how many sprites `spriterects.comp` counted into it.
//
// **A prefix sum of the counts, on the device and in place.** `spritelist.glsl` says which entry holds
// what on the way in and on the way out. One workgroup: each lane sums a contiguous chunk of the
// counts, the chunk totals are scanned in shared memory, and each lane then walks its chunk again
// turning counts into starts from where its chunk begins.
//
// **The one place that knows whether the runs fit**, so it is where a tile past the room is marked
// and where the frame's need is reported. `SPRITE_TILE_UNBINNED` says what the trace does with the
// first and `SpriteBin::record` what the host does with the second.

#include "shared/tables.h"
#include "shared/spritebin.h"

#include "lib/spritelist.glsl"

layout(local_size_x = SPRITE_SCAN_WORKGROUP) in;

layout(buffer_reference, buffer_reference_align = TABLE_ALIGN_ROWS, scalar) writeonly buffer Report
{
    uint at[];
};

layout(push_constant, scalar) uniform Push
{
    SpriteBinConstants bin;
};

/// Each lane's chunk total, scanned into where its chunk's runs begin.
shared uint chunkEnds[SPRITE_SCAN_WORKGROUP];

void main()
{
    const uint tiles = spriteTilesIn(bin.mCamera.mWidth, bin.mCamera.mHeight);
    const uint lane = gl_LocalInvocationID.x;

    const uint per = (tiles + SPRITE_SCAN_WORKGROUP - 1u) / SPRITE_SCAN_WORKGROUP;
    const uint first = lane * per;
    const uint last = min(first + per, tiles);

    SpriteTileList list = SpriteTileList(bin.mList);

    uint own = 0u;
    for (uint tile = first; tile < last; ++tile)
        own += list.at[spriteCountSlot(tile)];

    chunkEnds[lane] = own;
    barrier();

    // Two barriers a round of the scan, because a lane reads a neighbour's value the same round
    // the neighbour rewrites its own.
    for (uint stride = 1u; stride < SPRITE_SCAN_WORKGROUP; stride <<= 1u)
    {
        const uint before = lane >= stride ? chunkEnds[lane - stride] : 0u;
        barrier();
        chunkEnds[lane] += before;
        barrier();
    }

    const uint head = tiles + 1u;
    const uint total = chunkEnds[SPRITE_SCAN_WORKGROUP - 1u];

    // Where this chunk's first run starts: the runs' beginning, plus every chunk before this one.
    // A tile whose run ends past the room is marked, and so is every tile after it, since the ends
    // only rise.
    const uint room = head + bin.mCapacity;
    uint running = head + chunkEnds[lane] - own;
    for (uint tile = first; tile < last; ++tile)
    {
        running += list.at[spriteCountSlot(tile)];
        list.at[spriteCountSlot(tile)] = running <= room ? running : SPRITE_TILE_UNBINNED | bin.mCount;
    }

    if (lane != 0u)
        return;

    Report(bin.mReport).at[0] = total;
    list.at[0] = head;
}
