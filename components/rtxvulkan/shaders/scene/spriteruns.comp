#version 460

#extension GL_GOOGLE_include_directive : require

// Each tile's run, filled in ascending sprite order.
//
// **From the tile's side, walking every sprite's rectangle, and that shape is the point.** A
// scatter from the sprites' side — each sprite taking a slot in every tile it reaches by an atomic
// — would be cheaper to write and would land the entries in whatever order the atomics resolved,
// which is a composite order that changes from frame to frame and a fog evaluation per sprite
// instead of per emitter's run: `spritesAlong` says why both matter. Sorting the runs afterwards
// is what that would then cost. Walking the sprites in order from the tile's side gives the order
// for nothing and needs no global atomic at all, and what it costs is tiles times sprites of an
// eight-byte load and four compares.
//
// **Thirty-two lanes to a tile, thirty-two sprites at a time.** The lanes of a tile test one
// stride of sprites each — one coalesced load for the stride — and then have to agree on the
// order of what matched: each lane that matched sets its bit in the tile's word of shared memory,
// and after a barrier every lane reads the word, counts the bits below its own for its place in
// the run, and the stride's count is how far the run moved. A subgroup ballot is the same thing
// with a device requirement attached; the shared word costs an atomic per match and a barrier per
// stride and asks nothing of the hardware.
//
// **Three words a tile and one barrier a stride.** The word a stride reads after its barrier must
// not be cleared until every lane has read it, and the word the next stride sets must be clear
// before any lane sets it — two barriers a stride, or three words cycled: after the barrier of
// stride `i` the word for stride `i + 2` is cleared, which every lane last read before the
// barrier of stride `i - 1` and will next set only after the barrier of stride `i + 1`.
//
// **A tile tests only while its run is filling, and the workgroup stops when none is.** A tile with
// an empty run, or one already full, has nothing left to place, so its lanes load no rectangle; and
// the strides end for the workgroup once each of its tiles is full, which most are long before the
// last sprite. The count of tiles still filling is cycled three ways for the reason the matched word
// is: each stride's count is complete at that stride's barrier, and read after it by every lane, so
// the stop is uniform.
//
// **Ascending sprite index within a tile, and that is load-bearing.** Sprites composite in the
// order they are walked, and a sprite's index is contiguous per emitter, so ascending index keeps
// an emitter's sprites consecutive — which is what lets the march evaluate the fog and walk the
// lamps once for a run rather than once for a sprite.

#include "shared/spritebin.h"

#include "lib/spritelist.glsl"

layout(local_size_x = SPRITE_RUNS_WORKGROUP) in;

layout(push_constant, scalar) uniform Push
{
    SpriteBinConstants bin;
};

/// Which lanes of each tile matched the stride being walked, cycled three ways.
shared uint matched[3][SPRITE_RUNS_WORKGROUP / SPRITE_RUNS_LANES];

/// How many of the workgroup's tiles go into each stride with room left in their run, cycled as
/// `matched` is.
shared uint filling[3];

void main()
{
    const uint across = spriteTilesOver(bin.mCamera.mWidth);
    const uint tiles = spriteTilesIn(bin.mCamera.mWidth, bin.mCamera.mHeight);

    const uint group = gl_LocalInvocationID.x / SPRITE_RUNS_LANES;
    const uint lane = gl_LocalInvocationID.x % SPRITE_RUNS_LANES;
    const uint tile = gl_GlobalInvocationID.x / SPRITE_RUNS_LANES;

    SpriteTileList list = SpriteTileList(bin.mList);

    // **A lane past the last tile stays for the barriers**, which every lane of the workgroup has
    // to reach; it tests nothing and writes nothing. So does a lane on a tile past the room, whose
    // run has no slots to fill: the trace walks every sprite there instead.
    const uint end = tile < tiles ? list.at[spriteStartSlot(tile + 1u)] : SPRITE_TILE_UNBINNED;
    const bool present = (end & SPRITE_TILE_UNBINNED) == 0u;

    uint x = 0u;
    uint y = 0u;
    uint slot = 0u;
    if (present)
    {
        x = tile % across;
        y = tile / across;
        slot = list.at[spriteStartSlot(tile)];
    }

    if (lane == 0u)
    {
        matched[0][group] = 0u;
        matched[1][group] = 0u;
        matched[2][group] = 0u;
    }
    if (gl_LocalInvocationID.x == 0u)
    {
        filling[0] = 0u;
        filling[1] = 0u;
        filling[2] = 0u;
    }

    const uint below = (1u << lane) - 1u;
    SpriteRects rects = SpriteRects(bin.mRects);

    barrier();

    bool fills = present && slot < end;
    if (lane == 0u && fills)
        atomicAdd(filling[0], 1u);

    uint stride = 0u;
    for (uint base = 0u; base < bin.mCount; base += SPRITE_RUNS_LANES, ++stride)
    {
        const uint sprite = base + lane;

        bool hit = false;
        if (fills && sprite < bin.mCount)
        {
            uvec2 from;
            uvec2 to;
            unpackSpriteRect(rects.at[sprite], from, to);

            hit = x >= from.x && x <= to.x && y >= from.y && y <= to.y;
        }

        const uint current = stride % 3u;
        if (hit)
            atomicOr(matched[current][group], 1u << lane);

        barrier();

        // Every tile that went into this stride counted itself before the barrier.
        if (filling[current] == 0u)
            break;

        const uint word = matched[current][group];

        // **Held inside the run's own end, which the count pass sized from the same rectangles.**
        // The two agree by construction, so the bound is never met — and a pass that ever
        // disagreed with its own count would overrun a neighbour's run rather than say so, which
        // the compare is cheaper than.
        if (hit)
        {
            const uint at = slot + bitCount(word & below);
            if (at < end)
                list.at[at] = sprite;
        }

        slot += bitCount(word);
        fills = fills && slot < end;
        if (lane == 0u && fills)
            atomicAdd(filling[(stride + 1u) % 3u], 1u);

        if (lane == 0u)
            matched[(stride + 2u) % 3u][group] = 0u;
        if (gl_LocalInvocationID.x == 0u)
            filling[(stride + 2u) % 3u] = 0u;
    }
}
