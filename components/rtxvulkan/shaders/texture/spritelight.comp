#version 460

#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

// What a sprite's own texture leaves of the light crossing it, baked from its alpha, made where
// the texture is.
//
// **`Rtx::SpriteLightMap`, on the device.** Six-way lighting for a billboard: for every texel and
// each of the four in-plane directions, how much light from that side reaches it through the
// texels between, as a running product of `(1 - a) ^ (1 / N)` over a level `N` texels across —
// written to a texel *before* that texel's own alpha is multiplied in, because what reaches a
// texel is what the ones beyond it let through and not what it lets through itself. The channels
// are light from `+u`, `-u`, `+v` and `-v` in the texture's own coordinates, as `sprites.glsl`
// reads. On the device because the source is uploaded anyway and the bake is read by nothing but
// the trace: made on the host it walked every texel of every level four times on the frame the
// first flame of a cell stood, and it was the one texture reading the cell ring never read ahead.
//
// **A running product along each line, one channel a stage**: a lane walks its row or its column
// from the edge the light comes from, writing each texel the product so far before multiplying its
// own in, so a level costs a `pow` and a multiply a texel a channel. The order of the multiplies is
// the host's — from the far edge inward — so the two agree to the last multiply and differ only in
// `pow`. One channel a stage, because a texel's four are written by four lanes: each stage stores
// the channels the stages before it wrote, read back as stored, beside its own, and a channel
// stored once and read back is the byte it was.

#include "scene.h"
#include "shared/sets.h"
#include "shared/spritelight.h"

#include "lib/census.glsl"
#include "lib/pixels.glsl"

layout(local_size_x = SPRITE_LIGHT_WORKGROUP) in;

/// The sprite, every level, fetched by texel.
layout(set = SET_PASS, binding = SPRITE_LIGHT_BIND_SOURCE) uniform texture2D source;

/// The level of the bake this dispatch writes, and reads the stages before it back from.
layout(set = SET_PASS, binding = SPRITE_LIGHT_BIND_BAKE, TEXTURE_WRITTEN_FORMAT) uniform image2D bake;

layout(push_constant, scalar) uniform Push
{
    SpriteLightConstants level;
};

/// What a ray keeps for crossing one texel of alpha `alpha` in a line `count` texels long.
float across(float alpha, uint count)
{
    return pow(1.0 - alpha, 1.0 / float(count));
}

float alphaAt(uint x, uint y)
{
    return texelFetch(source, ivec2(x, y), int(level.mLevel)).a;
}

/// Writes `light` into the channel this stage owns at `at`, beside what the stages before wrote.
void keep(ivec2 at, float light)
{
    vec4 kept = level.mStage == SPRITE_LIGHT_FROM_RIGHT ? vec4(0.0) : imageLoad(bake, at);
    kept[level.mStage] = light;
    RTX_STORE_COUNTED(bake, at, kept)
}

void main()
{
    const uint line = gl_GlobalInvocationID.x;
    const bool rows = level.mStage < SPRITE_LIGHT_FROM_BELOW;
    if (line >= (rows ? level.mHeight : level.mWidth))
        return;

    // From the edge the light comes from: right to left for light from `+u`, left to right for
    // light from `-u`, and so up and down a column.
    const uint length = rows ? level.mWidth : level.mHeight;
    const bool backward = level.mStage == SPRITE_LIGHT_FROM_RIGHT || level.mStage == SPRITE_LIGHT_FROM_BELOW;

    float light = 1.0;
    for (uint step = 0u; step < length; ++step)
    {
        const uint along = backward ? length - 1u - step : step;
        const uvec2 at = rows ? uvec2(along, line) : uvec2(line, along);
        keep(ivec2(at), light);
        light *= across(alphaAt(at.x, at.y), length);
    }
}
