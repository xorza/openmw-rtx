#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require

// An image made on the device of one channel or two, encoded as BC4 or BC5 blocks, every level in
// one dispatch and one lane a block, for the reason `bc7encode.comp` gives. A chain of the channels
// its file held: a BC5 normal map's blue is nought where a reader looks for one, which a format
// that shares a bit across four channels does not keep.
//
// **Each channel a BC4 block, between its least and its most**, with the eight values the first end
// point's being the larger names, and each texel the index of the value nearest it. The fit
// `stb_dxt` and every runtime encoder of the format make: two end points of a byte and eight steps
// between them hold a channel to within a fourteenth of its spread, where a search of the end
// points gains a fraction of that. A block of one value is that value at index nought.
//
// **In integers alone**: a texel's byte times seven against each value times seven, which is what
// the decoder's division by seven leaves, so the nearest is chosen exactly and no float is rounded.

#include "lib/blocklevel.glsl"
#include "scene.h"
#include "shared/rgtc.h"
#include "shared/sets.h"

layout(local_size_x = BLOCK_ENCODE_WORKGROUP) in;

/// Every level, through its view with no curve under it; past the chain's last, that level again.
layout(set = SET_PASS, binding = BLOCK_ENCODE_BIND_SOURCE, TEXTURE_WRITTEN_FORMAT) uniform readonly image2D
    sources[BLOCK_ENCODE_MOST_LEVELS];

/// The chain's blocks, two words a channel.
layout(set = SET_PASS, binding = BLOCK_ENCODE_BIND_BLOCKS, std430) writeonly buffer Blocks
{
    uint blocks[];
};

layout(push_constant, scalar) uniform Push
{
    RgtcConstants chain;
};

/// Writes `value`'s low `bits` into `packed` from bit `at` on, and moves `at` past them.
void put(inout uvec2 packed, inout uint at, uint value, uint bits)
{
    const uint word = at >> 5u;
    const uint shift = at & 31u;
    packed[word] |= value << shift;
    if (shift + bits > 32u)
        packed[word + 1u] |= value >> (32u - shift);
    at += bits;
}

/// One channel's block of `bytes`, the block's sixteen texels of it, of which those `inside` the
/// level, a bit each, are fitted.
uvec2 channelBlock(uint bytes[16], uint inside)
{
    uint least = 255u;
    uint most = 0u;
    for (uint texel = 0u; texel < 16u; ++texel)
    {
        const bool counted = ((inside >> texel) & 1u) != 0u;
        least = counted ? min(least, bytes[texel]) : least;
        most = counted ? max(most, bytes[texel]) : most;
    }

    // The first end point the larger, so the indices name eight values. One value is index nought
    // of either mode: both end points it.
    uvec2 block = uvec2(0u);
    uint at = 0u;
    put(block, at, most, 8u);
    put(block, at, least, 8u);
    for (uint texel = 0u; texel < 16u; ++texel)
    {
        // `step` sevenths of the way from the least to the most, nearest the texel: the format
        // names the most nought, the least one, and the sixth to the first seventh two to seven.
        const uint target = RGTC_STEPS * bytes[texel];
        uint best = 0u;
        uint apart = 0xffffffffu;
        for (uint step = 0u; step <= RGTC_STEPS; ++step)
        {
            const uint value = (RGTC_STEPS - step) * least + step * most;
            const uint distance = value > target ? value - target : target - value;
            best = distance < apart ? step : best;
            apart = min(distance, apart);
        }
        const uint index = most == least ? 0u : best == RGTC_STEPS ? 0u : best == 0u ? 1u : RGTC_STEPS + 1u - best;
        put(block, at, index, 3u);
    }
    return block;
}

void main()
{
    ChainBlock block;
    if (!chainBlock(uvec2(chain.mWidth, chain.mHeight), chain.mLevels, block))
        return;

    const uvec2 corner = uvec2(block.mWithin % block.mAcross, block.mWithin / block.mAcross) * BLOCK_SIDE;
    uint red[16];
    uint green[16];
    uint inside = 0u;
    for (uint texel = 0u; texel < 16u; ++texel)
    {
        const uvec2 at = corner + uvec2(texel % BLOCK_SIDE, texel / BLOCK_SIDE);
        inside |= (at.x < block.mExtent.x && at.y < block.mExtent.y ? 1u : 0u) << texel;
        const uvec4 bytes = uvec4(round(imageLoad(sources[block.mLevel], ivec2(min(at, block.mExtent - 1u))) * 255.0));
        red[texel] = bytes.r;
        green[texel] = bytes.g;
    }

    // Red's block first, and green's after it where there is green: one channel's words, or two's.
    const uint words = chain.mChannels * 2u;
    const uvec2 redBlock = channelBlock(red, inside);
    blocks[block.mIndex * words] = redBlock.x;
    blocks[block.mIndex * words + 1u] = redBlock.y;
    if (chain.mChannels == 2u)
    {
        const uvec2 greenBlock = channelBlock(green, inside);
        blocks[block.mIndex * words + 2u] = greenBlock.x;
        blocks[block.mIndex * words + 3u] = greenBlock.y;
    }
}
