#version 460

#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

// The levels a texture needs, built on the device where its file carried none.
//
// **The chain `Rtx::TextureData::wantsCompletedChain` asks for, on the device.** A hundred and eighty-seven of Morrowind's textures ship one
// level, the rain among them, and read at their finest a drop's peak alpha is 0.400 where the
// levels below hold 0.283, 0.129 and 0.068 — a storm as hard white marks that flicker. Made on the
// host this decoded every texel of the finest level and box-filtered every level under it on the
// cell ring's worker, and uploaded the lot loose; here the file's own bytes are uploaded as they
// are, in whichever block format they came in, and one dispatch a level makes the rest.
//
// **The finest level is fetched and not filtered**, texel for texel out of the upload through a
// view with no curve under it, so the bytes a file holds are the bytes the chain's first level
// holds. **Every other level is the box over the one above it** (`axisTaps`), **and a colour's are
// weighed by the alpha carrying them**: a punch-through block stores black where nothing was
// painted, and an even mean draws a dark rim round every leaf card and every raindrop one level
// down. In light and not in bytes, because the mean of two stored bytes is not the byte of their
// mean; the alpha is linear in every format and is the even mean of its own. Where nothing under a
// texel was painted there is no weight to divide by, and the even mean is what is left. **Data and
// a normal map take the even box** (`MipChainConstants::mCoverage`): their alpha is a height or a
// gloss, and weighing by it took a dark texel's height out of the mean. The host's rule, texel for
// texel, so that `RtxMipChainPassTest` can hold the two to a byte.

#include "colour.h"
#include "shared/halving.h"
#include "shared/mipchain.h"
#include "scene.h"
#include "shared/sets.h"

#include "lib/census.glsl"
#include "lib/pixels.glsl"

layout(local_size_x = MIP_CHAIN_WORKGROUP, local_size_y = MIP_CHAIN_WORKGROUP) in;

/// The upload: the file's finest level, in its own format read as `UNORM`, so a fetch is the
/// stored bytes and not the light behind them.
layout(set = SET_PASS, binding = MIPCHAIN_BIND_SOURCE) uniform texture2D source;

/// The level above the one written, through the chain's own `UNORM` view — the bytes as stored,
/// decoded here where the format says to. Bound to the level written for the first dispatch,
/// which reads it not at all.
layout(set = SET_PASS, binding = MIPCHAIN_BIND_ABOVE, TEXTURE_WRITTEN_FORMAT) uniform readonly image2D above;

/// The level this dispatch writes.
layout(set = SET_PASS, binding = MIPCHAIN_BIND_INTO, TEXTURE_WRITTEN_FORMAT) uniform writeonly image2D into;

layout(push_constant, scalar) uniform Push
{
    MipChainConstants level;
};

void main()
{
    const uvec2 texel = gl_GlobalInvocationID.xy;
    if (outsideOf(texel, uvec2(level.mWidth, level.mHeight)))
        return;

    const uint x = texel.x;
    const uint y = texel.y;

    if (level.mLevel == 0u)
    {
        RTX_STORE_COUNTED(into, ivec2(x, y), texelFetch(source, ivec2(x, y), 0))
        return;
    }

    const uvec2 extentAbove = uvec2(imageSize(above));
    const AxisTaps across = axisTaps(x, extentAbove.x);
    const AxisTaps down = axisTaps(y, extentAbove.y);
    const bool encoded = level.mEncoded != 0u;

    // **Nine taps, weighed by the two axes' weights**, a weight of nought where an axis takes two:
    // its third tap is held inside the level and counts for nothing.
    vec3 weighed = vec3(0.0);
    vec3 even = vec3(0.0);
    float painted = 0.0;
    for (uint dy = 0u; dy < 3u; ++dy)
        for (uint dx = 0u; dx < 3u; ++dx)
        {
            const float weight = across.mWeights[dx] * down.mWeights[dy];
            const uvec2 at = min(uvec2(across.mFirst + dx, down.mFirst + dy), extentAbove - 1u);
            const vec4 texel = imageLoad(above, ivec2(at));
            const vec3 colour = encoded ? decodeSrgb(texel.rgb) : texel.rgb;

            even += colour * weight;
            weighed += colour * (texel.a * weight);
            painted += texel.a * weight;
        }

    const vec3 mean = level.mCoverage != 0u && painted > 0.0 ? weighed / painted : even;
    RTX_STORE_COUNTED(into, ivec2(x, y), vec4(encoded ? encodeSrgb(mean) : mean, painted))
}
