#version 460

#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

// A normal map's spread, measured on the device as it arrives.
//
// **What each level of the map has lost of the normals it averages**, as the roughness that loss
// stands for (`normalSpreadSlopes`): a level's texel is the mean of the texels over it, and where
// they point different ways the mean is shorter than one, which is how much of the relief a cone
// that reads the level can no longer show. `NormalSpreadPass` says why it is kept.
//
// **The means are carried, and the loss beside them**, because a spread is not an average of
// spreads: four texels that each agree with themselves and disagree with each other have a spread
// none of the four has. The loss is `1 - |mean|²`, and the variance of a set of vectors is what
// adds it up level by level exactly: the children's losses weighed as their means are, and what
// the means lose to each other, `Σ wᵢ wⱼ |mᵢ - mⱼ|²` over the pairs — a sixteenth of each pair's
// where four children weigh a quarter each. That is a sum of differences, so normals that agree
// lose nought to the bit, where `1 - |mean|²` taken from the mean's own length loses a float's last
// place. The first level boxes the map's own texels, decoded as the trace decodes them and made
// unit, which lose nothing of their own. **The box is `mipchain.comp`'s** (`axisTaps`): nine
// children where both axes above are odd, so the spread is of the texels the level's normal holds.

#include "brdf.h"
#include "halving.h"
#include "shared/normalspread.h"
#include "shared/sets.h"

#include "lib/census.glsl"
#include "lib/normaldecode.glsl"
#include "lib/pixels.glsl"

layout(local_size_x = NORMAL_SPREAD_WORKGROUP, local_size_y = NORMAL_SPREAD_WORKGROUP) in;

/// The normal map, at its finest level.
layout(set = SET_PASS, binding = NORMALSPREAD_BIND_SOURCE) uniform texture2D source;

/// The means of the level before the one written. Bound to the level written for the first
/// dispatch, which reads the map instead.
layout(set = SET_PASS, binding = NORMALSPREAD_BIND_ABOVE, NORMAL_SPREAD_MEAN_FORMAT) uniform readonly image2D above;

/// The means of the level written, for the dispatch after this one.
layout(set = SET_PASS, binding = NORMALSPREAD_BIND_MEAN, NORMAL_SPREAD_MEAN_FORMAT) uniform writeonly image2D mean;

/// What the level written has lost, which the trace reads.
layout(set = SET_PASS, binding = NORMALSPREAD_BIND_SPREAD, NORMAL_SPREAD_FORMAT) uniform writeonly image2D spread;

layout(push_constant, scalar) uniform Push
{
    NormalSpreadConstants level;
};

void main()
{
    const uvec2 texel = gl_GlobalInvocationID.xy;
    if (outsideOf(texel, uvec2(level.mWidth, level.mHeight)))
        return;

    // Which level this is holds for the whole dispatch, so the two reads are a branch no lane
    // diverges on.
    const bool first = level.mLevel == 1u;
    const uvec2 extentAbove = uvec2(first ? textureSize(source, 0) : imageSize(above));
    const AxisTaps across = axisTaps(texel.x, extentAbove.x);
    const AxisTaps down = axisTaps(texel.y, extentAbove.y);

    // The nine a box can cover, a weight of nought on an axis that takes two: its third tap is held
    // inside the level and counts for nothing.
    vec4 child[9];
    float weight[9];
    for (uint at = 0u; at < 9u; ++at)
    {
        const uvec2 tap = uvec2(at % 3u, at / 3u);
        const ivec2 from = ivec2(min(uvec2(across.mFirst, down.mFirst) + tap, extentAbove - 1u));
        weight[at] = across.mWeights[tap.x] * down.mWeights[tap.y];
        if (first)
            child[at] = vec4(normalize(decodeNormal(texelFetch(source, from, 0).rgb)), 0.0);
        else
            child[at] = imageLoad(above, from);
    }

    vec3 averaged = vec3(0.0);
    float loss = 0.0;
    for (uint one = 0u; one < 9u; ++one)
    {
        averaged += child[one].xyz * weight[one];
        loss += child[one].w * weight[one];
        for (uint other = one + 1u; other < 9u; ++other)
        {
            const vec3 between = child[one].xyz - child[other].xyz;
            loss += weight[one] * weight[other] * dot(between, between);
        }
    }

    RTX_STORE_COUNTED(mean, ivec2(texel), vec4(averaged, loss))
    RTX_STORE_COUNTED(spread, ivec2(texel), vec4(slopeRoughness(normalSpreadSlopes(loss)), 0.0, 0.0, 0.0))
}
