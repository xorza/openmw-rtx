#version 460

#extension GL_GOOGLE_include_directive : require

// The luminance histogram reduced to the one number the display curve scales by.
//
// One workgroup of exactly `EXPOSURE_BINS` threads: the whole job is a 256-element weighted sum, and
// dispatching it apart from the curve is what stops every one of the curve's workgroups redoing it.

#include "shared/exposure.h"
#include "shared/sets.h"

layout(local_size_x = EXPOSURE_BINS) in;

layout(set = SET_PASS, binding = EXPOSURE_BIND_HISTOGRAM, scalar) buffer Histogram
{
    uint bins[];
};

layout(set = SET_PASS, binding = EXPOSURE_BIND_EXPOSURE, scalar) buffer Exposure
{
    float exposure;
};

layout(push_constant, scalar) uniform Push
{
    ExposureConstants frame;
};

/// Each bin's population and the pixels in the bins under it, the black one left out: a scan, so a
/// bin knows which share of the lit pixels it holds.
shared uint below[EXPOSURE_BINS];

/// What each bin adds to the trimmed mean: its index times how many of its pixels fall between the
/// two shares (`EXPOSURE_LOW_SHARE`). **Floats and not a word**: a bin's index times its population
/// passes thirty-two bits past 16.8 million pixels, and a float's rounding of a count that large is
/// a part in sixteen million.
shared float weighted[EXPOSURE_BINS];

void main()
{
    const uint index = gl_LocalInvocationIndex;

    // Bin zero holds the pixels too dark to bin. They are left out of the shares as well as the
    // mean — an interior is mostly them, and counting them would pull the average onto the floor
    // and open the exposure until the lit parts blew out.
    const uint black = bins[0];
    const uint count = index == 0u ? 0u : bins[index];

    // An inclusive scan of the populations, a step of twice the reach each time.
    below[index] = count;
    barrier();
    for (uint reach = 1u; reach < EXPOSURE_BINS; reach <<= 1u)
    {
        const uint earlier = index >= reach ? below[index - reach] : 0u;
        barrier();
        below[index] += earlier;
        barrier();
    }

    // **The mean bin over the lit pixels between the two shares**, which is the mean *log*
    // luminance there because the bins are logarithmic: each bin counts the part of its population
    // that falls between them.
    const float lit = float(frame.mPixels - min(black, frame.mPixels));
    const float low = lit * EXPOSURE_LOW_SHARE;
    const float high = lit * EXPOSURE_HIGH_SHARE;
    const float after = float(below[index]);
    const float before = after - float(count);
    weighted[index] = max(min(after, high) - max(before, low), 0.0) * float(index);
    barrier();

    // Tree reduction over the workgroup: 256 values to one in eight steps, in a fixed order.
    for (uint stride = EXPOSURE_BINS / 2u; stride > 0u; stride >>= 1u)
    {
        if (index < stride)
            weighted[index] += weighted[index + stride];
        barrier();
    }

    if (index != 0u)
        return;

    // **A frame with no past moves from no exposure the frame before left**: the first frame of a
    // run and any frame the renderer was told to reconstruct without one. The buffer holds the eye
    // of a world that is gone, and the time since the frame before is that world's. The reset says
    // so and nothing else does: a frame no time after the last is a frame the eye had no time to
    // move in.
    const float held = frame.mReset == EXPOSURE_RESET_NONE ? exposure : EXPOSURE_DAY;

    // **What this frame asks for, which is not yet what it gets.** Every branch below settles a
    // target and exactly one write happens after them.
    float target;
    if (frame.mPixels <= black)
    {
        // Nothing was bright enough to bin, so there is nothing to expose for, and the eye stays
        // where it stands: a black frame is no light the eye meets — a world still arriving, or a
        // night with nothing in it — and a target of one opened a day's eye by stops on the empty
        // frames a load begins with.
        target = held;
    }
    else
    {
        const float meanBin = weighted[0] / (high - low);

        const float meanLuminance = binLuminance(meanBin);

        // **The hour and the compensation are applied before the clamps and before the approach**, so
        // what the eye moves toward is already the held-back value: a bias taken off afterwards would
        // be a second adaptation chasing the first.
        target = clamp(frame.mBias * exp2(EXPOSURE_COMPENSATION)
                * pow(EXPOSURE_KEY / max(meanLuminance, 1e-6), EXPOSURE_ADAPTATION),
            EXPOSURE_MIN, EXPOSURE_MAX);
    }

    // **Such a frame holds a bright day's exposure** (`EXPOSURE_DAY`), which the frames after it
    // open from — or takes what it measured outright, for a measured run (`Rtx::EyeStart`).
    if (frame.mReset != EXPOSURE_RESET_NONE)
    {
        exposure = frame.mReset == EXPOSURE_RESET_SETTLED ? target : held;
        return;
    }

    // **Adaptation happens over time, and this was the only term in the frame that did not.** The
    // rate is asymmetric because the eye is: opening in the dark is slow and closing in the light is
    // quick.
    const float tau = target > held ? EXPOSURE_RISE_SECONDS : EXPOSURE_FALL_SECONDS;

    // `1 - exp(-dt / tau)` and not a fixed fraction per frame: the same share of the gap closes per
    // second whether the second held one frame or two hundred, so the picture does not change when
    // the frame time does. **In stops**, as the eye adapts: a share of the gap in the exposure
    // itself closed a step up in a fifth of the time a step down took at the same rate, and turned
    // the asymmetry the two rates are for around.
    const float closed = clamp(1.0 - exp(-frame.mElapsed / tau), 0.0, 1.0);
    exposure = held * exp2(log2(target / held) * closed);
}
