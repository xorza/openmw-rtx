#version 460

#extension GL_GOOGLE_include_directive : require
// No format, because the images that reach this binding are not one format: the composite's
// frame at whichever width the run chose, or the upscaler's half floats.
#extension GL_EXT_shader_image_load_formatted : require

// Scene-referred radiance to bytes a display understands, and the sky's own points over it.
//
// The one pass that knows what a display is, and the last in the frame: everything before it works in
// linear radiance, including the upscaler, which reconstructs from several frames of it.

#include "camera.h"
#include "colour.h"
#include "gbuffer.h"
#include "scene.h"
#include "shared/sets.h"
#include "shared/tone.h"

#include "lib/bloom.glsl"
#include "lib/bluenoise.glsl"
#include "lib/census.glsl"
#include "lib/pixels.glsl"
#include "lib/spritelist.glsl"
#include "lib/starfield.glsl"

layout(local_size_x = TONE_WORKGROUP, local_size_y = TONE_WORKGROUP) in;

/// The finished frame in linear radiance, at whatever resolution the pass before this produced.
layout(set = SET_PASS, binding = TONE_BIND_COLOUR) uniform readonly image2D colour;

/// The picture, as bytes a display understands: `TONE_TARGET_FORMAT`, or `TONE_DEEP_FORMAT` for a
/// summed frame's second run. No format declared, so the one kernel stores into either.
layout(set = SET_PASS, binding = TONE_BIND_TARGET) uniform writeonly image2D target;

/// What the backdrop is seen through, at the trace's own extent. `bindings.glsl` declares the other
/// end of it.
layout(set = SET_PASS, binding = TONE_BIND_BACKDROP, GBUFFER_BACKDROP) uniform readonly image2D backdrop;

/// What to scale the frame by before the curve — measured off this same image by the two passes
/// before this one, or written straight in where a caller named a fixed value.
layout(set = SET_PASS, binding = TONE_BIND_EXPOSURE, scalar) readonly buffer Exposure
{
    float exposure;
};

/// The bloom pyramid's finest level, which holds the blur of every level under it.
layout(set = SET_PASS, binding = TONE_BIND_BLOOM) uniform sampler2D bloom;

/// How much of the sun's quad the eye can see, eased — `sunglare.comp` — or nought for a picture.
layout(set = SET_PASS, binding = TONE_BIND_SUN_GLARE, scalar) readonly buffer SunGlareShare
{
    float sunGlareShare;
};

/// The surface the trace saw at the traced extent, for the arms' flag `puffsCoverNothing` reads —
/// `packSurfaceDistance`.
layout(set = SET_PASS, binding = TONE_BIND_SURFACE, GBUFFER_SURFACE) uniform readonly image2D surfaceChannel;

/// What Night-Eye's lift is multiplied by, at the traced extent — `CHANNEL_LIFT` — sampled
/// bilinearly, so the picture an upscaler reconstructed takes the lift at the place each of its
/// pixels shows.
layout(set = SET_PASS, binding = TONE_BIND_LIFT) uniform sampler2D liftChannel;

layout(push_constant, scalar) uniform Push
{
    ToneConstants frame;
};

/// The blue-noise tile, `ToneConstants::mBlueNoise`.
layout(buffer_reference, scalar, buffer_reference_align = TABLE_ALIGN_ROWS) readonly buffer DitherTile
{
    float at[];
};

/// `value` with a triangular dither of up to `ToneConstants::mDitherStep` either way added, before the
/// store rounds it.
///
/// Triangular, because a step of uniform dither leaves the error's power following the signal, and a
/// triangle twice as wide makes the noise's power one whatever the value (Lipshitz, Wannamaker and
/// Vanderkooy, 1992).
vec3 dithered(vec3 value, uvec2 pixel)
{
    const float tiled = DitherTile(frame.mBlueNoise).at[tileIndex(pixel, STREAM_DITHER)];
    const float centred = 2.0 * turnedTile(tiled, frame.mFrame, STREAM_DITHER) - 1.0;
    const float triangular = sign(centred) * (1.0 - sqrt(1.0 - abs(centred)));
    return value + triangular * frame.mDitherStep;
}

/// `CHANNEL_LIFT` at the place `pixel` of the picture shows, `ToneConstants::mLiftOffset`. Held inside the
/// traced extent, which a picture inside the interface fills only a corner of its channels with.
///
/// A picture the trace drew at its own extent reads its own texel: the place is the texel's centre to the
/// bit, and a bilinear read there is the texel.
vec3 liftAt(uvec2 pixel, uvec2 extent)
{
    const vec2 traced = vec2(frame.mTracedWidth, frame.mTracedHeight);
    const vec2 place
        = clamp((vec2(pixel) + 0.5) * traced / vec2(extent) + frame.mLiftOffset, vec2(0.5), traced - 0.5);
    return textureLod(liftChannel, place / vec2(textureSize(liftChannel, 0)), 0.0).rgb;
}

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uvec2 extent = uvec2(frame.mCamera.mWidth, frame.mCamera.mHeight);
    if (outsideOf(pixel, extent))
        return;

    const ivec2 at = ivec2(pixel);
    vec4 lit = imageLoad(colour, at);

    // **What the lens does with the light that reached it**, and the last thing done in linear
    // radiance. `BloomPass` says why there is no threshold and why the pyramid is mixed rather than
    // added; `ToneConstants::mBloom` says why it lands here and not on the radiance image itself.
    if (frame.mBloom > 0.0)
    {
        // Where the pixel's centre stands in the finest level, which halved this grid: `bloomup.comp`'s
        // own placing, so a picture of odd width spreads the level it built and not one stretched.
        const vec2 uv = (vec2(pixel) + 0.5) * 0.5 * frame.mBloomTexel;
        lit.rgb = mix(lit.rgb, bloomSpread(bloom, uv, frame.mBloomTexel), frame.mBloom);
    }

    // **What is left of the backdrop at this pixel**, asked only where something reads it: a frame
    // whose star sheet is not in has nothing to draw through it, and pays neither load. Night-Eye's
    // lift asks what the puffs leave of what lies behind them. Pushed, so every lane takes one side.
    TexelTable texels = TexelTable(frame.mTextureTexels);
    const bool stars = frame.mBackdrop == BACKDROP_STARS && holdsTexture(texels, frame.mStars.mTexture);
    const bool picture = frame.mBackdrop == BACKDROP_INTERFACE;
    const bool lifting = any(greaterThan(frame.mNightEye, vec3(0.0)));

    float alpha = 1.0;
    vec3 lift = vec3(0.0);
    if (stars || picture || lifting)
    {
        // Not this pass's to work out — a moon, a cloud deck, a window pane, the water and the air all
        // stand between the backdrop and the eye, and every one of them is the trace's — so the trace
        // states it and this multiplies by it.
        const uvec2 traced = tracedPixelUnder(pixel, extent, uvec2(frame.mTracedWidth, frame.mTracedHeight));

        // And through the puffs, whose transmittance the composite left in the frame's alpha at this pass's
        // own resolution wherever it drew one; where it drew none it wrote nothing, and the alpha there is
        // whatever the upscaler left.
        const float puffs = frame.mPuffs == 0u
                || puffsCoverNothing(SpriteTileList(frame.mSpriteTileList), SpritePresence(frame.mSpritePresence),
                    frame.mTracedWidth, traced,
                    surfaceOnArms(imageLoad(surfaceChannel,
                        channelAt(CHANNEL_SURFACE, ivec2(traced), frame.mTracedWidth, fieldSwapOf(frame.mFrame)))
                            .y))
            ? 1.0
            : lit.a;

        const ivec2 behind = channelAt(CHANNEL_BACKDROP, ivec2(traced), frame.mTracedWidth, fieldSwapOf(frame.mFrame));
        const vec3 shown = imageLoad(backdrop, behind).rgb * puffs;

        // The sky's own points, drawn where they are shown (`ToneConstants::mStars` says why they are not
        // the trace's), after the veil and so outside it: the pyramid is built before this pass runs.
        if (stars && any(greaterThan(shown, vec3(0.0))))
            lit.rgb += shown
                * starField(frame.mStars, texels, rayAt(frame.mCamera, vec2(pixel)).mDirection, pixelBlur(frame.mCamera));

        // **A picture's alpha is how much of it there is**: the interface shows through it as much as the
        // backdrop does — one channel of three, which `PictureTracer` holds equal by holding such a picture
        // out of the air and the water.
        alpha = picture ? 1.0 - shown.g : 1.0;

        // **Night-Eye's lift, behind the puffs as the backdrop is**: the rasterizer adds it to the
        // surfaces it lights, which the particles are drawn over.
        if (lifting)
            lift = frame.mNightEye * liftAt(pixel, extent) * puffs;
    }

    // The glare fader and Night-Eye's lift go over the encoded picture, added and clamped: the rasterizer
    // adds each in the display's own values and the framebuffer saturates them. So both are added here,
    // after the curve and the encode, where the meter, which measured the frame before this pass, never
    // sees them.
    const vec3 encoded = encodeSrgb(toneMap(graded(lit.rgb * exposure, TONE_CONTRAST, TONE_SATURATION)));
    const vec3 washed
        = min(encoded + frame.mGlareColour * (frame.mGlareAmount * sunGlareShare) + lift, vec3(1.0));

    // **The player's gamma over the whole of that**, for the reason `ToneConstants::mInverseGamma`
    // gives. A push constant, so `displayGamma`'s test of one is taken alike by every lane.
    RTX_STORE_COUNTED(target, at, vec4(dithered(displayGamma(washed, frame.mInverseGamma), pixel), alpha))
}
