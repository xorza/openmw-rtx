#version 460

#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// The launch itself, asked of the device directly: every invocation writes where it stood, at the
// place its own launch index names.
//
// **What this proves is the ray generation record and `vkCmdTraceRaysKHR`**, which the trace depends
// on and which nothing else in this renderer would notice being wrong: a table whose handle landed
// at the wrong offset, or a launch whose grid is not the one that was asked for, draws a picture
// that is missing or garbled rather than one that says what happened. `RtxProbeTest` is the same
// idea for the buffer reads. The miss and hit records are the trace's own tests': the sky and every
// surface are drawn through them.

#include "sets.h"

layout(set = SET_PASS, binding = 0, scalar) writeonly buffer Launched
{
    uvec2 launched[];
};

void main()
{
    const uvec2 at = gl_LaunchIDEXT.xy;
    launched[at.y * gl_LaunchSizeEXT.x + at.x] = at;
}
