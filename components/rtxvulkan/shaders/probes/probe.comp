#version 460

#extension GL_GOOGLE_include_directive : require

// One pattern of `vec3`s, read four ways, with every reading written out so the host can say which of them
// is wrong rather than only that they disagree:
//
// **This is the question that stopped the geometry blocking**: swapping the normal fetch from a descriptor to
// a `buffer_reference` changed the picture, and without a way to ask the device directly it could only be
// answered by elimination over a whole traced frame.

#include "shared/probe.h"
#include "scene.h"
#include "shared/sets.h"

#include "lib/runs.glsl"

layout(local_size_x = PROBE_WORKGROUP) in;

layout(set = SET_PASS, binding = PROBE_BIND_SOURCE, scalar) readonly buffer Source
{
    vec3 sourceValues[];
};

layout(set = SET_PASS, binding = PROBE_BIND_READINGS, scalar) writeonly buffer Readings
{
    vec3 readings[];
};

// Where the blocks are. A host-written buffer (`BufferKind::HostWritten`) of addresses read through
// a descriptor, which is exactly the shape the blocked scene needs and the one part of it nothing
// had asked the device about.
layout(set = SET_PASS, binding = PROBE_BIND_BLOCKS, scalar) readonly buffer Blocks
{
    uint64_t blockAddresses[];
};

// The same two addresses again, out of a uniform block: the shape `Frame` carries `GpuTables` in.
layout(set = SET_PASS, binding = PROBE_BIND_ADDRESSES, scalar) uniform Addresses
{
    ProbeAddresses addressed;
};

layout(set = SET_PASS, binding = PROBE_BIND_ROW_READINGS, scalar) writeonly buffer RowReadings
{
    ProbeRow rowReadings[];
};

layout(buffer_reference, buffer_reference_align = PROBE_ROW_ALIGN, scalar) readonly buffer Rows
{
    ProbeRow rows[];
};

layout(push_constant, scalar) uniform Push
{
    ProbeConstants probe;
};

void main()
{
    const uint at = gl_GlobalInvocationID.x;
    if (at >= probe.mCount)
        return;

    readings[at] = sourceValues[at];
    readings[probe.mCount + at] = Vec3Run(probe.mSource).at[at];
    readings[2u * probe.mCount + at] = Vec3Run(blockAddresses[at / probe.mBlock]).at[at % probe.mBlock];
    readings[3u * probe.mCount + at] = Vec3Run(addressed.mSource).at[at];

    rowReadings[at] = Rows(addressed.mRows).rows[at];
}
