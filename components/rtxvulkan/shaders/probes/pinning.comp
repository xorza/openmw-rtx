#version 460

#extension GL_GOOGLE_include_directive : require

// Each operation the build pins by rewriting it, computed on one case a thread and written out one
// float at a time, for `RtxPinningTest` to hold against the order `spirvpin.hpp` states. The GLSL is
// the built-ins themselves: what the device runs is what the build made of them, which is the point.

#include "shared/pinning.h"
#include "shared/sets.h"

layout(local_size_x = PINNING_WORKGROUP) in;

layout(set = SET_PASS, binding = PINNING_BIND_CASES, scalar) readonly buffer Cases
{
    PinningCase cases[];
};

layout(set = SET_PASS, binding = PINNING_BIND_RESULTS, scalar) writeonly buffer Results
{
    float results[];
};

layout(push_constant, scalar) uniform Push
{
    PinningConstants pinning;
};

void main()
{
    const uint at = gl_GlobalInvocationID.x;
    if (at >= pinning.mCount)
        return;

    const PinningCase one = cases[at];
    const vec3 a = one.mA.xyz;
    const vec3 b = one.mB.xyz;
    const vec3 c = one.mC.xyz;
    const uint into = at * PINNING_RESULTS;

    results[into + PINNING_DOT] = dot(a, b);
    results[into + PINNING_DOT_OF_FOUR] = dot(one.mA, one.mB);

    const vec3 crossed = cross(a, b);
    const vec3 mixed = mix(a, b, one.mC.w);
    const vec3 turned = mat3(a, b, c) * vec3(one.mA.w, one.mB.w, one.mC.w);
    const vec3 reflected = reflect(a, b);
    const vec3 facing = faceforward(a, b, c);
    for (uint axis = 0u; axis < 3u; ++axis)
    {
        results[into + PINNING_CROSS + axis] = crossed[axis];
        results[into + PINNING_MIX + axis] = mixed[axis];
        results[into + PINNING_MATRIX + axis] = turned[axis];
        results[into + PINNING_REFLECT + axis] = reflected[axis];
        results[into + PINNING_FACEFORWARD + axis] = facing[axis];
    }

    results[into + PINNING_PRODUCT_AND_SUM] = one.mA.x * one.mB.x + one.mC.x;

    // Each of these beside the core the device computes inside it, from the same steps: the inverse
    // square root, the division, the square root and the floor.
    const vec3 normalized = normalize(a);
    const float cosine = dot(b, a);
    const vec3 refracted = refract(a, b, one.mC.w);
    for (uint axis = 0u; axis < 3u; ++axis)
    {
        results[into + PINNING_NORMALIZE + axis] = normalized[axis];
        results[into + PINNING_REFRACT + axis] = refracted[axis];
    }
    results[into + PINNING_INVERSE_LENGTH] = inversesqrt(dot(a, a));
    results[into + PINNING_SMOOTHSTEP] = smoothstep(a.x, b.x, c.x);
    results[into + PINNING_QUOTIENT] = (c.x - a.x) / (b.x - a.x);
    results[into + PINNING_ROOT] = sqrt(max(1.0 - one.mC.w * one.mC.w * (1.0 - cosine * cosine), 0.0));
    results[into + PINNING_MOD] = mod(a.y, b.y);
    results[into + PINNING_FLOOR] = floor(a.y / b.y);
}
