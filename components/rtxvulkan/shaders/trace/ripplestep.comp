#version 460

#extension GL_GOOGLE_include_directive : require

// One step of the wave equation over the ripple field: the springs `lib/water/ripples.glsl`
// states, which are what the rasterizer's `RipplesSurface` steps its own field by.
//
// **Read where the window stood and written where it stands.** The field follows the eye by whole
// texels, and the old field is read at the offset the window moved by, so a ring the eye walks past
// stays where it was stamped. A texel the old window did not hold reads as still water.
//
// **The two heights ride in one texel**: the height in `x` and the height a step before in `y`,
// which is what a second-order step needs and all it needs.
//
// **And the impulses are stamped here, on the way out.** The rasterizer's blobber presses a ring
// into the field before its simulate reads it; this presses the same ring into what the step just
// wrote, which the next step then propagates — one step later, and no second pass over a
// million texels. A texel loops over the frame's impulses, which is nought on nearly every frame
// and a handful when somebody wades.

#include "shared/ripple.h"
#include "shared/sets.h"
#include "lib/census.glsl"
#include "lib/pixels.glsl"

layout(local_size_x = RIPPLE_WORKGROUP, local_size_y = RIPPLE_WORKGROUP) in;

layout(set = SET_PASS, binding = RIPPLE_STEP_BIND_BEFORE, RIPPLE_FIELD_FORMAT) uniform readonly image2D before;
layout(set = SET_PASS, binding = RIPPLE_STEP_BIND_AFTER, RIPPLE_FIELD_FORMAT) uniform writeonly image2D after;

layout(set = SET_PASS, binding = RIPPLE_STEP_BIND_IMPULSES, scalar) readonly buffer Impulses
{
    GpuRippleImpulse impulses[];
};

/// Whether any texel of the field is not nought once the frame's last step has written it: a word
/// the host reads back, which a workgroup with a moving texel sets.
layout(set = SET_PASS, binding = RIPPLE_STEP_BIND_MOVING, scalar) buffer Moving
{
    uint moving;
};

layout(push_constant, scalar) uniform Push
{
    RippleStepConstants step;
};

shared uint movingHere;

/// What `ripples_blobber.frag` presses at `texel` for one impulse: a ring of the impulse's radius,
/// pressing both heights a fifth of the way to `mStrength` on the ring and less either side of it,
/// a sixtieth — over `mPress` of them, what that many presses keep (`RippleStepConstants`). The
/// ring and not a disc, because a footfall's rim is what a wake is made of.
vec2 pressed(vec2 heights, GpuRippleImpulse impulse, vec2 texel)
{
    const float away = length(impulse.mAt - texel) / max(impulse.mRadius, 1.0e-3);
    const float kept = pow(clamp(0.2 * abs(away - 1.0) + 0.8, 0.0, 1.0), step.mPress);

    return mix(vec2(impulse.mStrength), heights, kept);
}

/// The height a step before at `texel` of the new window, off the old one, or nought past it.
vec2 was(ivec2 texel)
{
    const ivec2 old = texel + step.mShift;
    if (outsideOf(old, uvec2(RIPPLE_GRID)))
        return vec2(0.0);

    return imageLoad(before, old).xy;
}

void stepTexel(ivec2 texel)
{
    const vec2 held = was(texel);

    const float neighbours = was(texel + ivec2(1, 0)).x + was(texel - ivec2(1, 0)).x + was(texel + ivec2(0, 1)).x
        + was(texel - ivec2(0, 1)).x;

    // `applySprings` over a step of any length, `RippleStepConstants` says how: what the height
    // moved over the last step carried on, and the coupling to the four neighbours less what the
    // height gives away and its own damping, as an acceleration.
    const float pull = RIPPLE_STIFFNESS * (neighbours - 4.0 * held.x) - RIPPLE_HEIGHT_DAMPING * held.x;
    const float stepped = held.x + (held.x - held.y) * step.mCarry + pull * step.mScale;
    const float next = abs(stepped) < RIPPLE_STILL ? 0.0 : stepped;

    // Bounded by the constant as every loop here is, and the count below it: the host never hands
    // more than the buffer holds, and a count that said otherwise would read past it.
    vec2 heights = vec2(next, held.x);
    for (uint at = 0u; at < min(step.mCount, RIPPLE_IMPULSES_MOST); ++at)
        heights = pressed(heights, impulses[at], vec2(texel) + 0.5);

    RTX_STORE_COUNTED(after, texel, vec4(heights, 0.0, 0.0))
    if (step.mReport != 0u && heights != vec2(0.0))
        atomicOr(movingHere, 1u);
}

void main()
{
    if (gl_LocalInvocationIndex == 0u)
        movingHere = 0u;
    barrier();

    // Every lane on to the barrier below, so the dispatch's overhang reaches it too.
    const uvec2 cell = gl_GlobalInvocationID.xy;
    if (!outsideOf(cell, uvec2(RIPPLE_GRID)))
        stepTexel(ivec2(cell));
    barrier();

    if (step.mReport != 0u && gl_LocalInvocationIndex == 0u && movingHere != 0u)
        atomicOr(moving, 1u);
}
