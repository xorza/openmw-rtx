#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The direct light of every pixel's solid, a stage of its own after the trace (`visibility.comp`): the
// sun's and the moons' passages, the lamps and the solid's own glow (`SolidLight`), added to the direct
// channel by what the media in front and a water path let through, and the shadowed sources and the lobe's
// light written by what the layers let through as well.
//
// Runs before the layers' stage (`panes.comp`), so the solid's light stands behind them; what the layers let
// through is the throughput's fourth, which this stage leaves off. The trace's hit is resolved again with no
// traversal (`storedSolidOf`).

#include "shared/traceconstants.h"
#include "camera.h"
#include "gbuffer.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/census.glsl"
#include "lib/frame.glsl"
#include "lib/pixels.glsl"
#include "lib/shading.glsl"
#include "lib/shadowed.glsl"
#include "lib/stage.glsl"
#include "lib/traversal.glsl"
#include "lib/underwater.glsl"
#include "lib/variants.glsl"

layout(local_size_x = TRACE_WORKGROUP_LANES) in;

const uint DIRECT_SKY = 0u;
const uint DIRECT_SKY_OVER = 1u;
const uint DIRECT_LAMP = 2u;
const uint DIRECT_LISTED_LAMP = 3u;
const uint DIRECT_RAYS = 4u;

void main()
{
    uvec2 pixel;
    if (!stagePixelOf(pixel))
        return;

    const uint width = frame.mEyes.mWorld.mWidth;
    const uint swap = fieldSwapOf(frame.mFrame);
    const ivec2 stored = storedAt(ivec2(pixel), width, swap);
    const StageRecord record = unpackStageRecord(imageLoad(stageRecord, stored));

    // **The one writer of the shadowed sources and the lobe's light**, at every pixel: no shadowed
    // source and no lobe where no solid stands, which the trace wrote before this stage wrote them
    // again over every solid. And of the lamps the pixel's rays reached, none there.
    Shadowed sky = noShadowed();
    Shadowed lamps = noShadowed();
    vec4 lobe = vec4(vec3(0.0), SPECULAR_NO_LOBE);
    uvec2 seenLamps = uvec2(LAMP_LIST_NONE);
    if (record.mKind != STAGE_NO_SOLID)
    {
        // **The solid the trace found, resolved off the hit it stored** (`storedSolidOf`), and its
        // light worked out whole but for what its rays answer (`solidLightOf`): its lamps in two
        // strata, by the list of the tile it stood in on the frame before (`lampListOf`).
        const LampList list = lampListOf(pixel, imageLoad(motion, stored).xy);
        const SolidLight light = solidLightOf(storedSolidOf(record, stored), pixel, list);

        Passage skyFirst = openPassage();
        Passage skyOver = openPassage();
        Passage lampPassage = openPassage();
        Passage listedPassage = openPassage();
        [[dont_unroll]] for (uint turn = 0u; turn < DIRECT_RAYS; ++turn)
        {
            // **A lamp's ray asked at its turn**, of the row its stratum keeps and the tile's draw read again,
            // and not held through the traversals before it: two asks of a whole query each spilled the stage
            // past its registers.
            RayAsk ask;
            if (turn == DIRECT_SKY)
                ask = light.mSkyRay;
            else if (turn == DIRECT_SKY_OVER)
                ask = light.mSkyOverRay;
            else if (turn == DIRECT_LAMP)
                ask = heldLampRay(light.mRestLamps, light.mLeaving, light.mStep, unitPair(pixel, STREAM_LAMP_DISC));
            else
                ask = heldLampRay(
                    light.mListedLamps, light.mLeaving, light.mStep, unitPair(pixel, STREAM_LAMP_DISC_LISTED));

            const Passage passage = passageAnswered(answerAsked(ask));
            if (turn == DIRECT_SKY)
                skyFirst = passage;
            else if (turn == DIRECT_SKY_OVER)
                skyOver = passage;
            else if (turn == DIRECT_LAMP)
                lampPassage = passage;
            else
                listedPassage = passage;
        }

        const SeenSolid seen = seenSolidOf(light,
            light.mSkyBent ? joinedPassage(skyFirst, skyOver, light.mSkyPath, light.mSkySource.mLimb) : skyFirst,
            lampPassage, listedPassage);

        // **The solid's light under the layers**, by what the media and the path let through, as
        // the trace took the water's own light down (`visibility.comp`); **its shadowed sources and
        // its lobe by the layers' share as well**, which no stage lays over them.
        const vec4 through = imageLoad(stageThroughput, stored);
        const vec3 transmittance = through.rgb * through.a;

        const ivec2 directAt = channelAt(CHANNEL_DIRECT, ivec2(pixel), width, swap);
        RTX_STORE_COUNTED(
            direct, directAt, vec4(imageLoad(direct, directAt).rgb + seen.mLight.mRest * through.rgb, 1.0))

        sky = dimmed(seen.mLight.mSky, transmittance);
        lamps = dimmed(seen.mLight.mLamps, transmittance);
        lobe = vec4(seen.mSpecular * transmittance, seen.mRoughness);
        seenLamps = uvec2(seenLampOf(light.mRestLamps, lampPassage), seenLampOf(light.mListedLamps, listedPassage));
    }

    RTX_STORE_COUNTED(shadowed, channelAt(CHANNEL_SHADOWED, ivec2(pixel), width, swap),
        vec4(sky.mLight, packShadowAlpha(sky.mOpen > 0.0, sky.mPenumbra)))
    RTX_STORE_COUNTED(lamped, channelAt(CHANNEL_LAMPED, ivec2(pixel), width, swap),
        vec4(lamps.mLight, packShadowAlpha(lamps.mOpen > 0.0, lamps.mPenumbra)))
    RTX_STORE_COUNTED(lampedShare, channelAt(CHANNEL_LAMPED_SHARE, ivec2(pixel), width, swap), vec4(lamps.mOpen))
    RTX_STORE_WORDS(stageLampsSeen, stored, uvec4(seenLamps, 0u, 0u))

    // **The lobe's light only where a surface can have one**: the channel holds no lobe already
    // without the maps' code (`GBuffer::begin`).
    if (HAS_MAPS)
        RTX_STORE_COUNTED(specular, channelAt(CHANNEL_SPECULAR, ivec2(pixel), width, swap), lobe)
}
