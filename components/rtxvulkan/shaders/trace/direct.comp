#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The direct light of every pixel's solid, a stage of its own after the trace (`visibility.comp`):
// the sun's and the moons' passages, the lamps and the solid's own glow, which `SolidRun` gathers,
// added to the direct channel by what the media in front and a water path let through, and the
// shadowed sources and the lobe's light written by what the layers let through as well.
//
// **Before the layers' stage**, which lays the layers over the direct channel (`panes.comp`), so the
// solid's light stands behind them when it does: what the layers let through is the throughput's
// fourth, which this stage leaves off the light it adds.
//
// **The trace's hit, resolved again with no traversal** (`storedSolidOf`), as the bounce's stage
// resolves it.

#include "shared/traceconstants.h"
#include "camera.h"
#include "gbuffer.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/census.glsl"
#include "lib/frame.glsl"
#include "lib/pixels.glsl"
#include "lib/shading.glsl"
#include "lib/shadowed.glsl"
#include "lib/stage.glsl"
#include "lib/traversal.glsl"
#include "lib/underwater.glsl"
#include "lib/variants.glsl"

layout(local_size_x = TRACE_WORKGROUP_WIDTH, local_size_y = TRACE_WORKGROUP_HEIGHT) in;

void main()
{
    uvec2 pixel;
    if (!stagePixelOf(pixel))
        return;

    const uint width = frame.mEyes.mWorld.mWidth;
    const uint swap = fieldSwapOf(frame.mFrame);
    const ivec2 stored = storedAt(ivec2(pixel), width, swap);
    const StageRecord record = unpackStageRecord(imageLoad(stageRecord, stored));

    // **The one writer of the shadowed sources and the lobe's light**, at every pixel: no shadowed
    // source and no lobe where no solid stands or its walk was cut, which the trace wrote before
    // this stage wrote them again over every solid.
    Shadowed sky = noShadowed();
    Shadowed lamps = noShadowed();
    vec4 lobe = vec4(vec3(0.0), SPECULAR_NO_LOBE);
    if (record.mKind != STAGE_NO_SOLID)
    {
        // **The solid the trace found, resolved off the hit it stored** (`storedSolidOf`).
        Surface surface = storedSolidOf(record, stored);

        // **Innermost first**: a walk is under way only while the one that started it waits on it.
        SkyPassageRun skyPassage = skyPassageRunOf(
            frame.mSun, vec3(0.0), vec3(0.0), BentPath(0.0, vec3(0.0), 0.0, vec2(0.0)), vec2(0.0), false);
        GatherRun gather = gatherRunOf(0u, 0u, PATH_SEEN, false, false);
        SolidRun solid = solidRunOf();
        skyPassage.mStep = RUN_IDLE;
        gather.mStep = RUN_IDLE;

        RayAsk ask = noRay();
        stepSolid(solid, gather, surface, pixel);

        uint turns = 0u;
        [[dont_unroll]] while ((ask.mTraced || solid.mStep != RUN_IDLE) && turns < WALK_TURNS)
        {
            ++turns;
            RayAnswer answered = RayAnswer(false, unansweredScene());
            if (ask.mTraced)
            {
                answered = RayAnswer(true, queryScene(ask.mQuery));
                if (ask.mResolved)
                    surface = resolveAsked(answered.mMet, ask.mQuery);
            }
            ask = noRay();

            if (skyPassage.mStep != RUN_IDLE)
                stepSkyPassage(skyPassage, answered, ask);
            else if (gather.mStep != RUN_IDLE)
                stepGather(gather, skyPassage, surface, pixel, answered, ask);
            else
                stepSolid(solid, gather, surface, pixel);
        }

        if (solid.mStep != RUN_IDLE)
            atomicAdd(counts.mWalksCut, 1u);
        else
        {
            // **The solid's light under the layers**, by what the media and the path let through, as
            // the trace took the water's own light down (`visibility.comp`); **its shadowed sources and
            // its lobe by the layers' share as well**, which no stage lays over them.
            const vec4 through = imageLoad(stageThroughput, stored);
            const vec3 transmittance = through.rgb * through.a;
            const SeenSolid seen = solid.mSeen;

            const ivec2 directAt = channelAt(CHANNEL_DIRECT, ivec2(pixel), width, swap);
            RTX_STORE_COUNTED(
                direct, directAt, vec4(imageLoad(direct, directAt).rgb + seen.mLight.mRest * through.rgb, 1.0))

            sky = dimmed(seen.mLight.mSky, transmittance);
            lamps = dimmed(seen.mLight.mLamps, transmittance);
            lobe = vec4(seen.mSpecular * transmittance, seen.mRoughness);
        }
    }

    RTX_STORE_COUNTED(shadowed, channelAt(CHANNEL_SHADOWED, ivec2(pixel), width, swap),
        vec4(sky.mLight, packShadowAlpha(sky.mOpen > 0.0, sky.mPenumbra)))
    RTX_STORE_COUNTED(lamped, channelAt(CHANNEL_LAMPED, ivec2(pixel), width, swap),
        vec4(lamps.mLight, packShadowAlpha(lamps.mOpen > 0.0, lamps.mPenumbra)))

    // **The lobe's light only where a surface can have one**: the channel holds no lobe already
    // without the maps' code (`GBuffer::begin`).
    if (HAS_MAPS)
        RTX_STORE_COUNTED(specular, channelAt(CHANNEL_SPECULAR, ivec2(pixel), width, swap), lobe)
}
