#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_image_load_formatted : require

// The puffs over the reconstructed frame, at the resolution it is shown at.
//
// **After the denoiser and the upscaler, because neither should touch a particle.** A sprite is
// not noise in a ray-traced estimate, so a denoiser given one reconstructs it as an error; and a
// particle an upscaler took at the traced extent would be drawn at a fraction of the picture's
// resolution and stretched. So the trace leaves the puffs in a layer of their own and this launch
// composites them over the frame — `airBefore + colour * opacity + added + T * (frame - airBefore)`,
// which is exact for a layer in front of the haze behind it.
//
// **The shape at the shown extent and the light at the traced one.** What a picture needs at
// its own resolution is a puff's edge: which pixels it covers and how much. What it does not need
// there is the light, which is read out of froxels that are a hundred pixels across and costs
// three fetches a sprite — marched at every shown pixel, a storm's frame paid five times what it
// did. So the sprites are marched here for their shape alone (`spritesAlong` with `lit` off), and
// the colour comes off the trace's own lit layer, read bilinearly and weighted by its coverage so
// a rim the traced grid missed borrows from the pixel beside it. The cloud shells are gathered here
// whole, light and all — `mediumAlong` is one walk a pixel and lights its layer once — so nothing
// but the sprites' light is taken from the traced grid.
//
// **One pass whatever reconstructs the frame.** Without an upscaler the shown extent is the traced
// one and this runs at it; nothing else composites a puff anywhere in this renderer.
//
// **One invocation a traced pixel, for every shown pixel whose centre lands on it.** Whether a
// puff can be there at all is a fact about the traced pixel — its tile's run of sprites and its
// shells — and most of every frame holds none. Launched over the shown grid, each of the three
// shown pixels over a traced one at `balanced` made the same test at the occupancy the full path's
// registers allow: 0.30 ms of a 4K frame, where the traced grid takes 0.12. The shown pixels are
// the run `shownPixelsFrom` gives, so each is composited exactly as it was.
//
// **Where the eye's view ends, found again along the shown pixel's own ray.** The traced grid is
// jittered for the upscaler, so the depth one of its pixels holds at a silhouette is the post on one
// frame and the water behind it on the next — and a puff hidden by the one and not the other was
// drawn over the post's edge on every other frame, in blocks of the traced grid: the rope and the
// posts of Seyda Neen's pier shook under M[FR]'s mist, which stood still with the puffs taken away.
// The shown ray is not jittered and neither is the picture the upscaler reconstructs, so a depth
// found along it holds still with the edge it hides a puff behind. One ray query, with no material
// resolved, where a puff can stand at all.
//
// **A launch and not a dispatch**, for the reason `RtxSourceTreeTest` gives: this traces, and so
// does the fog the sprite march reaches, and a dispatch that can trace answers differently under
// another process's preemption.

#include "camera.h"
#include "scene.h"
#include "sets.h"

#include "lib/bindings.glsl"
#include "lib/fog.glsl"
#include "lib/frame.glsl"
#include "lib/medium.glsl"
#include "lib/pixels.glsl"
#include "lib/sprites.glsl"

/// The frame as it will be shown, read and written in place.
layout(set = SET_PASS, binding = BIND_SHOWN) uniform image2D shown;

layout(push_constant, scalar) uniform Push
{
    PuffConstants picture;
};

/// Adds one traced pixel's lit sprites to a gather, weighted by `near` and by how much they covered
/// there, so a traced pixel the puff missed says nothing and one it covered speaks for the rim
/// beside it. Clamped to the grid's edge, which is the neighbour the sampler would have read there.
void gatherLit(ivec2 tap, uvec2 tracedExtent, float near, inout vec3 lit, inout float weight)
{
    const vec4 read = imageLoad(puffs, clamp(tap, ivec2(0), ivec2(tracedExtent) - 1));
    const float covered = (1.0 - puffsThrough(read)) * near;

    lit += read.rgb * covered;
    weight += covered;
}

/// Composites the puffs over one shown pixel, whose centre falls in `traced`.
///
/// @param arms whether the trace drew `traced` on an arm, whose eye the pixel's ray then leaves.
void compositeAt(uvec2 pixel, uvec2 extent, uvec2 tracedExtent, uvec2 traced, bool arms)
{
    const vec2 across = vec2(tracedExtent) / vec2(extent);

    // The traced camera on this grid — `cameraOnGrid` says why it is the same basis.
    const Camera camera = cameraOnGrid(eyeOf(uint(arms)), extent.x, extent.y);

    const Ray ray = rayAt(camera, vec2(pixel));
    const vec3 origin = frame.mOrigin + ray.mOffset;
    const vec3 direction = ray.mDirection;

    const Cone cone = coneAt(camera);

    const uvec2 binned = binnedPixel(traced, direction, arms);
    const uint present = presenceAt(SpriteTileList(frame.mTables.mSpriteTileList),
        SpritePresence(frame.mTables.mSpritePresence), tracedExtent.x, binned);

    // **Where a puff is hidden: the eye's own rule, along this pixel's own ray** — the world's
    // mask, what the eye sees through walked past and the eye's culling, as `fogdepth.rgen` finds
    // where a column's view ends. The header says why not the traced grid's. Not for the arms,
    // whose ray leaves an eye of its own a few units off and whose depth the trace already has.
    //
    // **The whole ray, and not only as far as the last emitter it passes.** That bound is exact —
    // a surface beyond every emitter hides none — and it lost: under M[FR]'s mist nearly every ray
    // passes one, and the walk of the tile's sprites it took to find the bound cost this launch a
    // tenth to a fifth of a millisecond more than the longer query it saved, at 2560 by 1440.
    const float distance = arms ? imageLoad(surfaceChannel, ivec2(traced)).y
                                : surfaceWithin(WorldRay(origin, direction), 0.0, frame.mFar, cone,
                                    RayRule(worldMask(frame.mRayMask), true, true));

    // The sprites' shape, and where they stand, off this pixel's own march.
    PuffLayer layer = spritesAlong(binned, origin, direction, distance, cone, false);

    // **The additive meshes, gathered here beside the flames** for the reason this launch draws
    // the flames at all: at the picture's own extent and past the denoiser. One query against a
    // mask a handful of instances carry, and only in the tiles one of them can be met from.
    if ((present & PRESENCE_ADDITIVE) != 0u)
        layer.mAdded += additiveAlong(traced, origin, direction, distance, cone);

    // The sprites' lit colour, off the traced layer around this pixel: each of the four nearest
    // traced pixels weighted by how near it is — `gatherLit`.
    if (layer.mTransmittance < 1.0)
    {
        const vec2 at = (vec2(pixel) + 0.5) * across - 0.5;
        const vec2 corner = floor(at);
        const vec2 share = at - corner;

        vec3 lit = vec3(0.0);
        float weight = 0.0;
        for (int i = 0; i < 4; ++i)
        {
            const ivec2 quad = ivec2(i & 1, i >> 1);
            const vec2 near = mix(vec2(1.0) - share, share, vec2(quad));
            gatherLit(ivec2(corner) + quad, tracedExtent, near.x * near.y, lit, weight);
        }

        // **Where all four missed, the ring around them**, weighted by a tent two traced pixels wide.
        // The traced layer is hidden where the traced grid's jittered depth is, and this pixel's
        // shape is not: at a silhouette the traced pixels under this one can all have met the post
        // on a frame this pixel's ray passes beside it, and the colour fell back to the ambient
        // alone — the puff went dark over the edge on those frames. A branch, where the fallback
        // below always was one: the four answer for nearly every pixel, and the ring is read only
        // at a silhouette or round a puff smaller than a traced pixel.
        if (!(weight > 0.0))
            for (int i = 0; i < 16; ++i)
            {
                const ivec2 step = ivec2(i & 3, i >> 2) - 1;
                const vec2 near = max(vec2(1.0) - abs(corner + vec2(step) - at) * 0.5, vec2(0.0));
                gatherLit(ivec2(corner) + step, tracedExtent, near.x * near.y, lit, weight);
            }

        // A puff smaller than a traced pixel, standing between centres that all missed it: its own
        // unlit colour, lit as the air around it is. Rare, and one read.
        layer.mColour = weight > 0.0 ? lit / weight : layer.mColour * frame.mAmbient;
    }

    // **The cloud shells, gathered along this pixel's own ray and lit where they stand**, and then
    // put together with the sprites as the trace once did — `mergedPuffs`. Here and not in the
    // trace because what a shell hides and lets through is a question about the ray the picture
    // shows, which the traced grid's jittered sample is not. Only in a tile whose rays can meet
    // one, which is most of every frame's tiles not.
    if ((present & PRESENCE_MEDIUM) != 0u)
        layer = mergedPuffs(layer, mediumAlong(traced, origin, direction, distance, cone));

    const float opacity = 1.0 - layer.mTransmittance;

    // **The puffs' transmittance rides in the frame's alpha**, for the display pass to draw the
    // backdrop through: the star field, or the interface a picture is laid over.
    const vec4 before = imageLoad(shown, ivec2(pixel));

    if (!(opacity > 0.0) && !any(greaterThan(layer.mAdded, vec3(0.0))))
    {
        imageStore(shown, ivec2(pixel), vec4(before.rgb, 1.0));
        return;
    }

    // **The air in front of the layer, so that it covers only what is behind it.** `visibility.rgen`
    // states the identity this is: the frame holds the whole path's haze over the surface, and a
    // puff a few units out must not take two hundred units of haze away with it. The near half is
    // read again as the whole one's own prefix, and the clamp is what a pair quantised apart by a
    // froxel slice can need.
    const vec3 airBefore = opacity > 0.0 ? fogAlong(traced, WorldRay(origin, direction), layer.mCoveredAt).xyz : vec3(0.0);

    const vec3 composited
        = airBefore + layer.mColour * opacity + layer.mAdded + layer.mTransmittance * max(before.rgb - airBefore, vec3(0.0));

    // **Behind a see-through arm, the world's puffs are laid down by what the arms let through.**
    // The rasterizer draws the arms after every particle, so the smoke behind a Chameleon's hand is
    // seen through the hand as the room is — and the frame here holds the two already blended, the
    // arms' share `A` over `t` of the world `W`. Putting the puffs between them exactly wants `A`,
    // which the reconstruction has mixed into the frame at a resolution the trace never ran at. So
    // the whole frame is taken for the world behind the arms, and the puffs are laid over it by
    // `t`: exact where no arm stands and where one lets nothing through, and elsewhere off by
    // `t (1 - T) (A - (1 - t) W)` — nothing where the arm is the colour of what it stands over, and
    // at `t` of a half no more than a quarter of the puff's opacity times that contrast. A puff
    // between the eye and a see-through hand is laid down behind it the same way, by `t` and not
    // whole. Selected and not mixed where no arm stands, so the world's own pixel is the composite
    // to the bit.
    const float armsThrough = arms ? 1.0 : imageLoad(backdrop, ivec2(traced)).a;
    const vec3 laid = armsThrough < 1.0 ? mix(before.rgb, composited, armsThrough) : composited;

    imageStore(shown, ivec2(pixel), vec4(laid, layer.mTransmittance));
}

void main()
{
    const uvec2 traced = gl_LaunchIDEXT.xy;
    const uvec2 tracedExtent = gl_LaunchSizeEXT.xy;
    const uvec2 extent = uvec2(picture.mShownWidth, picture.mShownHeight);

    // Which eye the trace cast this pixel's ray from — the arms' where it drew the pixel on an arm,
    // so the march here runs along the same ray the trace lit them on.
    const bool arms = puffsOnArms(imageLoad(puffs, ivec2(traced)));

    // **Nothing to draw and nothing to write.** The curve makes the same test and reads a one
    // where this wrote nothing; `puffsCoverNothing` says what it saves.
    if (puffsCoverNothing(SpriteTileList(frame.mTables.mSpriteTileList), SpritePresence(frame.mTables.mSpritePresence),
            tracedExtent.x, traced, arms))
        return;

    const uvec2 first = shownPixelsFrom(traced, extent, tracedExtent);
    const uvec2 end = shownPixelsFrom(traced + 1u, extent, tracedExtent);
    for (uint y = first.y; y < end.y; ++y)
        for (uint x = first.x; x < end.x; ++x)
            compositeAt(uvec2(x, y), extent, tracedExtent, traced, arms);
}
