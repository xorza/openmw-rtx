#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The landing of every pixel's bounce that met a surface, for one of the frame's bounce rays
// (`StageConstants`; `bounce.comp` traced it and listed the pixel): the landing resolved off the hit the
// bounce stored, its light worked out whole before any ray (`landingLightOf`), its rays traced
// (`pathEndSeenOf`), and what the bounce brought back written, or added to what the rays before it brought
// (`storeBounced`). A stage apart from the bounce (`BounceRun`), so no record of the bounce's is live through
// the landing's traversals.

#include "shared/traceconstants.h"
#include "camera.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/bounced.glsl"
#include "lib/census.glsl"
#include "lib/frame.glsl"
#include "lib/hash.glsl"
#include "lib/pixels.glsl"
#include "lib/shading.glsl"
#include "lib/stage.glsl"
#include "lib/traversal.glsl"
#include "lib/underwater.glsl"
#include "lib/variants.glsl"

layout(local_size_x = TRACE_WORKGROUP_LANES) in;

layout(push_constant, scalar) uniform Push
{
    StageConstants stage;
};

void main()
{
    const uint ray = stage.mRay;

    uvec2 pixel;
    if (!landingPixelOf(pixel, ray))
        return;

    const ivec2 stored = storedAt(ivec2(pixel), frame.mEyes.mWorld.mWidth, fieldSwapOf(frame.mFrame));
    const StageRecord record = unpackStageRecord(imageLoad(stageRecord, stored));

    // **What the bounce handed on read where each half is used**, the weight once the landing is resolved and
    // the modulation past its rays, so neither the resolve nor a traversal holds what it does not read.
    const Surface landing = storedLandingOf(record, stored, ray);
    const LandingLight light
        = landingLightOf(landing, record.mBounceLobe, pixel, storedBounceAt(stored).mWeight, bounceSeedsAt(ray));

    const PathEndSeen seen = pathEndSeenOf(light.mRays);
    const vec3 fill = light.mFill * seen.mAmbient;
    const vec3 whole = light.mGlow + fill + light.mSky * seen.mSky + light.mLamp * seen.mLamp;

    storeBounced(pixel, record, Arriving(whole, fill), storedBounceAt(stored).mModulation, ray > 0u);
}
