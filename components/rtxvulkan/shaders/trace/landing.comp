#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The landing of every pixel's bounce that met a surface, the last of the trace's stages
// (`bounce.comp` traced it and listed the pixel): the landing resolved off the hit the bounce
// stored, its visit — the gather and the sky's passage under it — and what the bounce brought back
// (`storeBounced`).
//
// **A stage apart from the bounce** (`BounceRun`): the visit's loop alone keeps its records live, so
// the kernel holds fewer registers and its lanes step one walk's turns. **Over the pixels that
// landed alone** (`STAGE_DISPATCH_LANDING`), so no lane of a warp waits out the visit with no
// landing of its own.

#include "shared/traceconstants.h"
#include "camera.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/bounced.glsl"
#include "lib/census.glsl"
#include "lib/frame.glsl"
#include "lib/pixels.glsl"
#include "lib/shading.glsl"
#include "lib/stage.glsl"
#include "lib/traversal.glsl"
#include "lib/underwater.glsl"
#include "lib/variants.glsl"

layout(local_size_x = TRACE_WORKGROUP_WIDTH, local_size_y = TRACE_WORKGROUP_HEIGHT) in;

void main()
{
    uvec2 pixel;
    if (!landingPixelOf(pixel))
        return;

    const ivec2 stored = storedAt(ivec2(pixel), frame.mEyes.mWorld.mWidth, fieldSwapOf(frame.mFrame));
    const StageRecord record = unpackStageRecord(imageLoad(stageRecord, stored));
    const StoredBounce handed = storedBounceAt(stored);

    // **The landing, resolved off the hit the bounce stored** (`storedLandingOf`), and its visit in
    // the one loop that answers its rays: the gather and the sky's passage under it.
    Surface surface = storedLandingOf(record, stored);
    VisitRun visit = landingVisitOf(surface, record.mBounceLobe, pixel);
    GatherRun gather = gatherRunOf(0u, 0u, PATH_SEEN, false, false);
    SkyPassageRun skyPassage = skyPassageRunOf(
        frame.mSun, vec3(0.0), vec3(0.0), BentPath(0.0, vec3(0.0), 0.0, vec2(0.0)), vec2(0.0), false);
    gather.mStep = RUN_IDLE;
    skyPassage.mStep = RUN_IDLE;

    RayAsk ask = noRay();
    uint turns = 0u;
    [[dont_unroll]] while ((ask.mTraced || visit.mStep != RUN_IDLE) && turns < WALK_TURNS)
    {
        ++turns;
        RayAnswer answered = RayAnswer(false, unansweredScene());
        if (ask.mTraced)
        {
            answered = RayAnswer(true, queryScene(ask.mQuery));
            if (ask.mResolved)
                surface = resolveAsked(answered.mMet, ask.mQuery);
        }
        ask = noRay();

        if (skyPassage.mStep != RUN_IDLE)
            stepSkyPassage(skyPassage, answered, ask);
        else if (gather.mStep != RUN_IDLE)
            stepGather(gather, skyPassage, surface, pixel, answered, ask);
        else
            stepVisit(visit, gather, surface, answered, ask);
    }

    // A walk cut short at `WALK_TURNS` brings nothing back, and is counted.
    Arriving arriving = Arriving(vec3(0.0), vec3(0.0));
    if (visit.mStep == RUN_IDLE)
        arriving = landedArriving(visit.mEnd, handed.mWeight);
    else
        atomicAdd(counts.mWalksCut, 1u);

    storeBounced(pixel, record, arriving, handed.mModulation);
}
