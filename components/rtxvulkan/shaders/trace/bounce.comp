#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_KHR_shader_subgroup_ballot : require

// A bounce of every pixel's solid, one of the frame's bounce rays (`StageConstants`), a stage of its own after
// the trace (`visibility.comp`): the solid the trace found resolved again, its bounce drawn and traced, and
// what the bounce brought back written where its ray met nothing; where it met a surface, the pixel is
// listed for the landing's stage (`landing.comp`), which visits it.
//
// **A stage, because the one kernel spilled** (`docs/architecture.md`, "A stage a kernel, in one fixed
// order"): it carried every walk's record at once.
//
// **The trace's hit, resolved again with no traversal** (`storedSolidOf`): the surface the trace shaded, to
// the bit.

#include "shared/traceconstants.h"
#include "camera.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/bounced.glsl"
#include "lib/census.glsl"
#include "lib/frame.glsl"
#include "lib/pixels.glsl"
#include "lib/shading.glsl"
#include "lib/stage.glsl"
#include "lib/traversal.glsl"
#include "lib/variants.glsl"

layout(local_size_x = TRACE_WORKGROUP_LANES) in;

layout(push_constant, scalar) uniform Push
{
    StageConstants stage;
};

/// Lists the workgroup's pixels whose bounce ray `ray` landed (`landed`) in that ray's landings, together,
/// by one atomic a run, in the tile's order: a run of the list holds pixels of one tile as the tile laid
/// them out, so a warp of the landing's stage visits surfaces near each other — and **apart by whether
/// their gather runs** (`gathers`), so a warp whose lanes skip it does not wait out the lanes that gather.
void listLanded(bool landed, bool gathers, uvec2 pixel, uint ray)
{
    const uvec4 gathering = subgroupBallot(landed && gathers);
    const uvec4 apart = subgroupBallot(landed && !gathers);
    const uint gatheringCount = subgroupBallotBitCount(gathering);
    const uint apartCount = subgroupBallotBitCount(apart);
    uint firstGathering = 0u;
    uint firstApart = 0u;
    if (subgroupElect())
    {
        if (gatheringCount != 0u)
            firstGathering = appendLandings(gatheringCount, true, ray);
        if (apartCount != 0u)
            firstApart = appendLandings(apartCount, false, ray);
    }
    firstGathering = subgroupBroadcastFirst(firstGathering);
    firstApart = subgroupBroadcastFirst(firstApart);
    if (landed)
        listLanding(gathers ? firstGathering + subgroupBallotExclusiveBitCount(gathering)
                            : firstApart + subgroupBallotExclusiveBitCount(apart),
            gathers, pixel, ray);
}

/// Bounces `pixel` off its solid as bounce ray `ray`, and answers whether the ray met a surface, which the
/// landing's stage then visits.
///
/// @param gathers whether the landing's gather runs: always for the lobe's bounce, which the landing
///        visits as seen, and where the sky lights nothing, and otherwise as the gather draws it
///        (`indirectGatherDrawn`, keyed as `landingLightOf` keys it).
bool bouncePixel(uvec2 pixel, uint ray, out bool gathers)
{
    const uint width = frame.mEyes.mWorld.mWidth;
    const uint swap = fieldSwapOf(frame.mFrame);
    const ivec2 at = ivec2(pixel);
    const ivec2 stored = storedAt(at, width, swap);
    StageRecord record = unpackStageRecord(imageLoad(stageRecord, stored));

    // **The solid the trace found, resolved off the hit it stored** (`storedSolidOf`).
    const Surface surface = storedSolidOf(record, stored);

    BounceRun bounce = bounceRunOf();
    if (surface.mHit)
        startBounce(bounce, surface, coneAt(eyeOf(record.mArms)), pixel, ray);

    // **A split pixel's lift blended with its split neighbours'** where no layer stands, which the layers'
    // stage blends where one does (`shownSurfaceLift`): here, where every pixel's halves are written, and
    // not in the layers' stage, whose registers its tiles paid for the blend alone.
    if (HAS_SEA && ray == 0u && !record.mLayered
        && splitIn(imageLoad(motion, channelAt(CHANNEL_MOTION, at, width, swap))))
        RTX_STORE_COUNTED(lift, channelAt(CHANNEL_LIFT, at, width, swap),
            vec4(shownSurfaceLift(at, width, swap, true), 1.0))

    record.mBounceLobe = bounce.mDrawn.mSpecular;
    gathers = record.mBounceLobe || !skyLights() || indirectGatherDrawn(pixelKey(pixel), bounceSeedsAt(ray).mIndirect);

    const RayAnswer answered = answerAsked(bounce.mBounceRay);

    if (bounce.mBounceTraced)
    {
        // **What the ray met, stored for the landing** (`storeLandingHit`), which nothing reads after this
        // stage but the landing's: the landing then resolves it as this walk would have
        // (`storedLandingOf`).
        const SceneAnswer met = answered.mMet;
        if (met.mCommitted != 0u)
        {
            storeLandingHit(stored, met, bounce.mBounceRay.mQuery, ray);
            storeBounce(stored, bounce.mWeight, bounce.mModulationWord);
            RTX_STORE_WORDS(stageRecord, stored, packStageRecord(record))
            return true;
        }

        bounce.mEscaped = bounceMissed(bounce);
    }

    // **What arrived, where this stage knows it**: the escape, or nothing.
    storeBounced(pixel, record, escapedArriving(bounce.mEscaped), unpackRgb9e5(bounce.mModulationWord), ray > 0u);
    return false;
}

void main()
{
    const uint ray = stage.mRay;

    uvec2 pixel;
    const bool inside = stagePixelOf(pixel);

    bool gathers = false;
    const bool landed = inside && bouncePixel(pixel, ray, gathers);

    listLanded(landed, gathers, pixel, ray);
}
