#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_ray_tracing : require

// What this trace makes of each emitter, once for every sprite of it: `GpuEmitterFrame`. Three values that are
// the emitter's and the camera's alone, which the walks worked out again at every pixel an emitter covers:
// the fog's coverage band, what one layer of the texture lets through, and the texture's extent. A launch, of
// one lane an emitter, since no count is pushed that a dispatch's last workgroup would stop at.

#include "look.h"
#include "scene.h"

#include "lib/bindings.glsl"
#include "lib/census.glsl"
#include "lib/fogfield.glsl"
#include "lib/frame.glsl"
#include "lib/spritelist.glsl"

void main()
{
    const uint index = gl_LaunchIDEXT.x;
    const GpuEmitter emitter = emitterAt(index);

    // **The band over the path to the emitter, at its mean-value point**: the ray through the emitter's
    // centre from the eye, or along the view where every ray runs one way.
    const vec3 toCentre = emitter.mCentre - frame.mOrigin;
    const bool parallel = frame.mEyes.mWorld.mOrthographic != 0u;
    const vec3 forward = frame.mEyes.mWorld.mBasis.mForward;
    const float along = parallel ? dot(toCentre, forward) : length(toCentre);
    const vec3 from = parallel ? emitter.mCentre - forward * along : frame.mOrigin;
    const vec3 towards = parallel || !(along > 0.0) ? forward : toCentre / along;

    // What one layer of this texture hides on average, as the logarithm the walk's two powers share: an
    // outermost sprite raises it to nought and gets one, exactly. It is the mean of the coarsest level, which a
    // box-filtered chain keeps as its texture's own at every level: eight by eight where Morrowind's chains end,
    // one texel where the device made the chain.
    const int coarsest = textureQueryLevels(textures[nonuniformEXT(emitter.mTexture)]) - 1;
    const ivec2 grid = min(textureSize(textures[nonuniformEXT(emitter.mTexture)], coarsest), ivec2(8));
    float covered = 0.0;
    for (int y = 0; y < grid.y; ++y)
        for (int x = 0; x < grid.x; ++x)
            covered += textureLod(TEXTURE(sceneTexels(), emitter.mTexture), (vec2(x, y) + 0.5) / vec2(grid),
                float(coarsest))
                           .a;
    const float layerMean = covered / float(grid.x * grid.y);

    // Both axes, because a streak carries them at different densities — `quadCrossing` says why.
    const GpuEmitterFrame made = GpuEmitterFrame(slantCoverage(from, towards, along),
        log2(1.0 - min(layerMean, SPRITE_ALPHA_LIMIT)), vec2(textureSize(textures[nonuniformEXT(emitter.mTexture)], 0)));
    countNotFinite(vec4(made.mBand, made.mLayerThrough, made.mTexels));
    EmitterFrames(frame.mTables.mEmitterFrames).at[index] = made;
}
