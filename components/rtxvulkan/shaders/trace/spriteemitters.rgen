#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require

// What this trace makes of each emitter, once for every sprite of it: `GpuEmitterFrame`.
//
// **Three values that are the emitter's and the camera's alone**, which the walks worked out again
// at every pixel an emitter covers, at the traced extent and again at the shown one: the fog's
// coverage band, a fetch of the fog's tile per scale; what one layer of the texture lets through,
// a level query and a fetch; and the texture's extent, a header read. One invocation an emitter,
// ahead of the trace.
//
// **A launch and not a dispatch**, for the reason `RtxSourceTreeTest` gives: the band reaches the
// fog, and the fog reaches the traversal. Nothing here traces.

#include "look.h"
#include "scene.h"

#include "lib/bindings.glsl"
#include "lib/fog.glsl"
#include "lib/frame.glsl"
#include "lib/spritelist.glsl"

void main()
{
    const uint index = gl_LaunchIDEXT.x;
    const GpuEmitter emitter = emitterAt(index);

    // **The band over the path to the emitter, at its mean-value point**: the ray through the
    // emitter's centre from the eye, or along the view where every ray runs one way. Every sprite
    // behind the sphere is within `mReach` of the same air. The layer under the band is
    // `fogColumn`'s and is taken exactly, per sprite, by the walk.
    const vec3 toCentre = emitter.mCentre - frame.mOrigin;
    const bool parallel = frame.mEyes.mWorld.mOrthographic != 0u;
    const vec3 forward = frame.mEyes.mWorld.mBasis.mForward;
    const float along = parallel ? dot(toCentre, forward) : length(toCentre);
    const vec3 from = parallel ? emitter.mCentre - forward * along : frame.mOrigin;
    const vec3 towards = parallel || !(along > 0.0) ? forward : toCentre / along;

    // **What one layer of this texture hides on average**, as the logarithm the walk's two powers
    // share: an outermost sprite raises it to nought and gets one, exactly.
    //
    // **The mean of the coarsest level, every texel of it**, which a box-filtered chain keeps as its
    // texture's own at every level: eight by eight where Morrowind's chains end, and one texel where
    // the device made the chain. A chain stopping coarser is read on an eight-by-eight grid. Read at
    // the middle of the coarsest level instead, it was the peak of a radial puff and not its mean,
    // and vanilla smoke shadowed itself several times too darkly. **Here and not at the texture's
    // arrival**, because only the device knows which image stands in a slot and at which level it
    // was stood: at most sixty-four reads an emitter.
    const int coarsest = textureQueryLevels(textures[nonuniformEXT(emitter.mTexture)]) - 1;
    const ivec2 grid = min(textureSize(textures[nonuniformEXT(emitter.mTexture)], coarsest), ivec2(8));
    float covered = 0.0;
    for (int y = 0; y < grid.y; ++y)
        for (int x = 0; x < grid.x; ++x)
            covered += textureLod(textures[nonuniformEXT(emitter.mTexture)], (vec2(x, y) + 0.5) / vec2(grid),
                float(coarsest))
                           .a;
    const float layerMean = covered / float(grid.x * grid.y);

    // Both axes, because a streak carries them at different densities — `quadCrossing` says why.
    EmitterFrames(frame.mTables.mEmitterFrames).at[index] = GpuEmitterFrame(slantCoverage(from, towards, along),
        log2(1.0 - min(layerMean, SPRITE_ALPHA_LIMIT)), vec2(textureSize(textures[nonuniformEXT(emitter.mTexture)], 0)));
}
