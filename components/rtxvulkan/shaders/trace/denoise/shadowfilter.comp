// One level of the shadow denoiser's spatial half: a 3×3 edge-stopping filter with its taps `1 <<
// SHADOW_LEVEL` apart, over the temporal pass's blend and its variance, run three times.
//
// **What the port keeps**: the 16×16 square each workgroup reads into shared memory once, the 3×3
// Gaussian over the variance before its square root is the brightness test's scale, the separable
// kernel of 1 and 2/3, the brightness test `exp(-|a - b| / sigma)`, the variance carried by the
// squares of the weights, the cleared tiles copied rather than filtered — and not at the middle
// level, which is how the temporal pass's exact value reaches the last one — and the first level's
// answer kept as the next frame's history.
//
// **What it changes, and why:**
//
// - **Full floats in the arithmetic and in shared memory, and the stores rounded by the shader.**
//   The SDK's filter works only with half-float arithmetic, `FFX_HALF`: without it the functions
//   are stubs, and shared memory holds halves. Here both are full floats. The first level's answer
//   is the next frame's history, so a half in its shared memory was a rounding inside the history's
//   loop, and one `packHalf2x16` makes as the device pleases: this card rounds it to nearest
//   (`aPackedHalfRoundsToNearestOnThisCard`), and one that truncated would have darkened every
//   penumbra a little at each frame. What a level stores is rounded once, as `storedWord` says.
// - **The tree's two surface tests** in place of the SDK's depth and normal ones: `coplanarWeight`,
//   over positions rebuilt through the eye that cast each ray, and `facingWeights`. The wavelet stops
//   at the same edges, so a shadow does not bleed across an edge the bounce under it stops at.
// - **No contrast step.** The SDK's last level raises its mean to `max(1.2 - variance, 1)`, which
//   darkens a penumbra on purpose: 3.4% of a penumbra's light, against a 256-frame reference, in
//   `theShadowDenoiserTakesTheNoiseOffAPenumbraAndLeavesItsLightWhereItWas`. A picture darker than
//   the light it stands for is a picture read wrong, and the noise measure counts it as error.
// - **A tap that receives nothing weighs nought**, where the SDK drops only the sky: a surface the
//   source does not light carries a value that is not a shadow, and it must not darken the
//   terminator beside it.
// - **A level runs only where its step fits the penumbra**, the tile's reach the temporal pass
//   wrote: the widest penumbra in pixels in the tile and around it. A narrower one has no noise at
//   that scale to take off, and a hard shadow the levels blurred lost its depth (`shadowtiles.comp`
//   says how much). NVIDIA's SIGMA sizes its blur by the penumbra the same way. A level that does
//   not run copies its input, as a cleared tile does.

#include "gbuffer.h"
#include "shared/sets.h"
#include "shared/shadow.h"

#include "lib/census.glsl"
#include "lib/hash.glsl"
#include "lib/pixels.glsl"
#include "lib/shadowword.glsl"
#include "lib/surfacematch.glsl"

/// Which of the `SHADOW_FILTER_LEVELS` this module is: its taps are `1 << SHADOW_LEVEL` apart.
layout(constant_id = SHADOW_SPEC_LEVEL) const uint SHADOW_LEVEL = 0u;

/// Which fields this module filters, a bit a field at `SHADOW_FIELD_*`.
layout(constant_id = SHADOW_SPEC_FIELDS) const uint SHADOW_FIELDS = (1u << SHADOW_FIELD_COUNT) - 1u;

layout(local_size_x = SHADOW_WORKGROUP, local_size_y = SHADOW_WORKGROUP) in;

layout(set = SET_PASS, binding = SHADOW_FILTER_BIND_SURFACE, GBUFFER_SURFACE) uniform readonly image2D surfaceChannel;

/// Each field's tiles, the temporal pass's.
layout(set = SET_PASS, binding = SHADOW_FILTER_BIND_TILES + SHADOW_FIELD_SKY, SHADOW_TILES) uniform readonly image2D skyTiles;
layout(set = SET_PASS, binding = SHADOW_FILTER_BIND_TILES + SHADOW_FIELD_LAMPS, SHADOW_TILES) uniform readonly image2D lampTiles;

/// Each field's level before, its mean and variance, or the temporal pass's: `SHADOW_NO_RECEIVER`
/// for the variance of a pixel its source does not light. And what this level writes of each.
layout(set = SET_PASS, binding = SHADOW_FILTER_BIND_SOURCE + SHADOW_FIELD_SKY, SHADOW_REPROJECTED)
    uniform readonly uimage2D skySource;
layout(set = SET_PASS, binding = SHADOW_FILTER_BIND_SOURCE + SHADOW_FIELD_LAMPS, SHADOW_REPROJECTED)
    uniform readonly uimage2D lampSource;
layout(set = SET_PASS, binding = SHADOW_FILTER_BIND_FILTERED + SHADOW_FIELD_SKY) uniform writeonly uimage2D skyFiltered;
layout(set = SET_PASS, binding = SHADOW_FILTER_BIND_FILTERED + SHADOW_FIELD_LAMPS) uniform writeonly uimage2D lampFiltered;

layout(push_constant, scalar) uniform Push
{
    ShadowFilterConstants level;
};

/// How far past the workgroup the square reaches on every side: this level's step, which is how far
/// its taps reach and never less than the variance's one pixel. And the side of the square a
/// workgroup reads. **Sized by the level, which a specialization constant is**: sized for the widest
/// level, the first read a square of 16 a side to use one of 10, and the second one of 12.
const int APRON = 1 << SHADOW_LEVEL;
const uint SPAN = SHADOW_WORKGROUP + 2u * uint(APRON);

/// How many fields this module filters, and where a field's input stands among them: shared memory
/// for the ones it filters alone, since what a workgroup holds is what lets another run beside it.
const uint FIELD_SLOTS = SHADOW_FIELDS == (1u << SHADOW_FIELD_COUNT) - 1u ? SHADOW_FIELD_COUNT : 1u;

uint slotOf(uint field)
{
    return FIELD_SLOTS == SHADOW_FIELD_COUNT ? field : 0u;
}

/// Each field's input, the surface's normal code, and where the surface stands. **The surface once
/// for both fields**, each tap weighed by whether its own field's source lights it: the two fields
/// read the same square of the same surface, and a dispatch a field rebuilt every position twice.
shared vec2 gInput[FIELD_SLOTS][SPAN][SPAN];
shared float gNormal[SPAN][SPAN];
shared vec3 gPosition[SPAN][SPAN];

/// Whether this module filters `field`. Every caller names a field as a constant, so this and every
/// branch on a field below fold where the module is specialised.
bool filters(uint field)
{
    return (SHADOW_FIELDS & (1u << field)) != 0u;
}

vec2 fieldTile(uint field)
{
    if (field == SHADOW_FIELD_SKY)
        return imageLoad(skyTiles, ivec2(gl_WorkGroupID.xy)).rg;
    return imageLoad(lampTiles, ivec2(gl_WorkGroupID.xy)).rg;
}

uint sourceWord(uint field, ivec2 pixel)
{
    if (field == SHADOW_FIELD_SKY)
        return imageLoad(skySource, pixel).r;
    return imageLoad(lampSource, pixel).r;
}

void storeFiltered(uint field, ivec2 pixel, uint word)
{
    if (field == SHADOW_FIELD_SKY)
        RTX_STORE_WORDS(skyFiltered, pixel, uvec4(word, 0u, 0u, 0u))
    else
        RTX_STORE_WORDS(lampFiltered, pixel, uvec4(word, 0u, 0u, 0u))
}

/// Fills the workgroup's square, four texels a lane, clamped to the frame as the SDK clamps them:
/// the surface, and the input of each field `filtering` names.
///
/// **Each level rebuilds its positions from the surface it reads anyway**, and no pass stores them
/// once a frame: skipping the rebuild outright took 0.025 to 0.033 ms off the shadow zone of the
/// default suite, three alternated rounds, and an image of positions in full floats at 1280×720 is
/// 14.7 MB a frame, whose write alone takes 0.026 ms at the card's 576 GB/s before a level reads it.
void readSquare(ivec2 corner, bvec2 filtering)
{
    const ivec2 last = ivec2(level.mEyes.mWorld.mWidth, level.mEyes.mWorld.mHeight) - 1;
    for (uint i = gl_LocalInvocationIndex; i < SPAN * SPAN; i += SHADOW_WORKGROUP * SHADOW_WORKGROUP)
    {
        const uvec2 square = uvec2(i % SPAN, i / SPAN);
        const ivec2 pixel = clamp(corner + ivec2(square), ivec2(0), last);

        const vec2 seen = imageLoad(surfaceChannel, pixel).rg;
        const bool stands = seen.x != SURFACE_NO_NORMAL;
        gNormal[square.y][square.x] = seen.x;
        gPosition[square.y][square.x]
            = stands ? positionAlong(eyeOfPixel(seen.y, level.mEyes), pixel, surfaceDistance(seen.y)) : vec3(0.0);

        if (filters(SHADOW_FIELD_SKY) && filtering[SHADOW_FIELD_SKY])
            gInput[slotOf(SHADOW_FIELD_SKY)][square.y][square.x] = unpackShadowWord(sourceWord(SHADOW_FIELD_SKY, pixel));
        if (filters(SHADOW_FIELD_LAMPS) && filtering[SHADOW_FIELD_LAMPS])
            gInput[slotOf(SHADOW_FIELD_LAMPS)][square.y][square.x]
                = unpackShadowWord(sourceWord(SHADOW_FIELD_LAMPS, pixel));
    }
}

vec2 inputAt(uint field, ivec2 square)
{
    return gInput[slotOf(field)][square.y][square.x];
}

/// Whether `field`'s source lights the pixel at `square`, which its input says by its variance.
bool receives(uint field, ivec2 square)
{
    return inputAt(field, square).y != SHADOW_NO_RECEIVER;
}

/// The SDK's 3×3 Gaussian over the variance, which is the tent (`tentWeight`). A pixel that
/// receives nothing adds a variance of nought, as the SDK's sky does.
float filteredVariance(uint field, ivec2 square)
{
    float variance = 0.0;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x)
        {
            variance += tentWeight(ivec2(x, y)) * max(inputAt(field, square + ivec2(x, y)).y, 0.0);
        }
    return variance;
}

/// What this level stores of `value`, a mean and its variance: the first level's mean rounded at
/// random by `word`, since the next frame's temporal pass blends it; the second's to the nearest,
/// since only the third reads it; and the third's mean alone, as its float's bits, which is what the
/// composite reads.
uint storedWord(vec2 value, uint word)
{
    if (SHADOW_LEVEL == SHADOW_FILTER_LEVELS - 1u)
    {
        countNotFinite(value.x);
        return floatBitsToUint(value.x);
    }
    return packShadowWord(value, SHADOW_LEVEL == 0u ? word : UNORM16_NEAREST);
}

/// What this level stores of the word `source` it copies: the word itself where the target is one
/// as well, and the third level's mean as its float's bits. **Not unpacked and rounded again**: a
/// step read back stands within an ulp of its value, and a hair under it a rounding at random takes
/// a step down as often as the hair is a share of a step.
uint copiedWord(uint source)
{
    return SHADOW_LEVEL == SHADOW_FILTER_LEVELS - 1u ? floatBitsToUint(unpackShadowWord(source).x) : source;
}

/// The SDK's separable kernel: 1 at the centre, 2/3 one step out.
float kernelAt(int offset)
{
    return offset == 0 ? 1.0 : 2.0 / 3.0;
}

/// Whether this workgroup filters `field`'s tile, storing the copy where it does not. **A cleared tile
/// is copied**: its value is the temporal pass's exact nought or one. Not at the middle level, whose
/// target is the temporal pass's own image, so the value is already there for the last level to
/// read. **And a tile whose penumbra this level's step does not fit is copied at every level**, the
/// middle one too: the first may have run, and its target is not the temporal pass's value the
/// middle one's is.
bool filtersTile(uint field, ivec2 at, bool inFrame)
{
    const vec2 tile = fieldTile(field);
    const bool cleared = tile.r > 0.5;
    if (!cleared && !(float(1u << SHADOW_LEVEL) > tile.g))
        return true;

    if ((!cleared || SHADOW_LEVEL != 1u) && inFrame)
        storeFiltered(field, at, copiedWord(sourceWord(field, at)));
    return false;
}

/// One field's filter at the pixel `at`, the workgroup's square read: the level's mean and variance,
/// or nought and `SHADOW_NO_RECEIVER` where the field's source lights nothing there.
vec2 filtered(uint field, ivec2 centre, vec3 normal, vec3 position, float footprint)
{
    if (!receives(field, centre))
        return vec2(0.0, SHADOW_NO_RECEIVER);

    const vec2 here = inputAt(field, centre);
    const float deviation = sqrt(max(filteredVariance(field, centre) + 1e-9, 0.0));

    const int step = 1 << SHADOW_LEVEL;
    float weightSum = 1.0;
    vec2 sum = here;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x)
        {
            if (x == 0 && y == 0)
                continue;

            const ivec2 tap = centre + ivec2(x, y) * step;
            const vec2 there = inputAt(field, tap);
            const float tested = kernelAt(x) * kernelAt(y) * exp(-abs(here.x - there.x) / deviation)
                * coplanarWeight(normal, position, gPosition[tap.y][tap.x], footprint)
                * facingWeights(normal, unpackSurfaceNormal(gNormal[tap.y][tap.x])).mFilter;
            // Selected and not skipped, as the temporal pass selects what it stores
            // (`shadowtiles.comp` names the measurement).
            const float weight = there.y != SHADOW_NO_RECEIVER ? tested : 0.0;

            sum += vec2(weight, weight * weight) * there;
            weightSum += weight;
        }

    return vec2(sum.x / weightSum, sum.y / (weightSum * weightSum));
}

void main()
{
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    const bool inFrame = !outsideOf(uvec2(at), uvec2(level.mEyes.mWorld.mWidth, level.mEyes.mWorld.mHeight));

    // Which fields' tiles this workgroup filters, a uniform answer a field: the rest are copied here.
    const bvec2 filtering = bvec2(filters(SHADOW_FIELD_SKY) && filtersTile(SHADOW_FIELD_SKY, at, inFrame),
        filters(SHADOW_FIELD_LAMPS) && filtersTile(SHADOW_FIELD_LAMPS, at, inFrame));
    if (!any(filtering))
        return;

    readSquare(ivec2(gl_WorkGroupID.xy * SHADOW_WORKGROUP) - APRON, filtering);
    barrier();

    if (!inFrame)
        return;

    const ivec2 centre = ivec2(gl_LocalInvocationID.xy) + APRON;
    const vec3 normal = unpackSurfaceNormal(gNormal[centre.y][centre.x]);
    const vec3 position = gPosition[centre.y][centre.x];
    const float packed = imageLoad(surfaceChannel, at).g;
    const float footprint = footprintAlong(eyeOfPixel(packed, level.mEyes), surfaceDistance(packed));

    if (filtering[SHADOW_FIELD_SKY])
    {
        uint rounding = seededKey(pixelKey(uvec2(at)) + SEED_SKY_SHADOW_HISTORY_ROUNDING, level.mFrame);
        storeFiltered(SHADOW_FIELD_SKY, at,
            storedWord(filtered(SHADOW_FIELD_SKY, centre, normal, position, footprint), randomWord(rounding)));
    }
    if (filtering[SHADOW_FIELD_LAMPS])
    {
        uint rounding = seededKey(pixelKey(uvec2(at)) + SEED_LAMP_SHADOW_HISTORY_ROUNDING, level.mFrame);
        storeFiltered(SHADOW_FIELD_LAMPS, at,
            storedWord(filtered(SHADOW_FIELD_LAMPS, centre, normal, position, footprint), randomWord(rounding)));
    }
}
