#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The accumulator's anti-lag: the slow mean of the bounce held to what its fast mean says around
// the pixel, after the accumulator and before the wavelet. ReLAX's history clamp (NVIDIA NRD,
// `RELAX_HistoryClamping`), taken as published and written again, after ReBLUR's anti-firefly.
//
// **Why a slow mean drags.** The accumulator drops a history only where the surface changed. Where
// the light changes on a surface that did not move — an actor's darkness dragged over a floor — its
// 32 frames keep the old light, and the wavelet's feedback blurs it as it fades: a trail ten pixels
// long and more behind a moving bar (`RtxBounceTrailTest`).
//
// **Why the fast mean's neighbourhood and not the frame's sample.** A sample is one bounce, and one
// that found a lit patch stands many deviations over the mean, so a box of samples would hold the
// slow mean to noise. The same samples over `ACCUMULATE_FAST_FRAMES`, taken over a 5×5 square, are
// quiet enough to bound it and short enough to follow the light: where the slow mean stands outside
// the fast one's mean ± two deviations over the square, on any axis of YCoCg, it is moved to that
// edge (`heldToFast`, which the glossy and pane filters hold their means by too).
//
// **Then ReLAX's push**, on both means: where the clamp moved the slow mean, both go on toward the
// square's mean of samples in proportion (`antilagAcceleration`). The fast mean follows the light
// only as fast as its frames do, and this takes it further. ReLAX's reset is not taken, and
// `ACCUMULATE_ACCELERATION` says why.
//
// **Before both, ReBLUR's anti-firefly** (NVIDIA NRD, `REBLUR_HistoryFix`): a slow mean of
// `ACCUMULATE_RING_FRAMES` or fewer is held under the mean of the fast means in the 9×9 ring around
// it, less the 3×3 at its centre, plus two of their deviations (`ringHeldLuminance`). A mean of a few
// frames has no history to tell a firefly by, and its neighbours do; a longer one keeps what it took
// in, for the reason `ACCUMULATE_RING_FRAMES` gives. **Here and not in the history fix**, which
// spreads the pixel it rebuilds over a leaf: held first, there is no firefly left to spread.
//
// **And the variance the wavelet's brightness test reads**: a settled mean's own moments', and a
// short history's, which its own cannot give yet (`ACCUMULATE_SETTLED`), that of the moments over
// the same 5×5 square, each tap by how nearly it is the pixel's surface, `shortHistoryVariance`,
// ReLAX's spatial estimate. Here because the square is here, and so one pass states which a pixel
// takes.
//
// **The fill moves by the bounce's share.** `CHANNEL_FILL` is a share of the bounce, so the fill
// moves toward its fast mean by the share the bounce's luma moved, as ReLAX moves a history's other
// data by its clamping factor, and is pushed by the bounce's push.
//
// **In place** for the slow means, which each pixel alone reads and writes. The fast means are read
// from the blend the accumulator left and written to the history, since a neighbour reads a pixel's
// blend while the pixel writes its mean.
//
// **The luminance moments are not moved with the mean**, as ReLAX moves its second moment. Moved,
// they kept the variance the next frame reads where it was, and left alone they leave it all but
// there: every place of the bounce suite was as noisy to the hundredth, still, strafed and walked,
// and the sky's trail as long, where reading and writing them cost the clamp 0.08 ms of 0.25.

#include "shared/accumulate.h"
#include "shared/atrous.h"
#include "colour.h"
#include "gbuffer.h"
#include "shared/sets.h"

#include "lib/historyclamp.glsl"
#include "lib/pixels.glsl"
#include "lib/sharedexponent.glsl"
#include "lib/surfacematch.glsl"

layout(local_size_x = ACCUMULATE_WORKGROUP, local_size_y = ACCUMULATE_WORKGROUP) in;

/// Whether the slow mean is held under its ring's ceiling, and the ring's square loaded at all
/// (`ACCUMULATE_CLAMP_SPEC_RING`).
layout(constant_id = ACCUMULATE_CLAMP_SPEC_RING) const bool ACCUMULATE_RING = false;

/// Which pixels hold a surface: one that does not has no mean to bound or to bound by.
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_SURFACE, GBUFFER_SURFACE) uniform readonly image2D surfaceChannel;

/// The fast means as the accumulator blended them, and the frame's samples of the bounce and the
/// fill, whose mean over the square the push goes toward. No format on the samples, for the reason
/// `accumulate.comp` gives: the run decides their width.
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_FAST, ACCUMULATE_FAST) uniform readonly uimage2D fast;
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_SAMPLED) uniform readonly image2D sampled;
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_SAMPLED_FILL) uniform readonly image2D sampledFill;

/// The slow means as the accumulator blended them, and in the bounce's `a` the variance this writes.
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_BLENDED, ATROUS_CHANNEL) uniform image2D blended;
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_FILL_BLENDED, ATROUS_CHANNEL) uniform image2D fillBlended;

/// The moments of each pixel's slow mean's luminance in `rg`, which its variance is measured from,
/// and how many frames it holds in `a`: whether the ring holds it down, and whether its variance is
/// its own or the square's.
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_MOMENTS, ACCUMULATE_MOMENTS) uniform readonly image2D moments;

/// This frame's fast means, which the next frame's accumulator reads.
layout(set = SET_PASS, binding = ACCUMULATE_CLAMP_BIND_FAST_OUT, ACCUMULATE_FAST) uniform writeonly uimage2D fastOut;

layout(push_constant, scalar) uniform Push
{
    AccumulateClampConstants frame;
};

const int REACH = int(ACCUMULATE_CLAMP_REACH);
const uint SPAN = ACCUMULATE_WORKGROUP + 2u * ACCUMULATE_CLAMP_REACH;

const int RING = int(ACCUMULATE_RING_REACH);
const int HOLE = int(ACCUMULATE_RING_HOLE);

/// How far the workgroup's tile of fast means reaches past it: the ring's, where the ring runs, and
/// the clamp's square's where it does not.
const int OUTER = ACCUMULATE_RING ? RING : REACH;
const uint RING_SPAN = ACCUMULATE_WORKGROUP + 2u * uint(OUTER);

/// How far inside the tile the clamp's square starts.
const int INSET = OUTER - REACH;

/// The fast mean at every pixel of the workgroup's ring, in YCoCg in `xyz` and its luminance in `w`,
/// which is below nought where the pixel holds no surface; and over the clamp's square the samples of
/// the bounce and the fill, and the moments of the slow mean's luminance.
shared vec4 gFast[RING_SPAN][RING_SPAN];
shared vec3 gSampled[SPAN][SPAN];
shared vec3 gSampledFill[SPAN][SPAN];
shared vec2 gMoments[SPAN][SPAN];

/// Over the clamp's square, the surface each pixel holds, as the short history's variance weighs
/// its taps by: the shading normal, and the point the ray met, from the eye that cast it.
shared vec3 gNormals[SPAN][SPAN];
shared vec3 gPositions[SPAN][SPAN];

void main()
{
    const uint threads = ACCUMULATE_WORKGROUP * ACCUMULATE_WORKGROUP;
    const ivec2 origin = ivec2(gl_WorkGroupID.xy * ACCUMULATE_WORKGROUP);
    for (uint i = gl_LocalInvocationIndex; i < RING_SPAN * RING_SPAN; i += threads)
    {
        const uvec2 square = uvec2(i % RING_SPAN, i / RING_SPAN);
        const ivec2 pixel = origin - OUTER + ivec2(square);
        const bool held = !outsideOf(uvec2(pixel), uvec2(frame.mEyes.mWorld.mWidth, frame.mEyes.mWorld.mHeight))
            && imageLoad(surfaceChannel, pixel).r != SURFACE_NO_NORMAL;
        const vec3 there = unpackRgb9e5(imageLoad(fast, pixel).x);
        gFast[square.y][square.x] = held ? vec4(ycocgOf(there), dot(there, LUMINANCE_WEIGHTS)) : vec4(-1.0);
    }
    barrier();
    for (uint i = gl_LocalInvocationIndex; i < SPAN * SPAN; i += threads)
    {
        const uvec2 square = uvec2(i % SPAN, i / SPAN);
        const ivec2 pixel = origin - REACH + ivec2(square);
        const bool held = gFast[square.y + INSET][square.x + INSET].w >= 0.0;
        gSampled[square.y][square.x] = held ? imageLoad(sampled, pixel).rgb : vec3(0.0);
        gSampledFill[square.y][square.x] = held ? imageLoad(sampledFill, pixel).rgb : vec3(0.0);
        gMoments[square.y][square.x] = held ? imageLoad(moments, pixel).rg : vec2(0.0);
        // No surface is `SURFACE_NO_NORMAL`, whose normal of nought weighs nought in the variance.
        const vec2 seen = held ? imageLoad(surfaceChannel, pixel).rg : vec2(SURFACE_NO_NORMAL, 0.0);
        gNormals[square.y][square.x] = unpackSurfaceNormal(seen.x);
        gPositions[square.y][square.x]
            = positionAlong(eyeOfPixel(seen.y, frame.mEyes), pixel, surfaceDistance(seen.y));
    }
    barrier();

    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (outsideOf(uvec2(at), uvec2(frame.mEyes.mWorld.mWidth, frame.mEyes.mWorld.mHeight)))
        return;

    const uvec2 fastPacked = imageLoad(fast, at).xy;
    const ivec2 centre = ivec2(gl_LocalInvocationID.xy) + OUTER;
    if (gFast[centre.y][centre.x].w < 0.0)
    {
        imageStore(fastOut, at, uvec4(fastPacked, 0u, 0u));
        return;
    }
    const vec3 fastHere = unpackRgb9e5(fastPacked.x);
    const vec3 fastFillHere = unpackRgb9e5(fastPacked.y);

    // The square's statistics, in a fixed order, over the pixels that hold a surface; the centre is
    // one of them: the fast means' box and the samples' mean.
    float count = 0.0;
    vec3 fastSum = vec3(0.0);
    vec3 fastSquares = vec3(0.0);
    vec3 sampledSum = vec3(0.0);
    vec3 sampledFillSum = vec3(0.0);
    for (int y = -REACH; y <= REACH; ++y)
        for (int x = -REACH; x <= REACH; ++x)
        {
            const ivec2 tap = centre + ivec2(x, y);
            const ivec2 sampledTap = tap - INSET;
            const vec4 there = gFast[tap.y][tap.x];
            const float weight = there.w >= 0.0 ? 1.0 : 0.0;
            count += weight;
            fastSum += weight * there.xyz;
            fastSquares += weight * there.xyz * there.xyz;
            sampledSum += weight * gSampled[sampledTap.y][sampledTap.x];
            sampledFillSum += weight * gSampledFill[sampledTap.y][sampledTap.x];
        }
    const FastBox box = fastBoxOf(fastSum, fastSquares, count);
    const vec3 sampledMean = sampledSum / count;
    const vec3 sampledFillMean = sampledFillSum / count;

    // The ring's, likewise, over the square less its hole: ReBLUR's anti-firefly, which holds the
    // slow mean under it before the anti-lag reads it, in ReBLUR's order. **Every surface the ring
    // holds and not this one's alone**: a firefly is a bright pixel on a leaf a few pixels across,
    // and a ring of that leaf is a ring of nothing. **Under the constant alone**, which the driver
    // folds: without the ring the tile holds the clamp's square and no more.
    float ringCount = 0.0;
    float ringSum = 0.0;
    float ringSquares = 0.0;
    if (ACCUMULATE_RING)
        for (int y = -RING; y <= RING; ++y)
            for (int x = -RING; x <= RING; ++x)
            {
                const float there = gFast[centre.y + y][centre.x + x].w;
                const float weight = there >= 0.0 && (abs(x) > HOLE || abs(y) > HOLE) ? 1.0 : 0.0;
                ringCount += weight;
                ringSum += weight * there;
                ringSquares += weight * there * there;
            }

    const vec3 blend = imageLoad(blended, at).rgb;
    const float blendLit = dot(blend, LUMINANCE_WEIGHTS);
    const float frames = imageLoad(moments, at).a;
    const float young = frames <= ACCUMULATE_RING_FRAMES ? 1.0 : 0.0;
    const float slowHere = mix(
        blendLit, ringHeldLuminance(blendLit, ringSum, ringSquares, ringCount), float(ACCUMULATE_RING) * young);
    const float ringScale = blendLit > 0.0 ? slowHere / blendLit : 1.0;
    const vec3 slow = blend * ringScale;
    const vec3 slowFill = imageLoad(fillBlended, at).rgb * ringScale;
    const float antilag = float(frame.mAntilag);

    const HeldHistory clamped = heldToFast(slow, fastHere, box);
    const float share = antilag * clamped.mShare;
    const float pushed = antilag
        * antilagAcceleration(dot(abs(fastHere - slow), LUMINANCE_WEIGHTS), share,
            dot(abs(sampledMean - fastHere), LUMINANCE_WEIGHTS));

    const vec3 toward = sampledMean - fastHere;
    const vec3 towardFill = sampledFillMean - fastFillHere;
    // **Held at nought**: the push is the fast mean's way to the samples, and a slow mean the clamp
    // moved only a little toward a bright fast one is pushed back by all of it, past nought where
    // the samples stand far under the fast mean.
    const vec3 held = max(mix(slow, clamped.mHeld, antilag) + pushed * toward, vec3(0.0));
    const vec3 heldFill = max(mix(slowFill, fastFillHere, share) + pushed * towardFill, vec3(0.0));
    const vec3 followed = fastHere + pushed * toward;
    const vec3 followedFill = fastFillHere + pushed * towardFill;

    // **A short history's variance is the square's moments, by how nearly each tap is this surface**
    // (`facingWeight`, `coplanarWeight`), as ReLAX weighs its spatial estimate's taps and SVGF its
    // bilateral one: a short history stands where something was uncovered, and a flat square mixed
    // the occluder's moments into the uncovered surface's variance, which loosened the wavelet's
    // brightness test where it matters. A branch, which only those pixels take: computed for every
    // pixel, the weights cost the clamp 0.02 to 0.04 ms more on the bench, and under the branch 0.01
    // to 0.02; what is left is the square's normals and points, which the workgroup loads either way.
    const ivec2 own = centre - INSET;
    float variance = momentVariance(gMoments[own.y][own.x].x, gMoments[own.y][own.x].y);
    if (frames <= ACCUMULATE_SETTLED)
    {
        const vec3 normal = gNormals[own.y][own.x];
        const vec3 position = gPositions[own.y][own.x];
        const vec2 seenHere = imageLoad(surfaceChannel, at).rg;
        const float footprint
            = footprintAlong(eyeOfPixel(seenHere.y, frame.mEyes), surfaceDistance(seenHere.y));
        vec2 momentSum = vec2(0.0);
        float momentWeight = 0.0;
        for (int y = -REACH; y <= REACH; ++y)
            for (int x = -REACH; x <= REACH; ++x)
            {
                const ivec2 tap = own + ivec2(x, y);
                const float alike = facingWeight(normal, gNormals[tap.y][tap.x], ATROUS_NORMAL_POWER)
                    * coplanarWeight(normal, position, gPositions[tap.y][tap.x], footprint);
                momentSum += alike * gMoments[tap.y][tap.x];
                momentWeight += alike;
            }
        variance = shortHistoryVariance(momentSum.x / momentWeight, momentSum.y / momentWeight, frames);
    }
    imageStore(blended, at, vec4(held, variance));
    imageStore(fillBlended, at, vec4(heldFill, 0.0));
    imageStore(fastOut, at, uvec4(packRgb9e5(followed), packRgb9e5(followedFill), 0u, 0u));
}
