#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The trace's channels back into one picture, still in linear radiance, written over the direct
// channel it was composed from.
//
// **Separate because a filter needs every pixel before any pixel is finished.** The trace writes
// indirect light with the albedo divided out; something between here and there blurs it, which it
// can only do once the whole image exists. Multiplying the albedo back afterwards is what returns
// texture detail a blur would otherwise have smeared — the mortar between bricks is in the albedo,
// and the light falling on the wall is not.
//
// **And only where something stands between the two.** A frame nothing filters was composed by the
// trace itself (`VisibilityConstants::mComposed`), and runs this only to add it to a sum.
//
// **In place**, because each invocation reads and writes its own pixel and nothing reads the direct
// light apart from the frame after this: the frame is one image fewer, and the one an upscaler, the
// puffs and the curve take is the channel the trace wrote.

#include "shared/composite.h"
#include "gbuffer.h"
#include "shared/sets.h"
#include "shared/shadow.h"

#include "lib/census.glsl"
#include "lib/pixels.glsl"

layout(local_size_x = COMPOSITE_WORKGROUP, local_size_y = COMPOSITE_WORKGROUP) in;

/// Everything already resolved: direct light, emission, the sky, water, and the fog over all of it,
/// and the frame once this has run. No format, for the reason the bounce below gives twice over: the
/// run decides its width too, and a load and a store with no format both convert.
layout(set = SET_PASS, binding = COMPOSITE_BIND_DIRECT) uniform image2D direct;

/// The one bounce with the albedo divided out, times whatever the water and the air took off it on
/// the way to the eye — the channel the wavelet filters.
///
/// **Declared with no format, because this is two images.** A denoised frame hands over the
/// cascade's last level and an undenoised one hands over `CHANNEL_INDIRECT` itself, and those are
/// `ATROUS_CHANNEL` and whichever width the run gave the channel. A `readonly` image that states
/// no format converts from whatever the view holds, which `requirements.cpp` requires the device
/// to be able to do.
layout(set = SET_PASS, binding = COMPOSITE_BIND_INDIRECT) uniform readonly image2D indirect;

/// What to put back: the surface's own albedo, and nothing of the path.
layout(set = SET_PASS, binding = COMPOSITE_BIND_ALBEDO, GBUFFER_ALBEDO) uniform readonly image2D albedo;

/// The share of the bounce that is the fill: the cascade's mean of it on a denoised frame, and
/// `CHANNEL_FILL` itself on an undenoised one. No format, for the reason `indirect` has none. And
/// what puts it back in place of `albedo`, `CHANNEL_AMBIENT_ALBEDO`.
layout(set = SET_PASS, binding = COMPOSITE_BIND_FILL) uniform readonly image2D fill;
layout(set = SET_PASS, binding = COMPOSITE_BIND_AMBIENT_ALBEDO, GBUFFER_ALBEDO) uniform readonly image2D ambientAlbedo;

/// What the sun or a moon adds as though its ray got through, and whether it did —
/// `CHANNEL_SHADOWED` — and the same of the lamps, `CHANNEL_LAMPED`. No format, as `direct` has
/// none.
layout(set = SET_PASS, binding = COMPOSITE_BIND_SHADOWED) uniform readonly image2D shadowed;
layout(set = SET_PASS, binding = COMPOSITE_BIND_LAMPED) uniform readonly image2D lamped;

/// How much of each got through, as the shadow denoiser filtered its field's bits: the mean's float
/// in `r`, as its bits.
layout(set = SET_PASS, binding = COMPOSITE_BIND_SHADOW, SHADOW_VISIBILITY) uniform readonly uimage2D shadow;
layout(set = SET_PASS, binding = COMPOSITE_BIND_LAMP_SHADOW, SHADOW_VISIBILITY) uniform readonly uimage2D lampShadow;

/// The lobe's light, demodulated: the glossy filter's mean where it ran, and `CHANNEL_SPECULAR`
/// itself where it did not. No format, for the reason `indirect` has none. And what puts it back,
/// `CHANNEL_SPECULAR_ALBEDO`.
layout(set = SET_PASS, binding = COMPOSITE_BIND_SPECULAR) uniform readonly image2D specular;
layout(set = SET_PASS, binding = COMPOSITE_BIND_SPECULAR_ALBEDO, GBUFFER_ALBEDO) uniform readonly image2D specularAlbedo;

/// What was drawn for the see-through layers, demodulated: the pane filter's mean where it ran, and
/// `CHANNEL_PANE` itself where it did not. No format, for the reason `indirect` has none. And what
/// puts it back, `CHANNEL_PANE_ALBEDO`.
layout(set = SET_PASS, binding = COMPOSITE_BIND_PANE) uniform readonly image2D pane;
layout(set = SET_PASS, binding = COMPOSITE_BIND_PANE_ALBEDO, GBUFFER_ALBEDO) uniform readonly image2D paneAlbedo;

/// The running sum, when `mAccumulate` asks for one.
layout(set = SET_PASS, binding = COMPOSITE_BIND_SUM, COMPOSITE_SUM_FORMAT) uniform image2D sum;

layout(push_constant, scalar) uniform Push
{
    CompositeConstants frame;
};

// After the images, which it reads by name.
#include "lib/resolve.glsl"

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (outsideOf(pixel, uvec2(frame.mWidth, frame.mHeight)))
        return;

    const ivec2 at = ivec2(pixel);
    vec3 resolved = imageLoad(direct, at).rgb;
    if (frame.mComposed == 0u)
        resolved = resolvedLight(
            at, resolved, imageLoad(indirect, at).rgb, imageLoad(fill, at).rgb, frame.mShadowed, frame.mLobed);

    // In linear, which is what everything downstream of here now works in. Summing an encoded frame
    // would add up rounded numbers and clip every sample past the display's range to the same value
    // — losing exactly the fireflies a reference is wanted to measure.
    if (frame.mAccumulate > 0u)
    {
        const vec3 total = frame.mAccumulate > 1u ? imageLoad(sum, at).rgb + resolved : resolved;
        RTX_STORE_COUNTED(sum, at, vec4(total, 1.0))
        resolved = total / float(frame.mAccumulate);
    }

    // The alpha is the puffs' composite's to write, and the curve's to read only where it did.
    RTX_STORE_COUNTED(direct, at, vec4(resolved, 1.0))
}
