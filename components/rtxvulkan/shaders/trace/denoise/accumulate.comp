#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The wavelet's temporal half: this pixel's bounce, averaged with what the same surface gave on the
// frames before it.
//
// **The cascade behind this exists to fill in where this was rejected.** That is the shape every
// denoiser the field settled on has — SVGF, A-SVGF, ReLAX, ReBLUR — and the renderer had the second
// half without the first: five spatial levels blurring a single sample, with no way to tell a bright
// pixel from a wrong one. An average over frames is where the estimator's error actually falls, and
// the variance it produces on the way is what finally lets the cascade stop at an edge in the
// *light* rather than only at an edge in the geometry.
//
// **The history is this pass's own and not the G-buffer's.** What it has to answer is "does the
// history at that pixel belong to this surface", which is a question about what was accumulated
// rather than about what the frame drew — so the normal and the distance the history belongs to are
// carried beside the history itself.
//
// **What an occluder uncovered takes the history beside it** (`occluderMotion`, Zeng et al. 2021's
// dual motion vector, which ReSTIR PT Enhanced applies to its temporal reuse): a surface the
// previous frame did not see is fetched along the motion of what hid it, held to its own plane. A
// floor a bar uncovered kept a fifth of the noise it had without it, near the floor beside a bar
// that stood still (`theFloorAMovingBarUncoversStartsWithTheHistoryBesideIt`).

#include "shared/accumulate.h"
#include "shared/atrous.h"
#include "camera.h"
#include "colour.h"
#include "gbuffer.h"
#include "shared/sets.h"

#include "lib/census.glsl"
#include "lib/halfround.glsl"
#include "lib/pixels.glsl"
#include "lib/runningmean.glsl"
#include "lib/sharedexponent.glsl"
#include "lib/surfacematch.glsl"

layout(local_size_x = ACCUMULATE_WORKGROUP, local_size_y = ACCUMULATE_WORKGROUP) in;

/// The bounce this frame traced, one sample a pixel, exactly as the trace left it. No format,
/// because the run decides the channel's width — `gbuffer.h` says which run gets which.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_INDIRECT) uniform readonly image2D indirect;

/// Where each surface stood on the previous frame's screen, less where it stands on this one.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_MOTION, GBUFFER_MOTION) uniform readonly image2D motion;

/// The shading normal's code in `r` and the distance from the eye in `g`, in world units —
/// `CHANNEL_SURFACE`. A ray that hit nothing left no normal, which no surface matches.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_SURFACE, GBUFFER_SURFACE) uniform readonly image2D surfaceChannel;

/// Last frame's mean in `rgb`.
///
/// **Written by the cascade's first level and not by this pass**, which is SVGF's feedback: what a
/// pixel carries forward is the filtered light rather than the single sample it blended, so the
/// history it draws on is as quiet as the picture the frame showed. How many frames are in it is
/// the fourth channel of `historyFill`.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_COLOUR, ACCUMULATE_COLOUR)
    uniform readonly image2D historyColour;

/// The surface last frame's mean belongs to: the frame before's `CHANNEL_SURFACE` (`GBuffer::getHeld`).
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_SURFACE, GBUFFER_SURFACE)
    uniform readonly image2D historySurface;

/// The mean and the deviation of that mean's luminance (`ACCUMULATE_MOMENTS`). The variance goes to the
/// cascade beside the blend, by the clamp.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_MOMENTS, ACCUMULATE_MOMENTS)
    uniform readonly image2D historyMoments;

layout(set = SET_PASS, binding = ACCUMULATE_BIND_MOMENTS_OUT, ACCUMULATE_MOMENTS) uniform writeonly image2D momentsOut;

/// This frame's bounce blended with the history in `rgb`, which is what the cascade reads. **Nought
/// in `a`, where the clamp writes the deviation** the cascade weighs a tap by, out of the moments this
/// writes beside it (`accumulateclamp.comp`): the variance over one sample is exactly nought, which a
/// filter reads as "this pixel is certain", and only the square around a short history can say how
/// noisy it is.
///
/// **The cascade's channel and not the trace's**, so `CHANNEL_INDIRECT` keeps what the trace put
/// there for the whole of the frame. `AccumulatePass::record` says what that separation is worth.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_BLENDED_OUT, ATROUS_CHANNEL) uniform writeonly image2D blendedOut;

/// The share of the bounce that is the fill, `CHANNEL_FILL`, its last frame's mean, and the two
/// blended in `rgb`, as the bounce's are; and in the mean's and the blend's `a`, how many frames
/// each holds.
///
/// **Blended by the bounce's weights and the bounce's count**, so the fill's mean stays the share of
/// the bounce's mean that its samples were of theirs: what the composite takes off the one and puts
/// back by the ambient albedo is the same light.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_FILL) uniform readonly image2D fill;
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_FILL, ACCUMULATE_COLOUR) uniform readonly image2D historyFill;
layout(set = SET_PASS, binding = ACCUMULATE_BIND_FILL_BLENDED_OUT, ATROUS_CHANNEL) uniform writeonly image2D fillBlendedOut;

/// The fast means of the bounce and the fill (`ACCUMULATE_FAST`), last frame's and this frame's blend
/// of them: the same samples over at most `ACCUMULATE_FAST_FRAMES`, by the same taps and count. **The
/// accumulator's own and not the cascade's**, since what they are for is to follow the light quickly,
/// not quietly. The blend is an image of its own, and the clamp writes this frame's fast means from
/// it: it reads a neighbour's blend while it writes its own pixel's mean.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_FAST, ACCUMULATE_FAST) uniform readonly uimage2D historyFast;
layout(set = SET_PASS, binding = ACCUMULATE_BIND_FAST_OUT, ACCUMULATE_FAST) uniform writeonly uimage2D fastOut;

layout(push_constant, scalar) uniform Push
{
    AccumulateConstants frame;
};

/// What the history holds of this pixel's surface, summed over the taps that are it, each by its
/// bilinear share.
struct Held
{
    vec3 mMean;
    vec3 mMeanFill;
    vec3 mFast;
    vec3 mFastFill;
    vec2 mMoments;
    float mFrames;
    float mWeight;
};

/// Adds the four texels `before` spans to `held`, each by its matched share.
void gatherHistory(inout Held held, HistoryFootprint before, vec4 shares)
{
    for (int i = 0; i < 4; ++i)
    {
        const float bilinear = shares[i];
        const ivec2 tap = historyTap(before, i);
        if (!(bilinear > 0.0))
            continue;

        const vec2 heldMoments = imageLoad(historyMoments, tap).rg;
        const vec4 heldFill = imageLoad(historyFill, tap);
        held.mMean += imageLoad(historyColour, tap).rgb * bilinear;
        held.mMeanFill += heldFill.rgb * bilinear;
        const uvec2 heldFast = imageLoad(historyFast, tap).xy;
        held.mFast += unpackRgb9e5(heldFast.x) * bilinear;
        held.mFastFill += unpackRgb9e5(heldFast.y) * bilinear;
        held.mMoments += vec2(heldMoments.x, secondMoment(heldMoments.x, heldMoments.y)) * bilinear;
        held.mFrames += heldFill.a * bilinear;
        held.mWeight += bilinear;
    }
}

/// Whether the pixel at `tap` holds a surface nearer the eye than `away` by more than `tolerance`,
/// the pixel's own plane tolerance, and its motion in `xy` where it does.
vec3 nearerAt(ivec2 tap, float away, float tolerance)
{
    if (outsideOf(tap, uvec2(frame.mHistory.mEyes.mWorld.mWidth, frame.mHistory.mEyes.mWorld.mHeight)))
        return vec3(0.0);

    const vec2 seen = imageLoad(surfaceChannel, tap).xy;
    const bool nearer = seen.x != SURFACE_NO_NORMAL && surfaceDistance(seen.y) < away - tolerance;
    return nearer ? vec3(imageLoad(motion, tap).xy, 1.0) : vec3(0.0);
}

/// The motion of the occluder that hid this pixel's surface last frame, in `xy`, and in `z` one
/// where one was found and nought where none was: Zeng et al. 2021's dual motion vector.
///
/// **The occluder's own motion vector is the dual one.** The pixel's motion sends it to `y`, where
/// the occluder stood; the occluder stands at `z` now, with `z + m(z) = y`; and the history Zeng et
/// al. fetch, `y + (at - z)`, is `at + m(z)`. So no second trace finds it: a pixel of this frame
/// nearer the eye than this one whose motion lands on `y` is the occluder, and its motion is the
/// answer. **Found in two steps, as Zeng et al. find `z`**: any surface nearer the eye on rings
/// out to `ACCUMULATE_DUAL_REACH` carries the occluder's motion, the one landing nearest `y` taken;
/// `z = y - m` is then where that occluder now stands, and its own motion there must land on `y`
/// within `ACCUMULATE_DUAL_MISS`, or what was found is not what hid the pixel.
vec3 occluderMotion(ivec2 at, vec3 moved, float away, float tolerance)
{
    const vec2 landed = vec2(at) + moved.xy;
    float nearest = 1e30;
    vec2 guess = vec2(0.0);
    for (int ring = 1; ring <= ACCUMULATE_DUAL_REACH; ring *= 2)
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x)
            {
                const ivec2 tap = at + ivec2(x, y) * ring;
                const vec3 there = (x == 0 && y == 0) ? vec3(0.0) : nearerAt(tap, away, tolerance);
                const float miss = distance(vec2(tap) + there.xy, landed);
                if (there.z > 0.0 && miss < nearest)
                {
                    nearest = miss;
                    guess = there.xy;
                }
            }

    if (!(nearest < 1e30))
        return vec3(0.0);

    const ivec2 occluder = ivec2(floor(landed - guess + 0.5));
    const vec3 there = nearerAt(occluder, away, tolerance);
    const bool lands = there.z > 0.0 && distance(vec2(occluder) + there.xy, landed) < ACCUMULATE_DUAL_MISS;
    return lands ? vec3(there.xy, 1.0) : vec3(0.0);
}

void main()
{
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (outsideOf(uvec2(at), uvec2(frame.mHistory.mEyes.mWorld.mWidth, frame.mHistory.mEyes.mWorld.mHeight)))
        return;

    const vec3 sampled = imageLoad(indirect, at).rgb;
    const vec3 sampledFill = imageLoad(fill, at).rgb;
    const vec2 seen = imageLoad(surfaceChannel, at).xy;
    const vec3 normal = unpackSurfaceNormal(seen.x);
    const float away = surfaceDistance(seen.y);

    // A pixel with no surface under it has nothing to accumulate and nothing to hand on. The sky is
    // resolved into `direct` by the trace and never reaches here as light.
    uint rounding = seededKey(pixelKey(uvec2(at)) + SEED_BOUNCE_ROUNDING, frame.mHistory.mFrame);
    if (dot(normal, normal) <= 0.0)
    {
        // **The sky writes its sample on too, and it has to.** The cascade copies a pixel with no
        // surface straight through, so one this never wrote would arrive there as whatever the
        // allocation held — and the composite multiplies it by an albedo of nought, which turns a
        // stray infinity into a NaN rather than into nothing.
        vec4 skyBounce = vec4(sampled, 0.0);
        vec4 skyFill = vec4(sampledFill, 0.0);
        roundedToHalves(skyBounce, skyFill, rounding);
        RTX_STORE_COUNTED(blendedOut, at, skyBounce)
        RTX_STORE_COUNTED(fillBlendedOut, at, skyFill)
        RTX_STORE_COUNTED(momentsOut, at, vec4(0.0))
        RTX_STORE_WORDS(fastOut, at, uvec4(packRgb9e5(sampled), packRgb9e5(sampledFill), 0u, 0u))

        return;
    }

    // **Bilinear over the four it landed between, each taken only if it is this surface.** A nearest
    // tap is a history that steps a whole pixel at a time, which under any camera motion is a crawl
    // along every edge; weighting the four and dropping the ones that are a different surface is
    // what keeps it smooth without dragging the wall behind into the floor in front.
    const vec3 moved = imageLoad(motion, at).xyz;
    const HistoryFootprint before = historyFootprint(at, moved);

    Held held = Held(vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), vec2(0.0), 0.0, 0.0);
    if (frame.mHistory.mReset == 0u)
    {
        const HistoryPlane plane = historyPlane(frame.mHistory, at, seen, moved);
        const uvec2 extent = uvec2(frame.mHistory.mEyes.mWorld.mWidth, frame.mHistory.mEyes.mWorld.mHeight);
        RTX_HISTORY_SHARES(shares, before, extent, historySurface, true, plane)
        gatherHistory(held, before, shares);

        // **Where the surface was hidden and not off the screen**, the history along the occluder's
        // motion (`occluderMotion`). A branch, which only the pixels an occluder uncovered take:
        // measured on the interiors, the accumulator's 0.28 ms became 0.29. **Held to the pixel's
        // own plane, as the pixel's own texels are**: a texel the occluder's motion leads to is
        // another point of the surface, as far off as the occluder moved, which a test on one point's
        // distance refused on a floor five pixels on.
        const vec2 landed = vec2(at) + 0.5 + moved.xy;
        const vec3 previousForward = frame.mHistory.mPrevious.mForward;
        const bool hidden = frame.mDualMotion != 0u && dot(previousForward, previousForward) > 0.0
            && !(held.mWeight > 0.0) && !outsideOf(ivec2(floor(landed)), extent);
        if (hidden)
        {
            const vec3 dual = occluderMotion(at, moved, away, plane.mTolerance);
            if (dual.z > 0.0)
            {
                const HistoryFootprint along = historyFootprint(at, vec3(dual.xy, moved.z));
                RTX_HISTORY_SHARES(alongShares, along, extent, historySurface, true, plane)
                gatherHistory(held, along, alongShares);
            }
        }
    }

    vec3 mean = held.mMean;
    vec3 meanFill = held.mMeanFill;
    vec3 fast = held.mFast;
    vec3 fastFill = held.mFastFill;
    vec2 moments = held.mMoments;
    float frames = held.mFrames;
    float weight = held.mWeight;

    const float lit = dot(sampled, LUMINANCE_WEIGHTS);

    vec3 blended = sampled;
    vec3 blendedFill = sampledFill;
    vec3 blendedFast = sampled;
    vec3 blendedFastFill = sampledFill;
    vec2 blendedMoments = vec2(lit, 0.0);
    // **Not `length`, which is GLSL's own**: a local of that name hides the builtin from everything
    // below it, and the next edit that reaches for one gets a compile error with no explanation in it.
    //
    // **One with no history, because the mean it stores is this frame's sample.** Nought would read
    // back as a history of nothing, and the next frame would blend at a weight of one and throw the
    // sample away: every pixel a surface uncovers, and every pixel of a reset, would keep one sample
    // for two frames and count one frame short ever after.
    float count = 1.0;

    if (weight > 0.0)
    {
        mean /= weight;
        meanFill /= weight;
        fast /= weight;
        fastFill /= weight;
        moments /= weight;
        frames /= weight;

        // One over the count, floored at the longest history a pixel may keep (`historyAlpha`).
        count = min(frames + 1.0, ACCUMULATE_FRAMES);
        const float alpha = historyAlpha(frames);

        // **No outlier clamp on the sample.** A bounce is often a rare bright event: one that finds
        // a sunlit surface with probability `p` stands `sqrt((1 - p) / p)` deviations over the mean,
        // so a ceiling of `k` deviations cuts every such sample where `p < 1 / (1 + k²)`, whatever
        // `k` is — at four, 42% of the light of a two-per-cent event. Clamped at four, the still
        // sail at Seyda Neen stood 2.2 levels darker than the truth and 2.6 times as noisy. An
        // outlier is the wavelet's to spread, weighed by the variance it raises.
        blended = mix(mean, sampled, alpha);
        blendedFill = mix(meanFill, sampledFill, alpha);

        // The running variance (`ACCUMULATE_MOMENTS`): the same blend of the moments, kept as what it
        // is the variance of.
        const float offMean = lit - moments.x;
        const float variance = (1.0 - alpha) * (momentVariance(moments.x, moments.y) + alpha * offMean * offMean);
        blendedMoments = vec2(mix(moments.x, lit, alpha), sqrt(variance));

        const float fastAlpha = 1.0 / min(frames + 1.0, ACCUMULATE_FAST_FRAMES);
        blendedFast = mix(fast, sampled, fastAlpha);
        blendedFastFill = mix(fastFill, sampledFill, fastAlpha);
    }

    vec4 bounceOut = vec4(blended, 0.0);
    vec4 fillOut = vec4(blendedFill, count);
    roundedToHalves(bounceOut, fillOut, rounding);
    RTX_STORE_COUNTED(blendedOut, at, bounceOut)
    RTX_STORE_COUNTED(fillBlendedOut, at, fillOut)
    RTX_STORE_COUNTED(momentsOut, at, vec4(roundedToHalf(blendedMoments, rounding), 0.0, 0.0))
    RTX_STORE_WORDS(fastOut, at, uvec4(packRgb9e5(blendedFast), packRgb9e5(blendedFastFill), 0u, 0u))
}
