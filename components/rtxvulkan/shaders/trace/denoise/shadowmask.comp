// The rays' bits, packed a word to an 8×4 tile — the SDK's `PrepareShadowMask`.
//
// **Once a pixel, so the classification reads words and not texels.** Its kernel and its three
// filter levels reach a 24×24 square around each tile; read off `CHANNEL_SHADOWED` directly, that
// was every texel nine times over, and the classification cost 0.24 ms at 1080p whether it filtered
// anything or not.
//
// **A shared word and an atomic OR, not the SDK's wave-wide OR**, which assumes a wave of 32 lanes
// laid out as the tile: AMD's are 32 or 64 and Intel's 8 to 32. A pixel off the frame is nought; the
// classification knows the frame's extent and does not read it as a shadow.
//
// **And the widest penumbra among the stopped rays, a half a workgroup**: the workgroup's two words
// are one tile of the classification, which reads the nine around its own rather than the 576
// texels of `CHANNEL_PENUMBRA` they stand for. An open ray has none, and neither has a tile with no
// ray stopped: nought.

#include "gbuffer.h"
#include "sets.h"
#include "shadow.h"

#include "lib/pixels.glsl"

layout(local_size_x = SHADOW_MASK_WIDTH, local_size_y = 2 * SHADOW_MASK_HEIGHT) in;

/// `CHANNEL_SHADOWED`, for its alpha: whether the pixel's rays got through. No format, because it
/// is as wide as the run keeps radiance.
layout(set = SET_PASS, binding = SHADOW_MASK_BIND_SHADOWED) uniform readonly image2D shadowed;

layout(set = SET_PASS, binding = SHADOW_MASK_BIND_MASK, SHADOW_MASK) uniform writeonly uimage2D mask;

/// `CHANNEL_PENUMBRA`, and the widest of it among the workgroup's stopped rays.
layout(set = SET_PASS, binding = SHADOW_MASK_BIND_PENUMBRA, GBUFFER_PENUMBRA) uniform readonly image2D penumbra;
layout(set = SET_PASS, binding = SHADOW_MASK_BIND_PENUMBRA_TILES, SHADOW_PENUMBRA_TILES)
    uniform writeonly image2D penumbraTiles;

layout(push_constant, scalar) uniform Push
{
    ShadowMaskConstants frame;
};

/// The two tiles one workgroup covers, the upper and the lower.
shared uint gTiles[2];

/// The widest penumbra of the workgroup's stopped rays, as the bits of a float that is never below
/// nought, which order as the float does.
shared uint gWidest;

void main()
{
    const uvec2 local = gl_LocalInvocationID.xy;
    const uvec2 at = gl_GlobalInvocationID.xy;

    if (gl_LocalInvocationIndex < 2u)
        gTiles[gl_LocalInvocationIndex] = 0u;
    if (gl_LocalInvocationIndex == 0u)
        gWidest = 0u;

    barrier();

    if (!outsideOf(at, uvec2(frame.mWidth, frame.mHeight)))
    {
        if (imageLoad(shadowed, ivec2(at)).a > 0.5)
        {
            const uint bit = (local.y % SHADOW_MASK_HEIGHT) * SHADOW_MASK_WIDTH + local.x;
            atomicOr(gTiles[local.y / SHADOW_MASK_HEIGHT], 1u << bit);
        }

        const float radius = imageLoad(penumbra, ivec2(at)).r;
        if (radius < SHADOW_PENUMBRA_CLEAR)
            atomicMax(gWidest, floatBitsToUint(max(radius, 0.0)));
    }

    barrier();

    if (gl_LocalInvocationIndex == 0u)
        imageStore(penumbraTiles, ivec2(gl_WorkGroupID.xy), vec4(uintBitsToFloat(gWidest)));

    if (gl_LocalInvocationIndex < 2u)
    {
        const ivec2 tile = ivec2(gl_WorkGroupID.x, gl_WorkGroupID.y * 2u + gl_LocalInvocationIndex);
        if (tile.y * int(SHADOW_MASK_HEIGHT) < int(frame.mHeight))
            imageStore(mask, tile, uvec4(gTiles[gl_LocalInvocationIndex]));
    }
}
