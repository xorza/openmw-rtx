// The shadow denoiser's temporal half: which tiles need filtering at all, and for those that do,
// this frame's bit blended with what the same surface held before, clamped to what its neighbours
// say now.
//
// **What the port keeps is the algorithm**: the 17×17 kernel over the bits that gives each pixel its
// local mean and spread, the clamp of the history to half a deviation of it, the sample count damped
// by how far the history stood off, the variance boosted over the first sixteen frames, and the
// blend of five per cent a frame once the history is eight deep. Each constant is the SDK's.
//
// **What it changes, and why:**
//
// - **No subgroup operation.** The SDK's all-true takes a wave-wide vote where a wave is the
//   workgroup, and falls back to shared memory where it is not; the fallback is the one kept, since
//   AMD's waves are 32 or 64 lanes and Intel's 8 to 32. The words `shadowmask.comp` packed are laid
//   out as rows of the square in shared memory, one word a row.
// - **The tree's reprojection.** The SDK fetches its history at `uv + velocity`, dilated to the
//   nearest depth of a quad, and calls a pixel disoccluded by a depth through projection matrices.
//   This fetches where the accumulator fetches and keeps a tap only where `heldSurfaceMatches` says it
//   is this surface, against the frame before's surface channel: one rule for "the same surface
//   as last frame", and no depth history beside it.
// - **The frame's edge is not a shadow.** The local mean is taken over the pixels the frame holds,
//   where the SDK counts those off it as shadowed; `horizontalNeighbourhood` says what that cost.
// - **Who receives.** A receiver is a surface the shadowed sources light at all
//   (`receivesShadowed`), so a stretch no lamp reaches in a room skips every tile here. **And only a
//   receiver is in the local mean**: the SDK counts every pixel's bit, and a pixel no source lights
//   keeps a bit of one, which held a receiver in hard shadow beside it up to a seam of light
//   (`shadow.h`).
// - **A hard shadow is not noise.** Where the widest penumbra in the tile and the tiles around it
//   is under a pixel and no bit there was drawn from among sources (`SHADOW_PENUMBRA_DRAWN`), the
//   pixel's own bit is the answer, and no history is blended in: such a bit is the same every
//   frame, and the box of the bits around it, half a deviation about their mean, held a shadow
//   seven pixels wide 14 levels of 255 lighter than the raw frame and the floor beside it darker. A
//   jittered edge's bit changes with the jitter, and that is the upscaler's to resolve, as it
//   resolves every other edge. **The edge of a penumbra under a pixel is noise as the raw frame's
//   is**: at the pond, whose leaves' shadows are that hard, the frame's noise rose from 0.46 to
//   0.50 and its bias fell from 1.50 to 1.48, where the pier and the guild did not move. The reach
//   is NVIDIA's SIGMA's rule (the distance to the occluder times the source's half angle, in
//   pixels), and this pass hands it to the spatial levels, which run only as far.

#include "shared/accumulate.h"
#include "gbuffer.h"
#include "shared/sets.h"
#include "shared/shadow.h"

#include "lib/census.glsl"
#include "lib/hash.glsl"
#include "lib/pixels.glsl"
#include "lib/shadowword.glsl"
#include "lib/surfacematch.glsl"

layout(local_size_x = SHADOW_WORKGROUP, local_size_y = SHADOW_WORKGROUP) in;

layout(set = SET_PASS, binding = SHADOW_TILES_BIND_SURFACE, GBUFFER_SURFACE) uniform readonly image2D surfaceChannel;
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_MOTION, GBUFFER_MOTION) uniform readonly image2D motion;

/// The surface this history belongs to: the frame before's `CHANNEL_SURFACE` (`GBuffer::getHeld`).
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_HELD_SURFACE, GBUFFER_SURFACE)
    uniform readonly image2D heldSurface;

/// Last frame's first filter level: the mean the SDK carries forward, as SVGF carries the wavelet's.
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_HISTORY, SHADOW_REPROJECTED) uniform readonly uimage2D history;

/// The mean, the running sum of squared deviations and the sample count, last frame's and this one's,
/// in two words (`packShadowMoments`).
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_MOMENTS_BEFORE, SHADOW_MOMENTS)
    uniform readonly uimage2D momentsBefore;
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_MOMENTS, SHADOW_MOMENTS) uniform writeonly uimage2D moments;

/// This frame's blend and its variance, which the first filter level reads.
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_REPROJECTED, SHADOW_REPROJECTED)
    uniform writeonly uimage2D reprojected;

/// One where the tile was cleared, nought where the filter runs over it.
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_TILES, SHADOW_TILES) uniform writeonly image2D tiles;

/// The rays' bits and the receivers', two words an 8×4 tile — `shadowmask.comp`.
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_MASK, SHADOW_MASK) uniform readonly uimage2D mask;

/// The widest penumbra in each tile — `shadowmask.comp`.
layout(set = SET_PASS, binding = SHADOW_TILES_BIND_PENUMBRA_TILES, SHADOW_PENUMBRA_TILES)
    uniform readonly image2D penumbraTiles;

layout(push_constant, scalar) uniform Push
{
    ShadowTilesConstants temporal;
};

/// The kernel's radius, and the apron the square carries past the workgroup on every side.
const uint REACH = SHADOW_REACH;

/// The side of the square of bits a workgroup reads.
const uint SPAN = SHADOW_WORKGROUP + 2u * REACH;

/// The square's bits, one row a word: bit `c` of row `r` is the pixel `c` columns and `r` rows from
/// the square's corner. `receiving` is set where the shadowed sources light the pixel, which the mask
/// says only of a pixel inside the frame, and `open` where it receives and its rays got through.
shared uint gOpen[SPAN];
shared uint gReceiving[SPAN];

/// The widest penumbra of this tile and the eight around it, which the square's apron reaches, as
/// the bits of a float that is never below nought.
shared uint gReach;

/// Each column's horizontal kernel over every row of the square, which the vertical half then
/// reads: the weight of the open pixels, and the weight of the pixels inside the frame.
shared vec2 gRows[SHADOW_WORKGROUP][SPAN];

/// The horizontal half of the kernel (`shadowLocalWeight`) over row `row` of the square, centred on
/// column `column + REACH`: the SDK's `HorizontalNeighborhood`, off the shared row rather than off
/// three tile words — the weight of the open pixels, and beside it the weight of the receivers.
/// **Not normalised over its taps, as the SDK's is**, because what reads it is the ratio of two
/// sums under the same weights, and the factor falls out of it.
///
/// **What the SDK does not carry is the second**: it counts every pixel, a pixel off the frame as
/// shadowed and one no source lights as whatever its bit says. Off the frame, the local mean of a lit
/// floor fell toward the frame's edge and the clamp pulled the history down with it: measured on a
/// penumbra that runs off the frame, the denoised mean stood 1.3% under a 256-frame reference. The
/// two sums make the mean one over the receivers.
vec2 horizontalNeighbourhood(uint row, uint column)
{
    const uint open = gOpen[row] >> column;
    const uint receiving = gReceiving[row] >> column;

    vec2 moment = vec2(0.0);
    for (int i = 0; i <= 2 * int(REACH); ++i)
    {
        const float weight = shadowLocalWeight(uint(abs(i - int(REACH))));
        moment += vec2(((open >> uint(i)) & 1u) != 0u ? weight : 0.0,
            ((receiving >> uint(i)) & 1u) != 0u ? weight : 0.0);
    }

    return moment;
}

void main()
{
    const HistoryConstants frame = temporal.mHistory;
    const uvec2 extent = uvec2(frame.mEyes.mWorld.mWidth, frame.mEyes.mWorld.mHeight);
    const uvec2 local = gl_LocalInvocationID.xy;
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    const bool inFrame = !outsideOf(uvec2(at), extent);
    const ivec2 corner = ivec2(gl_WorkGroupID.xy * SHADOW_WORKGROUP) - int(REACH);

    // The draws every store of this pass rounds by, one stream a field.
    uint rounding = seededKey(
        pixelKey(uvec2(at)) + (temporal.mField == SHADOW_FIELD_SKY ? SEED_SKY_SHADOW_ROUNDING : SEED_LAMP_SHADOW_ROUNDING),
        frame.mFrame);

    if (gl_LocalInvocationIndex == 0u)
        gReach = 0u;

    // A row of the square a lane: the byte of each of the three tiles across it that holds the row.
    // The square's corner stands on a tile's, so its columns are whole tiles.
    if (gl_LocalInvocationIndex < SPAN)
    {
        const uint row = gl_LocalInvocationIndex;
        const int y = corner.y + int(row);

        uint open = 0u;
        uint receiving = 0u;
        if (y >= 0 && y < int(extent.y))
        {
            const uint shift = (uint(y) % SHADOW_MASK_HEIGHT) * SHADOW_MASK_WIDTH;
            const int tiles = int((extent.x + SHADOW_MASK_WIDTH - 1u) / SHADOW_MASK_WIDTH);
            for (uint across = 0u; across < SPAN / SHADOW_MASK_WIDTH; ++across)
            {
                const int tile = corner.x / int(SHADOW_MASK_WIDTH) + int(across);
                if (tile < 0 || tile >= tiles)
                    continue;

                const uvec2 words = imageLoad(mask, ivec2(tile, y / int(SHADOW_MASK_HEIGHT))).rg;
                open |= ((words.x >> shift) & 0xFFu) << (across * SHADOW_MASK_WIDTH);
                receiving |= ((words.y >> shift) & 0xFFu) << (across * SHADOW_MASK_WIDTH);
            }
        }

        gOpen[row] = open;
        gReceiving[row] = receiving;
    }

    barrier();

    const uvec2 square = local + REACH;
    const bool receiver = ((gReceiving[square.y] >> square.x) & 1u) != 0u;

    // The nine tiles the square stands on, a lane each: its apron is one tile wide (`shadow.h`).
    if (gl_LocalInvocationIndex < 9u)
    {
        const ivec2 tile = ivec2(gl_WorkGroupID.xy) + ivec2(gl_LocalInvocationIndex % 3u, gl_LocalInvocationIndex / 3u) - 1;
        const ivec2 tiles = ivec2((extent + SHADOW_WORKGROUP - 1u) / SHADOW_WORKGROUP);
        if (all(greaterThanEqual(tile, ivec2(0))) && all(lessThan(tile, tiles)))
            atomicMax(gReach, floatBitsToUint(imageLoad(penumbraTiles, tile).r));
    }

    barrier();

    const float reach = uintBitsToFloat(gReach);

    // **Whole tiles out, uniformly**, before any pixel of them costs anything: the branch is the
    // workgroup's, so no lane waits on another. The SDK's two early outs, in its order: no receiver
    // among the workgroup's own pixels, the middle of the square; and every receiver in the square
    // open, or none.
    bool noReceiver = true;
    for (uint row = REACH; row < REACH + SHADOW_WORKGROUP; ++row)
        noReceiver = noReceiver && (gReceiving[row] & (lowBits(SHADOW_WORKGROUP) << REACH)) == 0u;

    bool allLit = true;
    bool allShadowed = true;
    for (uint row = 0u; row < SPAN; ++row)
    {
        allLit = allLit && gOpen[row] == gReceiving[row];
        allShadowed = allShadowed && gOpen[row] == 0u;
    }

    if (noReceiver || allLit || allShadowed)
    {
        // Every pixel's answer is exact, and the neighbours' filter levels may read it.
        const float value = !noReceiver && allLit ? 1.0 : 0.0;
        if (gl_LocalInvocationIndex == 0u)
            RTX_STORE_COUNTED(tiles, ivec2(gl_WorkGroupID.xy), vec4(1.0, reach, 0.0, 0.0))
        if (inFrame)
        {
            // Nought or one, and moments of nought or one, which every rounding keeps.
            RTX_STORE_WORDS(reprojected, at,
                uvec4(packShadowWord(vec2(value, receiver ? 0.0 : SHADOW_NO_RECEIVER), UNORM16_NEAREST), 0u, 0u, 0u))
            RTX_STORE_WORDS(
                moments, at, uvec4(packShadowMoments(vec3(value, 0.0, receiver ? 1.0 : 0.0), rounding), 0u, 0u))
        }
        return;
    }

    if (gl_LocalInvocationIndex == 0u)
        RTX_STORE_COUNTED(tiles, ivec2(gl_WorkGroupID.xy), vec4(0.0, reach, 0.0, 0.0))

    // The local mean of the bits, which with one sample a pixel is its variance as well: the
    // horizontal half at every row of the square, a lane a row a workgroup apart, then the vertical
    // half down the column.
    for (uint row = local.y; row < SPAN; row += SHADOW_WORKGROUP)
        gRows[local.x][row] = horizontalNeighbourhood(row, local.x);

    barrier();

    if (!inFrame)
        return;

    // The centre and the two ends first and the taps between after, the order the SDK sums in.
    const uint centre = local.y + REACH;
    vec2 kernel = gRows[local.x][centre] * shadowLocalWeight(0u)
        + (gRows[local.x][centre - REACH] + gRows[local.x][centre + REACH]) * shadowLocalWeight(REACH);
    for (uint i = 1u; i < REACH; ++i)
        kernel += (gRows[local.x][centre - i] + gRows[local.x][centre + i]) * shadowLocalWeight(i);

    vec3 momentsNow = vec3(0.0);
    float variance = SHADOW_NO_RECEIVER;
    float blended = 0.0;

    {
        // Where the pixel receives, the weight of the receivers is at least its own; where it does
        // not, what this comes to is selected away below.
        const float neighbourhood = kernel.x / kernel.y;
        const float current = ((gOpen[square.y] >> square.x) & 1u) != 0u ? 1.0 : 0.0;

        const vec2 seen = imageLoad(surfaceChannel, at).rg;
        const vec3 moved = imageLoad(motion, at).xyz;
        const HistoryFootprint before = historyFootprint(at, moved);
        const HistoryPlane plane = historyPlane(frame, at, seen, moved);

        // The moments at the nearest texel, as the SDK fetches them, and none where that texel is
        // another surface: the SDK's disocclusion.
        const ivec2 nearest = before.mLow + ivec2(greaterThanEqual(before.mAcross, vec2(0.5)));
        const bool held = frame.mReset == 0u && !outsideOf(nearest, extent)
            && heldSurfaceMatches(imageLoad(heldSurface, nearest).rg, nearest, plane);
        const ShadowMoments updated = updatedShadowMoments(
            held ? unpackShadowMoments(imageLoad(momentsBefore, nearest).rg) : vec3(0.0), current);
        variance = updated.mVariance;
        momentsNow = updated.mMoments;

        // The bounds the history is clamped to: half a deviation either side of the local mean.
        const float spatialVariance = max(neighbourhood - neighbourhood * neighbourhood, 0.0);
        const float deviation = sqrt(spatialVariance);
        const float low = neighbourhood - 0.5 * deviation;
        const float high = neighbourhood + 0.5 * deviation;

        // The history bilinear over the taps that are this surface and received, as the
        // accumulator takes its own; the frame's own bit where none is, which is a history of one
        // sample. A texel that received nothing holds no history: its value is the frame's
        // nought, which pulled a terminator's history toward shadow. **Not gathered at all on a
        // reset**, as every other temporal pass leaves it: a chain that keeps no past holds its
        // surfaces in the image the accumulator wrote this frame, which nothing orders this read
        // after.
        vec4 shares = vec4(0.0);
        if (frame.mReset == 0u)
        {
            RTX_HISTORY_SHARES(gathered, before, extent, heldSurface,
                unpackShadowWord(imageLoad(history, historyAt).r).y != SHADOW_NO_RECEIVER, plane)
            shares = gathered;
        }

        float previous = current;
        float sum = 0.0;
        for (int i = 0; i < 4; ++i)
            if (shares[i] > 0.0)
                sum += unpackShadowWord(imageLoad(history, historyTap(before, i)).r).x * shares[i];
        const float weight = historyCovered(shares);
        if (weight > 0.0)
            previous = sum / weight;

        const float clamped = clamp(previous, low, high);

        // A history that stood well off the neighbourhood is worth fewer samples than it counted.
        const float discontinuity = (previous - neighbourhood) / max(0.5 * deviation, 0.001);
        momentsNow.z *= exp(-discontinuity * discontinuity / 20.0);

        // The first sixteen frames of a history know their variance poorly, and say so.
        if (momentsNow.z < 16.0)
        {
            variance = max(variance, spatialVariance);
            variance *= max(16.0 - momentsNow.z, 1.0);
        }

        const float historyWeight = sqrt(max(8.0 - momentsNow.z, 0.0) / 8.0);
        blended = reach < 1.0 ? current : mix(clamped, current, mix(0.05, 1.0, historyWeight));
    }

    // **Selected and not branched around**: every lane runs the history, and one no source lights
    // stores nought and says so. Measured against the branch on the default suite, three alternated
    // rounds: the shadow zone's median 0.236 ms became 0.232 on the ship, and 0.288 became 0.281
    // in the guild. Every store at random, since the first level filters the mean into the history
    // and the next frame's update reads the moments back.
    RTX_STORE_WORDS(reprojected, at,
        uvec4(packShadowWord(receiver ? vec2(blended, variance) : vec2(0.0, SHADOW_NO_RECEIVER), randomWord(rounding)),
            0u, 0u, 0u))
    RTX_STORE_WORDS(moments, at, uvec4(packShadowMoments(receiver ? momentsNow : vec3(0.0), rounding), 0u, 0u))
}
