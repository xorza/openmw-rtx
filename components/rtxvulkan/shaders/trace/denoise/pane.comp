#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The pane filter: what was drawn for the see-through layers in front of the surface,
// `CHANNEL_PANE`, averaged with what was drawn for the same layer on the frames before.
//
// **Over time and not across the screen**, as the glossy filter is. A layer is shaded at the end of
// a path — one occlusion ray, one lamp and one sun ray a frame — so its light is as noisy as a
// bounce's, but a layer is thin: a window's frame, a ghost's sleeve. A spatial filter would have to
// know where a layer ends at every tap, and FSR's accumulation stands behind this at every mode but
// `off`.
//
// **Its own history, reprojected by the nearest layer's own motion and held against the nearest
// layer's own surface**, which the channels the other filters read do not describe: those are the
// surface behind the stack. Demodulated, as the bounce is, so what a history carries across a
// moving window is the light on it and not its texture — and a layer fading in or out moves the
// albedo it is multiplied back by and not its history.
//
// **The glossy filter's rules otherwise**: bilinear over the four texels the motion lands between,
// each only if it is this layer by `heldSurfaceMatches`, and `blendedMean` into the history, with the
// whole of it kept — a layer's light does not turn with the view — beside a fast mean, which
// `historyclamp.comp` holds the slow one to.

#include "shared/accumulate.h"
#include "gbuffer.h"
#include "look.h"
#include "shared/historyclamp.h"
#include "shared/pane.h"
#include "shared/sets.h"

#include "lib/census.glsl"
#include "lib/halfround.glsl"
#include "lib/pixels.glsl"
#include "lib/runningmean.glsl"
#include "lib/sharedexponent.glsl"
#include "lib/surfacematch.glsl"

layout(local_size_x = PANE_WORKGROUP, local_size_y = PANE_WORKGROUP) in;

/// What was drawn for the layers, demodulated. No format, as radiance has none here.
layout(set = SET_PASS, binding = PANE_BIND_PANE) uniform readonly image2D paneChannel;

/// The nearest layer's surface and motion.
layout(set = SET_PASS, binding = PANE_BIND_SURFACE, GBUFFER_SURFACE) uniform readonly image2D paneSurface;
layout(set = SET_PASS, binding = PANE_BIND_MOTION, GBUFFER_MOTION) uniform readonly image2D paneMotion;

/// The layer the history belongs to: the frame before's `CHANNEL_PANE_SURFACE` (`GBuffer::getHeld`).
layout(set = SET_PASS, binding = PANE_BIND_HELD_BEFORE, GBUFFER_SURFACE) uniform readonly image2D heldBefore;

/// The history as `RunningMean` stores it, nought frames where no layer stood: last frame's, and
/// this frame's, whose `rgb` the composite multiplies back by `CHANNEL_PANE_ALBEDO`.
layout(set = SET_PASS, binding = PANE_BIND_MEAN_BEFORE, PANE_MEAN) uniform readonly image2D meanBefore;
layout(set = SET_PASS, binding = PANE_BIND_MEAN, PANE_MEAN) uniform writeonly image2D mean;

/// The fast mean (`HISTORY_CLAMP_FAST`): last frame's as the clamp left it, and this frame's blend,
/// which the clamp reads at every pixel's neighbours.
layout(set = SET_PASS, binding = PANE_BIND_FAST_BEFORE, HISTORY_CLAMP_FAST) uniform readonly uimage2D fastBefore;
layout(set = SET_PASS, binding = PANE_BIND_FAST_BLENDED, HISTORY_CLAMP_FAST) uniform writeonly uimage2D fastBlended;

layout(push_constant, scalar) uniform Push
{
    HistoryConstants frame;
};

void main()
{
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    const uvec2 extent = uvec2(frame.mEyes.mWorld.mWidth, frame.mEyes.mWorld.mHeight);
    if (outsideOf(uvec2(at), extent))
        return;

    const vec3 sampled = imageLoad(paneChannel, at).rgb;
    const vec2 seen = imageLoad(paneSurface, at).xy;
    const vec3 normal = unpackSurfaceNormal(seen.x);

    // A pixel no layer stands in writes its sample, which is nought, and a history of nothing.
    const bool stands = dot(normal, normal) > 0.0;

    RunningMean blended = startedMean(sampled);
    vec3 blendedFast = sampled;
    // A branch, where the tree selects: a layer stands in few pixels and in runs of them, and the
    // rest skip the motion and the history's taps. Measured on the default suite, three alternated
    // rounds: the pass's median 0.030 ms became 0.023 on the ship, and 0.035 became 0.028 in the guild.
    if (stands && frame.mReset == 0u)
    {
        const vec3 moved = imageLoad(paneMotion, at).xyz;
        const HistoryFootprint footprint = historyFootprint(at, moved);
        const HistoryPlane plane = historyPlane(frame, at, seen, moved);

        // A texel no layer stood in holds no history, and would pull the mean toward nought.
        RTX_HISTORY_SHARES(shares, footprint, extent, heldBefore, imageLoad(meanBefore, historyAt).a > 0.0, plane)
        vec4 heldMean = vec4(0.0);
        vec3 heldFast = vec3(0.0);
        for (int i = 0; i < 4; ++i)
            if (shares[i] > 0.0)
            {
                heldMean += imageLoad(meanBefore, historyTap(footprint, i)) * shares[i];
                heldFast += unpackRgb9e5(imageLoad(fastBefore, historyTap(footprint, i)).x) * shares[i];
            }
        const float weight = historyCovered(shares);
        if (weight > 0.0)
        {
            const RunningMean history = runningMeanOf(heldMean, weight);
            blended = blendedMean(sampled, history, 1.0);
            blendedFast = mix(heldFast / weight, sampled, 1.0 / min(history.mFrames + 1.0, ACCUMULATE_FAST_FRAMES));
        }
    }

    uint rounding = seededKey(pixelKey(uvec2(at)) + SEED_PANE_ROUNDING, frame.mFrame);
    RTX_STORE_COUNTED(mean, at, roundedToHalf(stands ? texelOf(blended) : vec4(sampled, 0.0), rounding))
    RTX_STORE_WORDS(fastBlended, at, uvec4(stands ? packRgb9e5(blendedFast) : HISTORY_CLAMP_EMPTY, 0u, 0u, 0u))
}
