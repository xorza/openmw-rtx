#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_ray_tracing : require

// Where each column's view of the air ends, which every froxel of the column is measured against.
//
// A froxel does not know where the ground is, and the pixel that reads it does: the volume is filled before
// anything is traced, so a slice a surface stands inside was sampled on both sides of it, and the pixel would
// read the slice's whole optical depth as though the surface were not there. One ray per column, since
// every froxel of a column samples the column's own ray, and a second along the block's middle, which the
// lamps are integrated along.

#include "camera.h"
#include "scene.h"

#include "lib/bindings.glsl"
#include "lib/census.glsl"
#include "lib/fog.glsl"
#include "lib/traversal.glsl"
#include "lib/variants.glsl"

// A launch over the column grid and not a dispatch, for the reason `fogscatter.rgen` gives: the
// ray below is a ray query, and only a launch answers one the same way every time.
void main()
{
    const ivec2 column = ivec2(gl_LaunchIDEXT.xy);

    // **Traced whatever the air weighs.** The scatter pass fills its froxels' sources for a puff of smoke
    // even where there is no fog to scatter them — `fogscatter.rgen` says why — and a froxel draws its
    // sample short of the surface its column found. An early-out here left this image unwritten, and every
    // froxel of a fog-free frame read itself as behind a surface.

    const Ray ray = fogColumnRay(uvec2(column));
    const vec3 origin = frame.mOrigin + ray.mOffset;

    // The eye's own cone, so a leaf's cutout is decided at the mip the eye sees it at; the column stops where
    // the pixel's ray would, and so is culled the way the eye culls and sees past the panes and fading actors
    // the launch peels (a column that ended at glass held no air over the room behind it). `mFar` on a miss, not
    // the fog's reach: that is what a ray that hit nothing carries to the fog, and the march clamps it. The
    // world's mask applies: what the eye cannot meet does not end its view.
    const Cone cone = coneAt(frame.mEyes.mWorld);
    const RayRule rule = RayRule(worldMask(frame.mRayMask), MEET_WALK_PAST, true);
    const float surface = surfaceWithin(WorldRay(origin, ray.mDirection), 0.0, frame.mFar, cone, rule);

    const Ray middle = fogColumnRayAt(uvec2(column), vec2(0.5));
    const float lampsEnd
        = surfaceWithin(WorldRay(frame.mOrigin + middle.mOffset, middle.mDirection), 0.0, frame.mFar, cone, rule);

    RTX_STORE_COUNTED(fogColumnDepth, column, vec4(surface, lampsEnd, 0.0, 0.0))

    // **And what each moon puts into this column's air**, which is the ray's angle to the moon and
    // nothing along the ray — so it is this pass's to state once, and not every froxel's.
    const MoonTerms terms = fogMoonTermsAlong(ray.mDirection);
    RTX_STORE_COUNTED(fogColumnMoons, ivec3(column, 0), vec4(terms.mMasser, 0.0))
    RTX_STORE_COUNTED(fogColumnMoons, ivec3(column, 1), vec4(terms.mSecunda, 0.0))
}
