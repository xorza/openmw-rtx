#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require

// The spatial reuse's shift rays, once for each pair (Lin, Kettunen, Wyman 2026, *ReSTIR PT
// Enhanced*, §3): for each of a pixel's links, whether the partner's visible point sees the pixel's
// sample, as a bit the resolve reads.
//
// **A pair's two shifts are each other's.** For pixel A to take B's sample, the weights need A's
// sample shifted to B as well as B's to A, and B needs the same two to take A's. Of a shift, only
// whether the point sees the sample needs a ray; the target and the Jacobian come from the
// reservoirs and the visible points, which the resolve reads anyway. So each pixel traces one ray a
// link, toward its own sample from its partner's point, and the resolve reads its own bit for its
// own sample's weight and its partner's for the partner's sample: two rays a pixel where the
// resolve traced four.
//
// **A bit is traced under exactly the conditions the resolve reads it under**: the two points
// alike (`originsAlike`, the same both ways round), the sample worth something, and its shift not
// refused. **And only where the partner's target for the sample is above nought**: both readers
// multiply the bit by that target, so a ray there decides nothing — a sample behind the partner's
// face, or one whose light its diffuse half takes none of.

#include "shared/bouncereuse.h"
#include "scene.h"

#include "lib/bindings.glsl"
#include "lib/bouncepairs.glsl"
#include "lib/bouncereservoir.glsl"
#include "lib/pixels.glsl"

void main()
{
    const uvec2 pixel = gl_LaunchIDEXT.xy;
    const uvec2 extent = uvec2(frame.mEyes.mWorld.mWidth, frame.mEyes.mWorld.mHeight);
    const uint at = pixel.y * frame.mBounceStride + pixel.x;
    const BounceOrigin origin = unpackOrigin(bounceOrigins[at]);
    const BounceReservoir own = unpackBounce(bounceReservoirs[at]);

    uint paired = 0u;
    for (uint link = 0u; link < BOUNCE_NEIGHBOURS; ++link)
    {
        const ivec2 partner = partnerOf(pixel, link);
        if (outsideOf(partner, extent) || !holdsBounce(own))
            continue;

        const BounceOrigin near = unpackOrigin(bounceOrigins[uint(partner.y) * frame.mBounceStride + uint(partner.x)]);
        if (!originsAlike(origin, near) || !(shiftJacobian(own.mSample, origin.mOffset, near.mOffset) > 0.0))
            continue;

        const BounceReach there = reachOf(own.mSample, origin.mOffset, near.mOffset);
        if (!(bounceTarget(near, own.mSample, there) > 0.0))
            continue;

        const bool seen = bounceSeen(near, there);
        paired |= seen ? 1u << link : 0u;
    }

    bouncePaired[at] = paired;
}
