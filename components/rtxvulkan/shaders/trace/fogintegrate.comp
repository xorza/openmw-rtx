#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The air of one column, accumulated front to back, which is what a pixel reads.
//
// A thread to a column: transmittance can only be carried in one order, so the sixty-four slices are a scan,
// and carrying it lets a slice hold the accumulated answer, so a pixel reads one fetch and never a sum.
// Each slice is a sample and the air between two is the line between them (`FogSlice`). The averaged seeing
// is handed on, since a puff of smoke is lit by the same three answers and wants them filtered alike.

#include "scene.h"
#include "shared/fogvolume.h"

#include "lib/bindings.glsl"
#include "lib/census.glsl"
#include "lib/froxel.glsl"
#include "lib/pixels.glsl"

layout(local_size_x = FOG_COLUMN_WORKGROUP, local_size_y = FOG_COLUMN_WORKGROUP) in;

/// Where the `i`th column of the tent stands, as the offset from the middle one.
///
/// **Arithmetic and not a table**, for the reason `atrous.comp`'s `kernelAt` gives.
ivec2 fogTentOffset(int i)
{
    return ivec2(i % 3, i / 3) - 1;
}

/// The `i`th column of the tent around `column`, clamped to the edge of the grid — which is the
/// neighbour the sampler would have read there.
ivec2 fogTentAt(ivec2 column, int i, ivec2 grid)
{
    return clamp(column + fogTentOffset(i), ivec2(0), grid - 1);
}

/// What one froxel holds, with its neighbours across the screen averaged in and every filter applied.
///
/// A grid this coarse cannot carry a shadow's edge or the coverage band on its own: a froxel a column wide
/// paints a step a column wide, and a froxel on a bank's edge holds one draw of a coin averaged over ten
/// frames. Only the neighbours that hold air at this slice are fetched (nine fetches, not four corner taps),
/// by each column rather than through a shared tile: that cost the pass 16 to 29% more at scale 12, where the
/// texture cache already served what the nine columns share. Across the screen and never along the ray.
///
/// The lamps' delivery is an integral over the froxel with no draw, and the ray's answer is filtered over ten
/// frames and nine neighbours; multiplying them here lets each be treated as what it is.
FogSlice sliceAt(ivec2 column, uint slice, ivec2 grid, float surfaces[9], out vec4 averaged)
{
    const float near = froxelNear(slice);

    vec4 point = vec4(0.0);
    vec4 seeing = vec4(0.0);
    float total = 0.0;
    for (int i = 0; i < 9; ++i)
    {
        if (!(surfaces[i] > near))
            continue;

        const ivec2 at = fogTentAt(column, i, grid);
        const float tent = tentWeight(fogTentOffset(i));

        point += tent * texelFetch(fogScatter, ivec3(at, int(slice)), 0);
        seeing += tent * texelFetch(fogSunward, ivec3(at, int(slice)), 0);
        total += tent;
    }

    if (!(total > 0.0))
    {
        point = texelFetch(fogScatter, ivec3(column, int(slice)), 0);
        seeing = texelFetch(fogSunward, ivec3(column, int(slice)), 0);
        total = 1.0;
    }

    point /= total;
    seeing /= total;
    averaged = seeing;

    const vec3 lamps = texelFetch(fogLamps, ivec3(column, int(slice)), 0).xyz;
    const FogPoint held = unpackFogPoint(point, seeing);

    return FogSlice(held.mSource + lamps * (held.mSeeing.mLampsSeen * held.mDensity), held.mDensity,
        held.mSeeing.mSunSource);
}

void main()
{
    const ivec2 grid = ivec2(frame.mFogTraced);
    const ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    if (outsideOf(uvec2(column), uvec2(grid)))
        return;

    // Where this column's view of the air ends, and its neighbours' — `fogdepth.rgen` says why it matters.
    //
    // The one array here that stays one: GLSL copies an array parameter by value, and the other thirteen across
    // this pass and the two denoiser passes were removed with no change in the clock, so nine named scalars
    // would buy nothing either.
    float surfaces[9];
    for (int i = 0; i < 9; ++i)
        surfaces[i] = imageLoad(fogColumnDepth, fogTentAt(column, i, grid)).x;
    const float surface = surfaces[4];

    FogColumn air = FogColumn(vec3(0.0), 1.0, 0.0);
    float behind = 0.0;

    // The slice before the first is the first, and the one after the last is the last — the clamp
    // the sampler applies when a pixel reads the same line at its edges.
    vec4 seeing;
    FogSlice before = sliceAt(column, 0u, grid, surfaces, seeing);
    FogSlice here = before;

    for (uint slice = 0u; slice < FOG_VOLUME_SLICES; ++slice)
    {
        const ivec3 froxel = ivec3(column, int(slice));
        RTX_STORE_COUNTED(fogSeeingTarget, froxel, seeing)

        vec4 seeingNext = seeing;
        const FogSlice next
            = slice + 1u < FOG_VOLUME_SLICES ? sliceAt(column, slice + 1u, grid, surfaces, seeingNext) : here;

        // The line must not bend toward a slice that starts past the surface, which holds no air of this column's:
        // the far half of the slice the surface stands in is flat, the way the sampler is flat past the last texel.
        // Only that half: slices past the surface are integrated as they stand (`fogscatter.rgen` draws them every
        // frame), because a pixel at the surface's edge that sees past it reads them.
        const FogSlice after = froxelNear(slice + 1u) < surface ? next : here;

        // **Two straight pieces, cut at the sample.** A quarter of the way through a slice the line
        // from the previous sample stands three quarters of the way to this one, and that is the
        // mean of the near half; the far half's mean is a quarter of the way to the next.
        const float middle = froxelMiddle(slice);
        const float ahead = froxelFar(slice);

        air = fogThrough(air, fogSliceBetween(before, here, 0.75), middle - behind, frame.mFogExtinction);
        air = fogThrough(air, fogSliceBetween(here, after, 0.25), ahead - middle, frame.mFogExtinction);

        // **The accumulation at the slice's far edge**, which is the depth `fogVolumeAlong` resolves
        // a distance to, and the slice's own sample beside it, which is what that read steps
        // through from the edge before.
        RTX_STORE_COUNTED(fogVolumeAirTarget, froxel, packFogColumn(air))
        RTX_STORE_COUNTED(fogVolumeSunwardTarget, froxel, vec4(packFogColumnSunward(air)))
        RTX_STORE_COUNTED(fogSliceTarget, froxel, packFogSlice(here))
        RTX_STORE_COUNTED(fogSliceSunwardTarget, froxel, vec4(packFogSliceSunward(here)))

        behind = ahead;
        before = here;
        here = next;
        seeing = seeingNext;
    }
}
