#version 460

#extension GL_GOOGLE_include_directive : require

// Last frame's reservoir merged into this frame's candidate: the temporal half of the bounce's
// reuse, a thread a traced pixel, in place over the reservoir the trace wrote.
//
// **The candidate is canonical and last frame's reservoir is shifted to it.** Last frame's sample
// was found from last frame's visible point; reconnected to this one, the solid angle around it
// changes by `shiftJacobian`, and the weights are the defensive pairwise MIS of the two inputs
// (`canonicalWeight`, `neighbourWeight`), each by its confidence. **Not the balance heuristic**,
// which a merge of two could take: with no visibility in the weights, the history's target for the
// candidate counts what the history's point may not see, and the balance hands the history nearly
// all of the weight at a confidence of twenty. Over the corner it carried 27 fireflies where the
// plain bounce has 24, left the walk's error at 0.84 of no reuse's, over the 0.67 this stays under, and kept
// 0.969 of a sunlit bounce's mean. Last frame's reservoir is found
// at the pixel the motion vector names, among the four a bilinear fetch spans, and taken only where
// it is the same surface (`heldSurfaceMatches`): the tree's one rule for a history.
//
// **No visibility ray in the weights.** Whether last frame's point could have found this frame's
// candidate is a question about last frame's geometry, which no structure here keeps; this frame's
// would answer it approximately, and for a still eye the two points are one. The resolve's final
// ray is what stops a sample hidden now.
//
// **Then the boiling filter**: a sample a history carried, worth far more than its workgroup's
// mean, is let go (`BOUNCE_BOILING_LIMIT`).

#include "shared/bouncereuse.h"
#include "gbuffer.h"
#include "scene.h"

#include "lib/bindings.glsl"
#include "lib/bouncereservoir.glsl"
#include "lib/pixels.glsl"
#include "lib/random.glsl"
#include "lib/surfacematch.glsl"

layout(local_size_x = BOUNCE_TEMPORAL_WORKGROUP, local_size_y = BOUNCE_TEMPORAL_WORKGROUP) in;

/// Last frame's reservoir and the visible point it was kept at.
struct Held
{
    BounceReservoir mReservoir;
    BounceOrigin mOrigin;
};

/// Last frame's reservoir at the pixel the motion vector names, or nothing where none of the four
/// a fetch spans is the surface in front of this one. The tap the fetch weighs most, of those
/// that match, so a still eye takes its own pixel's.
///
/// **The nearest and not one drawn by its share**, though rounding loses a reservoir wherever the
/// step nears half a pixel: two pixels take one, and the one beside them starts again. Drawn by the
/// shares, a walk two units a frame over the corner kept the temporal half's error at a third of no
/// reuse where the nearest keeps it at three fifths; but every frame under an upscaler is
/// jittered, so a still eye's pixels took their neighbours' reservoirs at random, neighbours came
/// to share their ancestors, and the denoised guild stood at 0.74 where the nearest leaves 0.68.
Held heldBefore(uvec2 pixel, BounceOrigin origin)
{
    const vec3 moved = imageLoad(motion, ivec2(pixel)).xyz;
    // **At the surface's own point and not the pixel's centre**: a reservoir carries its own origin
    // and holds no mean, so the nearest matching tap is wanted where the jittered ray met the
    // surface, and the jitter rides on the motion.
    const HistoryFootprint before
        = historyFootprint(ivec2(pixel), vec3(moved.xy + frame.mEyes.mWorld.mJitter, moved.z));
    const float away = length(origin.mOffset);
    // The world's frustum for an arm's point too: a reservoir does not say which eye found it, and
    // the two differ by the arms' spread, a share of a tolerance.
    const float tolerance = planeTolerance(frame.mEyes.mWorld, away, origin.mNormal, origin.mOffset / away);

    BounceOrigin kept = noOrigin();
    uint keptAt = 0u;
    float best = 0.0;
    for (int corner = 0; corner < 4; ++corner)
    {
        const ivec2 tap = historyTap(before, corner);
        const float share = historyShare(before, corner);
        if (outsideOf(uvec2(tap), uvec2(frame.mEyes.mWorld.mWidth, frame.mEyes.mWorld.mHeight)) || !(share > best))
            continue;

        const uint at = uint(tap.y) * frame.mBounceStride + uint(tap.x);
        // Carried to this frame's eye, which every offset this pass compares is from: the plane
        // test reads it off the reservoir's own origin, where the filters rebuild it from a distance.
        BounceOrigin was = unpackOrigin(bounceOriginsBefore[at]);
        was.mOffset -= frame.mCameraMotion;
        if (!was.mKept || !samePlane(was.mNormal, was.mOffset, origin.mNormal, origin.mOffset, tolerance))
            continue;

        best = share;
        kept = was;
        keptAt = at;
    }

    // The reservoir read once, of the tap kept: the origins decide, and only one reservoir is used.
    return best > 0.0 ? Held(unpackBounce(bounceHistory[keptAt]), kept) : Held(noBounce(), noOrigin());
}

/// Last frame's reservoir merged into this pixel's candidate, or the candidate alone where last
/// frame left nothing here to merge.
BounceReservoir mergedWithHistory(uvec2 pixel, BounceOrigin origin, BounceReservoir candidate)
{
    const Held held = heldBefore(pixel, origin);
    BounceReservoir before = held.mReservoir;
    before.mConfidence = min(before.mConfidence, BOUNCE_CONFIDENCE_CAP);
    ++before.mAge;
    // **A history that kept nothing is still merged**, by its confidence: it stands for candidates
    // that found no light. Passed over, the candidate would take the whole weight wherever the
    // history came up empty and its share wherever it did not, which over the frames is brighter
    // than the bounce.
    if (before.mConfidence == 0u || before.mAge > BOUNCE_AGE_CAP)
        return candidate;

    // The candidate at this point, and at last frame's: shifted there and back, `p̂←j`.
    const BounceReach candidateHere = reachOf(candidate.mSample, origin.mOffset, origin.mOffset);
    const float candidateTarget = bounceTarget(origin, candidate.mSample, candidateHere);
    const BounceReach candidateThereReach = reachOf(candidate.mSample, origin.mOffset, held.mOrigin.mOffset);
    const float candidateThere = bounceTarget(held.mOrigin, candidate.mSample, candidateThereReach)
        * shiftJacobian(candidate.mSample, origin.mOffset, held.mOrigin.mOffset);

    // Last frame's sample at its own point, over the Jacobian of its shift to this one, and here.
    const float jacobian = shiftJacobian(before.mSample, held.mOrigin.mOffset, origin.mOffset);
    const BounceReach beforeHere = reachOf(before.mSample, held.mOrigin.mOffset, origin.mOffset);
    const float beforeTarget = bounceTarget(origin, before.mSample, beforeHere);
    const float beforeThere = jacobian > 0.0
        ? bounceTarget(held.mOrigin, before.mSample,
              reachOf(before.mSample, held.mOrigin.mOffset, held.mOrigin.mOffset))
            / jacobian
        : 0.0;

    const float total = float(candidate.mConfidence + before.mConfidence);
    const float candidateMis = canonicalWeight(candidateTarget, candidate.mConfidence, total,
        vec4(candidateThere, 0.0, 0.0, 0.0), vec4(float(before.mConfidence), 0.0, 0.0, 0.0));
    const float beforeMis
        = neighbourWeight(beforeThere, beforeTarget, before.mConfidence, total, candidate.mConfidence);

    // Last frame's sample from this frame's point: its offset is this point's from here on.
    BounceSample shifted = before.mSample;
    shifted.mOffset = shifted.mSky ? shifted.mOffset : beforeHere.mTowards * beforeHere.mDistance;

    uint draws = randomSeed(pixelKey(pixel) + SEED_BOUNCE_TEMPORAL);
    BounceMerge merge = startMerge();
    offer(merge, candidate.mSample, candidateMis * candidateTarget * candidate.mWeight, candidateTarget,
        candidate.mConfidence, 0u, randomNext(draws));
    offer(merge, shifted, beforeMis * beforeTarget * before.mWeight * jacobian, beforeTarget, before.mConfidence,
        before.mAge, randomNext(draws));

    return finishMerge(merge);
}

const uint sGroupSize = BOUNCE_TEMPORAL_WORKGROUP * BOUNCE_TEMPORAL_WORKGROUP;
shared float sWorth[sGroupSize];
shared uint sHolding[sGroupSize];

/// The mean of what the group's reservoirs that hold something are worth, the same at every thread.
///
/// **A tree in shared memory, in a fixed order, and not `subgroupAdd`**, whose order is the
/// driver's: the sum is the build's arithmetic, as every other float the frame keeps is.
float groupMeanWorth(float worth)
{
    const uint lane = gl_LocalInvocationIndex;
    sWorth[lane] = worth;
    sHolding[lane] = worth > 0.0 ? 1u : 0u;
    barrier();
    for (uint span = sGroupSize / 2u; span > 0u; span /= 2u)
    {
        if (lane < span)
        {
            sWorth[lane] += sWorth[lane + span];
            sHolding[lane] += sHolding[lane + span];
        }
        barrier();
    }
    return sWorth[0] / float(max(sHolding[0], 1u));
}

void main()
{
    // **No thread leaves before the group's mean is taken**: a thread outside the frame or with no
    // reservoir stands for nothing in it, and the barriers wait for every thread.
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const bool inside = !outsideOf(pixel, uvec2(frame.mEyes.mWorld.mWidth, frame.mEyes.mWorld.mHeight));
    const uint at = inside ? pixel.y * frame.mBounceStride + pixel.x : 0u;
    const BounceOrigin origin = inside ? unpackOrigin(bounceOrigins[at]) : noOrigin();

    const BounceReservoir candidate = origin.mKept ? unpackBounce(bounceReservoirs[at]) : noBounce();
    const bool merges = origin.mKept && frame.mBounceHistory != 0u;
    const BounceReservoir kept = merges ? mergedWithHistory(pixel, origin, candidate) : candidate;

    // What the pixel's estimate is worth, `p̂ W`: the bounce's luminance it shows. RTXDI weighs the
    // light alone, without the surface's share of it; the estimate is what a blotch is made of.
    const float worth = holdsBounce(kept)
        ? bounceTarget(origin, kept.mSample, reachOf(kept.mSample, origin.mOffset, origin.mOffset)) * kept.mWeight
        : 0.0;
    const bool boils = worth > groupMeanWorth(worth) * BOUNCE_BOILING_LIMIT && kept.mAge > 0u;

    if (merges || boils)
        bounceReservoirs[at] = packBounce(boils ? noBounce() : kept);
}
