#version 460

#extension GL_GOOGLE_include_directive : require

// The three fields transformed along the columns — the second half of the inverse transform — and
// unpacked into the textures a surface is read out of, a column a workgroup.
//
// **Six real fields arrive in three complex ones**, one in each real part and one in each imaginary
// part, which is what `waverows.comp` packed them as. What leaves here is what `sea.glsl` samples:
// the elevation and its two slopes, the three curvatures the caustics differentiate, and the second
// moments a mip chain turns into what a ray cone could not resolve.
//
// **Unpacked where it is transformed**: a column of the three fields is the column of texels they
// make, so the answer goes from shared memory to the textures, and never to memory and back.

#include "sets.h"
#include "wave.h"

#include "lib/wavelines.glsl"
#include "lib/wavetile.glsl"

layout(local_size_x = WAVE_WORKGROUP) in;

/// The three fields as the rows left them.
layout(set = SET_PASS, binding = WAVE_COLUMNS_BIND_FIELD, scalar) readonly buffer Field
{
    vec2 field[];
};

layout(set = SET_PASS, binding = WAVE_COLUMNS_BIND_SURFACE, WAVE_TILE_FORMAT) uniform writeonly image2D surface;

layout(set = SET_PASS, binding = WAVE_COLUMNS_BIND_CURVATURE, WAVE_TILE_FORMAT) uniform writeonly image2D curvature;

layout(push_constant, scalar) uniform Push
{
    WaveComposeConstants frame;
};

void main()
{
    const uint thread = gl_LocalInvocationID.x;
    const uint column = gl_WorkGroupID.x;
    const uint count = frame.mCount;
    const uint stages = findMSB(count);
    const uint grid = count * count;

    for (uint row = thread; row < count; row += WAVE_WORKGROUP)
    {
        const uint at = row * count + column;
        const uint slot = reversedSlot(row, stages);
        gLines[0][slot] = field[at];
        gLines[1][slot] = field[grid + at];
        gLines[2][slot] = field[2u * grid + at];
    }

    barrier();

    transformLines(count);

    for (uint row = thread; row < count; row += WAVE_WORKGROUP)
    {
        // **The centre of the grid is the wave of no length**, which is where a spectrum belongs and
        // is not where a transform expects it: shifting the input by half a grid multiplies the
        // output by `exp(i pi (x + y))`, so undoing it is a sign. Written this way rather than as an
        // index swap because the swap would have to happen in three buffers and this happens once.
        //
        // **And nothing else scales.** The transform is unscaled and `makeWaveCascades` states the
        // surface's variance as twice the sum of its own amplitudes, which is what the transform of
        // a conjugate pair delivers — so the two conventions meet with no constant between them.
        const float shift = ((column + row) & 1u) == 0u ? 1.0 : -1.0;

        const vec2 first = gLines[0][row];
        const vec2 second = gLines[1][row];
        const vec2 third = gLines[2][row];

        const float height = shift * first.x;
        const vec2 slope = shift * vec2(first.y, second.x);
        const vec3 curve = shift * vec3(second.y, third.x, third.y);

        const ivec2 texel = ivec2(column, row);
        imageStore(surface, texel, waveSurfaceTexel(height, slope));
        imageStore(curvature, texel, waveCurvatureTexel(curve));
    }
}
