#version 460

#extension GL_GOOGLE_include_directive : require

// The three fields transformed along the columns — the second half of the inverse transform — and unpacked
// into the textures a surface is read out of, a column a workgroup. Six real fields arrive in three complex
// ones (`waverows.comp` packed them), and are unpacked where they are transformed, from shared memory
// straight to the textures.

#include "shared/sets.h"
#include "shared/wavetransform.h"
#include "wave.h"

#include "lib/census.glsl"
#include "lib/wavelines.glsl"
#include "lib/wavetile.glsl"

layout(local_size_x = WAVE_WORKGROUP) in;

/// The three fields as the rows left them.
layout(set = SET_PASS, binding = WAVE_COLUMNS_BIND_FIELD, scalar) readonly buffer Field
{
    vec2 field[];
};

/// The two slopes, their own second moment, and the elevation squared. Both slope moments share one image so
/// reading them is one fetch (LEAN mapping wants `E[|s|^2] - |E[s]|^2` off a level of a chain). The elevation
/// squared rides in the last channel, where the coarsest level makes it the sea's own variance — the amplitude
/// the whole spectrum is normalised to, which a test holds the transform's scale to.
layout(set = SET_PASS, binding = WAVE_COLUMNS_BIND_SURFACE, WAVE_TILE_FORMAT) uniform writeonly image2D surface;

/// The three curvatures, which is what the caustic differentiates the height field twice for.
layout(set = SET_PASS, binding = WAVE_COLUMNS_BIND_CURVATURE, WAVE_TILE_FORMAT) uniform writeonly image2D curvature;

layout(push_constant, scalar) uniform Push
{
    WaveColumnsConstants frame;
};

void main()
{
    const uint thread = gl_LocalInvocationID.x;
    const uint column = gl_WorkGroupID.x;
    const uint count = frame.mCount;
    const uint stages = findMSB(count);
    const uint grid = count * count;

    for (uint row = thread; row < count; row += WAVE_WORKGROUP)
    {
        const uint at = row * count + column;
        const uint slot = reversedSlot(row, stages);
        gLines[0][slot] = field[at];
        gLines[1][slot] = field[grid + at];
        gLines[2][slot] = field[2u * grid + at];
    }

    barrier();

    transformLines(count);

    for (uint row = thread; row < count; row += WAVE_WORKGROUP)
    {
        // The centre of the grid is the wave of no length, where a spectrum belongs and a transform does not expect
        // it: shifting the input by half a grid multiplies the output by `exp(i pi (x + y))`, so undoing it is a sign.
        // Nothing else scales: the transform is unscaled and `makeWaveCascades` states the surface's variance as
        // twice the sum of its own amplitudes, which is what a conjugate pair's transform delivers.
        const float shift = ((column + row) & 1u) == 0u ? 1.0 : -1.0;

        const vec2 first = gLines[0][row];
        const vec2 second = gLines[1][row];
        const vec2 third = gLines[2][row];

        const float height = shift * first.x;
        const vec2 slope = shift * vec2(first.y, second.x);
        const vec3 curve = shift * vec3(second.y, third.x, third.y);

        const ivec2 texel = ivec2(column, row);
        RTX_STORE_COUNTED(surface, texel, waveSurfaceTexel(height, slope))
        RTX_STORE_COUNTED(curvature, texel, waveCurvatureTexel(curve))
    }
}
