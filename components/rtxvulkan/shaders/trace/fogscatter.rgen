#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_ray_tracing : require

// What the weather's air holds at one froxel, and what lights it there.
//
// A ray generation launch and not a compute dispatch: what a ray query answers is only repeatable inside one.
// With another process on the card the same froxel's sun and ambient rays answered differently from run to
// run on identical inputs, only in this pass and `fogdepth.rgen`; a compute dispatch is preempted
// mid-instruction with a traversal in flight, and a launch is not.
//
// A thread to a froxel: this pass computes the properties of a point, `fogintegrate.comp` carries the
// transmittance down the column. Every sample is jittered inside its froxel and averaged with where it stood
// last frame (`fogWasScatter`, `fogWasSunward`), without which the grid draws a column-wide staircase across
// every shadow edge. What the lamps deliver is an exact integral and is not averaged, so a flickering lantern
// flickers in the air on the frame it does on the wall.
//
// Nothing behind a surface is a sample of the air (`fogdepth.rgen`), but a froxel wholly past the surface is
// drawn over its whole slice every frame: pixels beside the surface read it (`fogintegrate.comp`), and a kept
// history would lay the light of an old frame round every silhouette.

#include "camera.h"
#include "look.h"
#include "scene.h"
#include "sky.h"

#include "lib/bindings.glsl"
#include "lib/census.glsl"
#include "lib/counts.glsl"
#include "lib/fog.glsl"
#include "lib/froxel.glsl"
#include "lib/halfround.glsl"
#include "lib/lights.glsl"
#include "lib/random.glsl"
#include "lib/reproject.glsl"
#include "lib/shading.glsl"
#include "lib/traversal.glsl"
#include "lib/variants.glsl"

/// How far the blue-noise tile is turned between one slice and the next. The tile has no third axis, so two
/// froxels behind each other would read one texel and jitter in step; a shift moves which froxel holds which
/// number and keeps the spectrum, and two odd steps coprime with the tile's width give every slice its place.
const uvec2 FOG_SLICE_TURN = uvec2(13u, 7u);

/// Where a point `fromEye` in front of this eye stood in the previous frame's grid, or a coordinate
/// outside it where there is no answer.
vec3 fogVolumeWas(vec3 fromEye)
{
    const vec3 was = fromEye + frame.mCameraMotion;

    const PreviousScreen screen = previousScreen(was);
    if (!screen.mFound)
        return vec3(-1.0);

    const vec2 at = fogVolumeAcross(screen.mAt, frame.mFogColumns);

    // A slice holds what its own jittered point read, so its texel centre is the slice's middle
    // and a distance reads straight off the curve with no half-texel shift — which the
    // *integrated* volume does need, because there a slice holds its far edge.
    return vec3(at, fogDepthInverse(length(was)));
}

void main()
{
    const ivec3 froxel = ivec3(gl_LaunchIDEXT);

    const ivec2 column = froxel.xy;
    const uint slice = uint(froxel.z);

    // No air is still a frame with light in it: with the extinction at nought every density is nought, but the
    // sources a froxel holds are what a puff of smoke is lit by, so the rays are cast whatever the air weighs.

    // **Two draws, and they turn at different rates on purpose.** `fogColumnRay` moves the column's ray
    // inside its own block of pixels, and that draw is the column's for every slice of it, so the froxels
    // of a column are stretches of one ray and the lamp integral along them is an integral. This one moves
    // the sample inside its own slice, and is the froxel's alone.
    const float alongJitter = randomAt(uvec2(column) + FOG_SLICE_TURN * slice, STREAM_FOG_ALONG);

    const Ray ray = fogColumnRay(uvec2(column));
    const vec3 origin = frame.mOrigin + ray.mOffset;
    const vec3 direction = ray.mDirection;

    // The block's own middle is the ray the lamps are integrated along. What a lamp delivers is smooth, so it
    // wants no jitter and no filter (the trace's trilinear read across columns carries it); along the jittered ray
    // it would move with the inverse square every frame, unaveraged, and a steady lantern's glow would boil.
    const Ray middle = fogColumnRayAt(uvec2(column), vec2(0.5));
    const vec3 fromMiddle = frame.mOrigin + middle.mOffset;

    // **The boundaries are fixed and only the sample inside them moves.** The stride is what the
    // integrate pass takes the transmittance over, so a jittered boundary would be a different
    // integral every frame rather than a different estimate of one.
    const float behind = froxelNear(slice);
    const float ahead = froxelFar(slice);

    // **Where this column's view of the air ends**, which `fogdepth.rgen` traced along this same ray, and
    // so where this froxel's air ends: at the surface if that stands inside it, and at its own far edge
    // otherwise — a froxel that starts past the surface included, for the reason the top of this file
    // gives.
    const vec2 surfaces = imageLoad(fogColumnDepth, column).xy;
    const float clear = surfaces.x > behind ? min(ahead, surfaces.x) : ahead;

    // The same rule along the middle ray, which the lamps' stretch ends by: `fogdepth.rgen` says why.
    const float lampsClear = surfaces.y > behind ? min(ahead, surfaces.y) : ahead;

    // **Drawn inside the air the froxel holds and not inside the froxel**, so a froxel the ground stands
    // inside is a draw of its air on every frame rather than on the frames the draw happened to land short
    // of the ground — which for a froxel the surface barely enters was one frame in twenty, and left it
    // holding its first draw for as long as the eye stood still.
    const float along = behind + alongJitter * (clear - behind);
    const vec3 position = origin + direction * along;

    // The field's level from where the sample stands and not from the slice's own stride, which is
    // the same number at the slice's middle and a different one everywhere else in it.
    const float density = fogDensityAt(position, froxelStrideAt(along));

    // The froxel's own middle is what reprojects, not the point drawn inside it: the history holds this froxel's
    // running average, so read at the sample the fetch would land up to half a texel off its centre and blur the
    // grid against itself.
    const vec3 was = fogVolumeWas(middle.mDirection * froxelMiddle(slice));
    const bool reprojected = all(greaterThanEqual(was, vec3(0.0))) && all(lessThanEqual(was, vec3(1.0)));
    const vec4 wasScatter = reprojected ? textureLod(fogWasScatter, was, 0.0) : vec4(0.0);
    const vec4 wasSunward = reprojected ? textureLod(fogWasSunward, was, 0.0) : vec4(0.0);

    // Every lamp reaching this froxel, integrated over the air it holds, and one of them traced to: the sum is
    // the mean irradiance over the stretch and carries no draw (`lampsInAir` says why the single ray is unbiased).
    // The ray leaves from the jittered point, so a shadow's edge is a gradient across frames, not a column-wide
    // step. Over the stretch short of the surface, not the whole slice.
    //
    // Every froxel asks every question, a clear one too (a third are clear, below `FOG_CLEARING`): a froxel that
    // stored an answer only on frames it holds air would run two filters, with a bias that grows with depth and
    // is drawn as the grid's own shells.
    const uint key = froxelKey(uvec2(column), slice);
    uint lampState = randomSeed(key + SEED_LAMPS_FOG);

    // **The sky's draws first, at a fixed place in the sequence**: the ray's pair for the sun, the ray's
    // pair for the moon, and the moon's pick.
    const vec2 sunDraw = vec2(randomNext(lampState), randomNext(lampState));
    const vec2 moonDraw = vec2(randomNext(lampState), randomNext(lampState));
    const float moonPick = randomNext(lampState);

    Reservoir lamps = noLamps();
    float lampPhase;
    const vec3 lampScatter
        = lampsInAir(lamps, lampState, fromMiddle, middle.mDirection, behind, lampsClear, lampPhase)
        / (lampsClear - behind);

    // What a lamp is worth and where to ask whether it is seen are two questions: the froxel weighs its lamps
    // over its whole stretch, then asks whether the froxel is shadowed from a point drawn anywhere inside, which
    // over frames walks the froxel, so a shadow's edge lands between two froxels as something the filter averages.
    lamps.mFrom = position;

    const MoonTerms terms = MoonTerms(
        imageLoad(fogColumnMoons, ivec3(column, 0)).xyz, imageLoad(fogColumnMoons, ivec3(column, 1)).xyz);

    const FogSources sources = fogSourcesFrom(terms, moonPick);

    // **Nought where no lamp reaches.** `lampVisible` is asked only of a reservoir that holds a lamp
    // (`lampAsk`), and what an empty one stores is read by the neighbours the integrate pass averages over
    // — a one there handed full sight of a lamp to the froxel beside it, and a lantern behind a lid lit the
    // air in front of it after all.
    const float lampsSeen
        = lamps.mWeight > 0.0 ? lampVisible(lamps, vec3(0.0), vec2(randomNext(lampState), randomNext(lampState))) : 0.0;

    // The sun's ray whenever there is a sun, not only where the air's own shaft is worth it: a puff in the same
    // froxel is lit by the sun whatever way the eye looks (`puffLight`), and a shadow it does not have is a
    // splash under a canton lip lit as though in the open. `skyVisible` draws the ray across the disc, so the air
    // in a shadow is as dark as the ground in it. One path and not two: skipping both rays in a frame with no puff
    // would cost a flag, a second history channel and a second way of forming the beam, for little.
    float visible = 1.0;
    float lunar = 1.0;
    if (sources.mSunlit)
        visible = skyVisible(skySourceAt(SKY_SOURCE_SUN), position, vec3(0.0), sunDraw);
    if (sources.mMoonlit)
        lunar = skyVisible(sources.mDrawnSky, position, vec3(0.0), moonDraw);

    // The ambient's, which the air never asked and a puff does: the air scatters the fog colour unshadowed, a
    // puff is lit by the frame's ambient as a surface is, over the whole sphere (`ambientReaching`). Only in a
    // frame a puff is lit in, `PUFFS_LIT`.
    const float ambientSeen = (frame.mPuffsInFrame & PUFFS_LIT) != 0u
        ? ambientReaching(position, vec3(0.0), vec3(0.0), 0.0, 0.0, key + SEED_AMBIENT_FOG)
        : 1.0;

    // Whatever the moons deliver, whether or not they were worth a ray: `mMoonlit` gates the shadow and nothing
    // else, since gating the energy with it stepped both moons out of the frame when their share crossed
    // `FOG_SHAFT_FLOOR`. `lunar` stands at one where no ray was cast, so the light arrives unshadowed.
    const vec3 moons = HAS_MOONS ? moonsInAir(position, sources, lunar) : vec3(0.0);

    // Everything below is a property of this point and of nothing along the ray, which is what lets it be
    // reprojected and averaged; the transmittance is the integrate pass's.
    //
    // The air scatters the weather's own fog colour, Morrowind's record of what its air looks like per weather and
    // hour, not a mean of the sky: a number the game states beats one derived here. Stored times the density, as
    // the sun's transport is below (`FogSlice`): what the history and the tent average is what the integrate pass
    // integrates.
    vec3 source = density * (frame.mFogColour + moons);
    float held = density;

    // **The sun without its irradiance and without its phase**, which is the whole of what the second image
    // is for: both are functions of the direction alone, so they factor out of the integral exactly and the
    // trace puts them back at the pixel's own angle rather than the column's.
    float transport = sources.mSunlit ? sunInAir(position, visible) : 0.0;
    float sunSource = density * transport;

    // **The lamps' seeing and the ambient's ride beside the sun's transport**, because the three are
    // filtered alike and for one reason: each is what a ray found, nought or one at an edge the grid cannot
    // resolve, and each wants its neighbours averaged in.
    float seen = lampsSeen;
    float ambient = ambientSeen;

    if (reprojected)
    {
        const FogPoint was = unpackFogPoint(wasScatter, wasSunward);
        source = mix(source, was.mSource, FOG_VOLUME_HISTORY);
        held = mix(held, was.mDensity, FOG_VOLUME_HISTORY);
        transport = mix(transport, was.mSeeing.mTransport, FOG_VOLUME_HISTORY);
        sunSource = mix(sunSource, was.mSeeing.mSunSource, FOG_VOLUME_HISTORY);
        seen = mix(seen, was.mSeeing.mLampsSeen, FOG_VOLUME_HISTORY);
        ambient = mix(ambient, was.mSeeing.mAmbientSeen, FOG_VOLUME_HISTORY);
    }

    // Rounded at random into the halves they are kept in, each by a sequence of its own:
    // `FOG_HISTORY_FORMAT` says why.
    const FogPoint point = FogPoint(source, held, FogSeeing(transport, seen, ambient, sunSource));
    const vec4 scatter = packFogScatter(point);
    const vec4 sunward = packFogSeeing(point.mSeeing);
    uint scatterRounding = randomSeed(key + SEED_FOG_SCATTER_ROUNDING);
    uint sunwardRounding = randomSeed(key + SEED_FOG_SUNWARD_ROUNDING);
    RTX_STORE_COUNTED(fogScatterTarget, froxel,
        FOG_HISTORY_ROUNDED_AT_RANDOM ? roundedToHalf(scatter, scatterRounding) : scatter)
    RTX_STORE_COUNTED(fogSunwardTarget, froxel,
        FOG_HISTORY_ROUNDED_AT_RANDOM ? roundedToHalf(sunward, sunwardRounding) : sunward)
    RTX_STORE_COUNTED(fogLampsTarget, froxel, vec4(lampScatter, lampPhase))
}
