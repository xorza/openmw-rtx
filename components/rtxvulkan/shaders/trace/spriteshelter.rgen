#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_ray_tracing : require

// Which of the falling sprites stand under a roof, and the roof keeps them off.
//
// A ray where the rasterizer had a depth map: `PrecipitationOccluder` draws statics and objects from above
// the rain box and discards drops behind it, and one ray straight up from each sprite asks the same question
// of the geometry itself. The mask is the map's (`Mask_Object | Mask_Static`, `shelterMask`), so an actor
// keeps no rain off; a candidate is asked the question the eye asks, the content's own alpha threshold
// rather than the map's half.
//
// One launch over the sprite list before the shade and the bin, so a sheltered drop neither counts as a layer
// over another nor is listed for a tile. A launch and not a dispatch, for the reason `RtxSourceTreeTest` gives.

#include "scene.h"

#include "lib/bindings.glsl"
#include "lib/spritelist.glsl"
#include "lib/traversal.glsl"

const vec3 UP = vec3(0.0, 0.0, 1.0);

void main()
{
    const uint index = gl_LaunchIDEXT.x;
    WrittenSprites sprites = WrittenSprites(frame.mTables.mSprites);
    const GpuSprite sprite = sprites.at[index];

    if ((emitterAt(sprite.mEmitter).mFlags & EMITTER_FALLS) == 0u)
        return;

    // To the top of the box the map was drawn from, and nothing for a drop already above it: a
    // ray whose end is behind its beginning is undefined, as `passageAsk` says.
    const float limit = frame.mOrigin.z + frame.mShelterHeight - sprite.mPosition.z;
    if (limit <= 0.0)
        return;

    // The ray stops at the first surface and sees through none.
    const SceneAnswer met = queryScene(SceneQuery(sprite.mPosition, 0.0, UP, limit, gl_RayFlagsTerminateOnFirstHitEXT,
        shelterMask(frame.mRayMask), MEET_AS_SOLID, 0u, 0.0, 0.0, 0u, 0u));
    if (met.mCommitted == 0u)
        return;

    sprites.at[index].mRadius = 0.0;
    sprites.at[index].mAlpha = 0.0;
}
