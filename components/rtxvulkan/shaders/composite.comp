#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

// The last pass: the trace's channels back into one picture.
//
// **Separate because a filter needs every pixel before any pixel is finished.** The trace writes
// indirect light with the albedo divided out; something between here and there blurs it, which it
// can only do once the whole image exists. Multiplying the albedo back afterwards is what returns
// texture detail a blur would otherwise have smeared — the mortar between bricks is in the albedo,
// and the light falling on the wall is not.

#include "composite.h"

layout(local_size_x = COMPOSITE_WORKGROUP, local_size_y = COMPOSITE_WORKGROUP) in;

/// Everything already resolved: direct light, emission, the sky, water, and the fog over all of it.
layout(set = 0, binding = 0, rgba32f) uniform readonly image2D direct;

/// One bounce, with the albedo divided out — the only channel a filter is allowed to touch.
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D indirect;

/// What to put back: the albedo, times whatever the water and the air took off the way to the eye.
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D modulate;

/// The running sum, when `mAccumulate` asks for one.
layout(set = 0, binding = 3, rgba32f) uniform image2D history;

/// The picture, as bytes a display understands.
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D target;

layout(push_constant, scalar) uniform Push
{
    CompositeConstants frame;
};

/// The sRGB transfer curve, linear radiance to what a display expects of a byte.
///
/// The piecewise form and not the 2.2 approximation. The two differ by several per cent in the
/// darks, which is where a bounce puts most of what it has to say.
vec3 encodeSrgb(vec3 linear)
{
    const bvec3 small = lessThanEqual(linear, vec3(0.0031308));
    const vec3 low = linear * 12.92;
    const vec3 high = 1.055 * pow(max(linear, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return clamp(mix(high, low, vec3(small)), 0.0, 1.0);
}

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= frame.mWidth || pixel.y >= frame.mHeight)
        return;

    const ivec2 at = ivec2(pixel);
    vec3 colour = imageLoad(direct, at).rgb + imageLoad(modulate, at).rgb * imageLoad(indirect, at).rgb;

    // In linear and before the curve. Encoding first would add up rounded numbers, and clip every
    // sample past the display's range to the same value — losing exactly the fireflies a reference
    // is wanted to measure.
    if (frame.mAccumulate > 0u)
    {
        const vec3 total = frame.mAccumulate > 1u ? imageLoad(history, at).rgb + colour : colour;
        imageStore(history, at, vec4(total, 1.0));
        colour = total / float(frame.mAccumulate);
    }

    imageStore(target, at, vec4(encodeSrgb(colour), 1.0));
}
