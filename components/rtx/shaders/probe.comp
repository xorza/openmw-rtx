#version 460

// The smallest shader that proves the toolchain: compiled by glslc, validated by spirv-val, loaded
// as a module, and — once there is a pipeline to run it on — dispatchable into a buffer a readback
// can check against a number computed on the CPU.

layout(local_size_x = 64) in;

layout(std430, binding = 0) writeonly buffer Output
{
    uint values[];
};

void main()
{
    values[gl_GlobalInvocationID.x] = gl_GlobalInvocationID.x;
}
