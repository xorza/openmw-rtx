#!/usr/bin/env python3
"""The one way in, on the desk and in CI: `omw [flavour] <verb> [args]`, `omw help` for the rest.
The driver is `tools/omw`, standard library only; `omw.cmd` beside this starts it from cmd and
PowerShell, where `python3` names nothing."""

import sys
from pathlib import Path

# Before anything a later Python reads, so an older one says why and not where it tripped.
if sys.version_info < (3, 11):  # noqa: UP036
    sys.exit(f"omw: Python 3.11 or later, and this is {sys.version.split()[0]}")

sys.path.insert(0, str(Path(__file__).resolve().parent / "tools"))

from omw.main import main

sys.exit(main(sys.argv[1:]))
