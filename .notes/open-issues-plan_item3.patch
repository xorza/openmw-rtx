index 0000000000..49823b1bbe
--- /dev/null
+++ b/apps/components_tests/rtxvulkan/present/presenter.cpp
@@ -0,0 +1,114 @@
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+#include <SDL3/SDL_error.h>
+#include <SDL3/SDL_hints.h>
+#include <SDL3/SDL_init.h>
+#include <SDL3/SDL_video.h>
+#include <volk.h>
+
+#include <apps/components_tests/rtx/support/death.hpp>
+#include <apps/components_tests/rtx/support/device/harness.hpp>
+#include <components/rtx/renderer/renderer.hpp>
+#include <components/rtxvulkan/device/device.hpp>
+#include <components/rtxvulkan/device/instance.hpp>
+#include <components/rtxvulkan/device/physicaldevice.hpp>
+#include <components/rtxvulkan/device/validation.hpp>
+#include <components/rtxvulkan/present/presenter.hpp>
+#include <components/rtxvulkan/present/presenttarget.hpp>
+#include <components/rtxvulkan/present/surface.hpp>
+#include <components/sdlutil/vsyncmode.hpp>
+
+namespace Rtx
+{
+    namespace
+    {
+        /// SDL's video on its offscreen driver, whose window takes a surface through
+        /// `VK_EXT_headless_surface`: a window with a swapchain that no compositor shows.
+        struct OffscreenVideo
+        {
+            OffscreenVideo()
+            {
+                SDL_SetHint(SDL_HINT_VIDEO_DRIVER, "offscreen");
+                mStarted = SDL_InitSubSystem(SDL_INIT_VIDEO);
+            }
+
+            ~OffscreenVideo()
+            {
+                if (mWindow != nullptr)
+                    SDL_DestroyWindow(mWindow);
+                if (mStarted)
+                    SDL_QuitSubSystem(SDL_INIT_VIDEO);
+            }
+
+            OffscreenVideo(const OffscreenVideo&) = delete;
+            OffscreenVideo& operator=(const OffscreenVideo&) = delete;
+
+            bool mStarted = false;
+            SDL_Window* mWindow = nullptr;
+        };
+
+        /// **A lost surface is made again from the window, and the frames go on**: a present after
+        /// the rebuild leaves nothing to remake, and a loss after it is a loss like the first. One
+        /// lost again before any present showed on the new surface ends the process, where a
+        /// rebuild each frame would hold the game in a stall.
+        TEST(RtxPresenterTest, aLostSurfaceIsMadeAgainAndTheFramesGoOn)
+        {
+            OffscreenVideo video;
+            ASSERT_TRUE(video.mStarted) << SDL_GetError();
+            video.mWindow = SDL_CreateWindow("presenter", 64, 32, SDL_WINDOW_VULKAN | SDL_WINDOW_HIDDEN);
+            ASSERT_NE(video.mWindow, nullptr) << SDL_GetError();
+
+            const std::vector<const char*> extensions = Surface::getInstanceExtensions();
+            const Instance instance(
+                ValidationOptions{ .mLevel = ValidationLevel::Sync, .mAbortOnError = false }, extensions);
+            Surface surface(instance, video.mWindow);
+            Device device(instance,
+                PhysicalDevice::select(instance.getHandle(),
+                    [&](VkPhysicalDevice physical, std::uint32_t family) {
+                        return surface.supports(physical, family);
+                    }),
+                Testing::getCensusShaders(), Testing::getPipelineCacheSpec());
+
+            const VkExtent2D extent{ 64, 32 };
+            PresentTarget target;
+            target.resize(device, extent.width, extent.height);
+            Presenter presenter(device, surface, video.mWindow, SDLUtil::VSyncMode::Disabled);
+            const auto show = [&] { presenter.present(target.getShown(), [](VkCommandBuffer) {}); };
+
+            show();
+            show();
+            EXPECT_FALSE(presenter.wantsResize(extent));
+
+            for (int loss = 0; loss < 2; ++loss)
+            {
+                presenter.surfaceLost();
+                EXPECT_TRUE(presenter.wantsResize(extent)) << "a lost surface asks for its rebuild";
+                show();
+                EXPECT_TRUE(presenter.wantsResize(extent)) << "a frame took nothing from a lost surface";
+
+                presenter.rebuild(extent);
+                EXPECT_FALSE(presenter.wantsResize(extent));
+                show();
+                show();
+                EXPECT_FALSE(presenter.wantsResize(extent)) << "a present on the new surface was refused";
+            }
+
+            presenter.surfaceLost();
+            presenter.rebuild(extent);
+            Testing::expectDies([&] { presenter.surfaceLost(); },
+                "the window's surface was lost again before a frame was shown on the one made after it");
+
+            device.waitIdle();
+            if (ValidationLog* log = instance.getValidationLog(); log != nullptr)
+            {
+                std::vector<std::string> raised;
+                log->takeErrorsOnThisThread(raised);
+                EXPECT_TRUE(raised.empty()) << raised.front();
+            }
+        }
+    }
+}
