# The checks every source of apps/ and components/ is held to (`omw tidy`): the classes of bug clang-tidy finds,
# and the rules AGENTS.md states where a check states them. A check that reports style alone, or whose findings
# in this tree were mostly what the code means, is left out:
# - `portability-avoid-pragma-once`: `#pragma once` is the fork's rule;
# - the static analyzer: every finding it made on the fork's sources was one it could not follow (a span's size
#   after an assert, a moved-from `shared_ptr`, a bound `std::find` keeps), and it is half a run's time;
# - `bugprone-easily-swappable-parameters`: every function of two parameters of one type, which only new types
#   across the APIs would answer;
# - `bugprone-signed-bitwise`: bit operations on Vulkan's and OSG's flags, which their APIs type as signed;
# - `bugprone-unchecked-optional-access`: blind to `Crash::contract` and gtest's `ASSERT_TRUE`;
# - `bugprone-throwing-static-initialization`: every constant string and table at namespace scope, whose failure
#   to allocate at startup ends the process either way;
# - `performance-enum-size`, `-no-int-to-ptr`, `-avoid-endl`: an enum's width is its API's, a Vulkan handle is an
#   integer, and `std::endl` is style;
# - `readability-make-member-function-const`: it makes `const` what changes state through a pointer it holds, a
#   widget's `setText` among them, and once a pair whose overloads then differed in their return type alone;
# - `cppcoreguidelines-slicing`: a base copied on purpose, a Lua self as the object it is, a store's base in its
#   copy;
# - `cppcoreguidelines-rvalue-reference-param-not-moved`: rvalue overloads beside their `const&` twins, and the holds
#   a `drop` consumes by taking them;
# - `cppcoreguidelines-no-malloc`: every `malloc` here is an allocator's own, Lua's, Recast's and the tests' count;
# - `cppcoreguidelines-virtual-class-destructor`: OpenSceneGraph's referenced classes and gtest's fixtures keep their
#   destructors protected and virtual by design, and every declaration of one is a finding;
# - `cppcoreguidelines-pro-type-reinterpret-cast`, `-pro-type-const-cast`: AGENTS.md allows each with a comment
#   saying why, which the checks cannot read, and each of the 330 is a byte buffer, a C API or OSG's;
# - `misc-static-assert`: it takes a run-time `assert` of a member call for a constant one;
# - `cert-msc51-cpp`: a seed fixed on purpose, so two runs draw the same world (`--random-seed`);
# - `cert-env33-c`: `Platform::Process::runShell` is the one place a command is handed to the shell, by design;
# - `readability-suspicious-call-argument`: each of its 27 was an order meant, a transpose, a door both ways, an
#   observer and the observed, a symmetry a test asserts;
# - `cppcoreguidelines-missing-std-forward`: each of its 164 a callable or a visitor called more than once, which a
#   forward at a call would move from before the next;
# - and checks of style alone, whose fixes would touch most of upstream's files for no fault: `misc-const-correctness`,
#   `readability-implicit-bool-conversion`, `-qualified-auto`, `-redundant-member-init`, `-use-anyofallof`,
#   `-simplify-boolean-expr`, `-static-accessed-through-instance`, `-redundant-smartptr-get`,
#   `modernize-use-default-member-init`, `-use-using`, `-avoid-c-arrays`, `-use-equals-default`, `-use-emplace`,
#   `cppcoreguidelines-prefer-member-initializer`, `-use-enum-class`, `-avoid-goto`.
# Under MSVC's driver `omw tidy` turns off the checks that misread MSVC's library (`tidycache._OFF_UNDER_MSVC`).
Checks:
  - '-*'
  - 'bugprone-*'
  - '-bugprone-easily-swappable-parameters'
  - '-bugprone-signed-bitwise'
  - '-bugprone-unchecked-optional-access'
  - '-bugprone-throwing-static-initialization'
  - 'performance-*'
  - '-performance-enum-size'
  - '-performance-no-int-to-ptr'
  - '-performance-avoid-endl'
  - 'portability-*'
  - '-portability-avoid-pragma-once'
  - '-portability-template-virtual-member-function'
  - cppcoreguidelines-special-member-functions
  - 'cppcoreguidelines-noexcept-*'
  - cppcoreguidelines-init-variables
  - cppcoreguidelines-pro-type-member-init
  - google-explicit-constructor
  - google-global-names-in-headers
  - google-build-namespaces
  - modernize-avoid-c-style-cast
  - modernize-use-override
  - modernize-use-integer-sign-comparison
  - modernize-use-scoped-lock
  - modernize-make-unique
  - modernize-make-shared
  - modernize-use-auto
  - modernize-loop-convert
  - modernize-use-starts-ends-with
  - modernize-use-std-bit
  - modernize-use-std-numbers
  - modernize-use-nullptr
  - modernize-use-noexcept
  - modernize-use-equals-delete
  - modernize-pass-by-value
  - misc-throw-by-value-catch-by-reference
  - misc-use-anonymous-namespace
  - misc-use-internal-linkage
  - misc-unused-using-decls
  - misc-unused-alias-decls
  - misc-redundant-expression
  - misc-definitions-in-headers
  - misc-include-cleaner
  - misc-misleading-bidirectional
  - misc-misleading-identifier
  - misc-confusable-identifiers
  - misc-uniqueptr-reset-release
  - misc-new-delete-overloads
  - misc-non-copyable-objects
  - misc-unconventional-assign-operator
  - misc-header-include-cycle
  - readability-container-contains
  - readability-container-size-empty
  - readability-container-data-pointer
  - readability-redundant-string-cstr
  - readability-redundant-casting
  - readability-use-std-min-max
  - readability-duplicate-include
  - readability-misleading-indentation
  - readability-identifier-naming
  - readability-inconsistent-declaration-parameter-name
  - readability-avoid-unconditional-preprocessor-if
  - readability-const-return-type
  - readability-non-const-parameter
  - readability-string-compare
  - readability-uniqueptr-delete-release
  - readability-misplaced-array-index
  - readability-reference-to-constructed-temporary
  - readability-redundant-declaration
  - concurrency-mt-unsafe
  - cert-dcl50-cpp
  - cert-err33-c
  - cert-err34-c
  - cert-flp30-c
  - cert-msc50-cpp
  - cert-oop57-cpp
  - hicpp-exception-baseclass
  - hicpp-multiway-paths-covered
WarningsAsErrors: '*'
# Either slash separates: clang-tidy matches these against a path as the system spells it, which on Windows joins an
# include folder to what the directive names with a backslash.
HeaderFilterRegex: '(apps|components)[/\\]'
# Generated sources are their generator's, and the headers GLSL reads as well spell what GLSL can.
ExcludeHeaderFilterRegex: '(_autogen[/\\]|[/\\]shaders[/\\].*\.h$)'
CheckOptions:
  # A product of constants is computed by the compiler, which refuses one that overflows.
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
  # A script that does not compile has reported why to the error handler before it throws.
  bugprone-empty-catch.AllowEmptyCatchForExceptions: 'Compiler::SourceException'
  # A source may lean on its own header for what that header's interface needs (AGENTS.md), which the missing
  # half of the check does not know; and OSG's GL header brings the GL macros through the system's. MSVC's library
  # and the Windows SDK declare each name in an inner header the check has no table of, as it has libstdc++'s, where
  # their documentation names the header to include (`Windows.h` for `processthreadsapi.h`); `misc/windows.hpp` is
  # the tree's way to `Windows.h`.
  misc-include-cleaner.MissingIncludes: false
  misc-include-cleaner.IgnoreHeaders: 'osg[/\\]GL;GL[/\\].*;misc[/\\]windows\.hpp;VC[/\\]Tools[/\\]MSVC[/\\].*;Windows Kits[/\\].*'
  # What a source keeps to itself goes in an unnamed namespace, never `static`, which the fix would write.
  misc-use-internal-linkage.FixMode: None
  cppcoreguidelines-init-variables.MathHeader: '<cmath>'
  # Only a literal that is the constant to a float's precision: 0.435 is not log10(e), however near.
  modernize-use-std-numbers.DiffThreshold: '0.000001'
  # What glibc's manual marks unsafe among threads: `getenv` is safe beside no `setenv`, which nothing calls once the
  # game's threads start.
  concurrency-mt-unsafe.FunctionSet: glibc
  # A class that declares its destructor or a copy declares all three; one that declares a move, both. Its moves
  # may stay undeclared: a class with deleted copies is then not movable either, and a copyable one copies an rvalue
  # (Hinnant's table; Chromium's C++ Dos and Don'ts), which a deleted move would refuse.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions: true
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.NamespaceIgnoredRegexp: 'bpo|osg(DB|FX|Particle|Shadow|Viewer|Util)?|crashpad'
  readability-identifier-naming.ParameterCase: camelBack
