# What `omw tidy` holds every source of apps/ and components/ to: the classes of bug clang-tidy finds, and AGENTS.md's
# rules where a check states one. A refused check is a `-` entry with its reason; a check of style alone is left out.
# Under MSVC's driver `omw tidy` also turns off the checks that misread MSVC's library (`tidycache._OFF_UNDER_MSVC`).
Checks:
  - '-*'
  # Every finding it made on the fork's sources was one it could not follow (a span's size after an assert, a
  # moved-from `shared_ptr`), and it is half a run's time.
  - '-clang-analyzer-*'

  - 'bugprone-*'
  # Every function of two parameters of one type, which only new types across the APIs would answer.
  - '-bugprone-easily-swappable-parameters'
  # Vulkan's and OSG's flags, which their APIs type as signed.
  - '-bugprone-signed-bitwise'
  # Every constant string and table at namespace scope, whose failure to allocate at startup ends the process anyway.
  - '-bugprone-throwing-static-initialization'
  # Blind to `Crash::contract` and gtest's `ASSERT_TRUE`.
  - '-bugprone-unchecked-optional-access'

  - 'performance-*'
  # `std::endl` is style.
  - '-performance-avoid-endl'
  # An enum's width is its API's.
  - '-performance-enum-size'
  # A Vulkan handle is an integer.
  - '-performance-no-int-to-ptr'

  - 'portability-*'
  # `#pragma once` is the fork's rule.
  - '-portability-avoid-pragma-once'
  # Upstream's: `Settings::Sanitizer`'s pure virtual member, which no compiler has a problem with.
  - '-portability-template-virtual-member-function'

  - 'cert-dcl50-cpp'
  - 'cert-err33-c'
  - 'cert-err34-c'
  - 'cert-flp30-c'
  - 'cert-msc50-cpp'
  - 'cert-oop57-cpp'
  # `Platform::Process::runShell` is the one place a command is handed to the shell, by design.
  - '-cert-env33-c'
  # A seed fixed on purpose, so two runs draw the same world (`--random-seed`).
  - '-cert-msc51-cpp'

  - 'concurrency-mt-unsafe'

  - 'cppcoreguidelines-init-variables'
  - 'cppcoreguidelines-macro-usage'
  - 'cppcoreguidelines-noexcept-*'
  - 'cppcoreguidelines-pro-type-member-init'
  - 'cppcoreguidelines-special-member-functions'
  # Each of its 164 a callable or a visitor called more than once, which a forward would move from before the next.
  - '-cppcoreguidelines-missing-std-forward'
  # Every `malloc` here is an allocator's own: Lua's, Recast's and the tests' counting one.
  - '-cppcoreguidelines-no-malloc'
  # AGENTS.md allows each with a comment saying why, which the checks cannot read; each of the 330 is a byte buffer,
  # a C API or OSG's.
  - '-cppcoreguidelines-pro-type-const-cast'
  - '-cppcoreguidelines-pro-type-reinterpret-cast'
  # Rvalue overloads beside their `const&` twins, and the holds a `drop` consumes by taking them.
  - '-cppcoreguidelines-rvalue-reference-param-not-moved'
  # A base copied on purpose, a Lua self as the object it is, a store's base in its copy.
  - '-cppcoreguidelines-slicing'
  # OSG's referenced classes and gtest's fixtures keep their destructors protected and virtual by design.
  - '-cppcoreguidelines-virtual-class-destructor'

  - 'google-build-namespaces'
  - 'google-explicit-constructor'
  - 'google-global-names-in-headers'

  - 'misc-confusable-identifiers'
  - 'misc-definitions-in-headers'
  - 'misc-header-include-cycle'
  - 'misc-include-cleaner'
  - 'misc-misleading-bidirectional'
  - 'misc-misleading-identifier'
  - 'misc-new-delete-overloads'
  - 'misc-non-copyable-objects'
  - 'misc-redundant-expression'
  - 'misc-throw-by-value-catch-by-reference'
  - 'misc-unconventional-assign-operator'
  - 'misc-uniqueptr-reset-release'
  - 'misc-unused-alias-decls'
  - 'misc-unused-using-decls'
  - 'misc-use-anonymous-namespace'
  - 'misc-use-internal-linkage'
  # It takes a run-time `assert` of a member call for a constant one.
  - '-misc-static-assert'

  - 'modernize-avoid-c-style-cast'
  - 'modernize-loop-convert'
  - 'modernize-make-shared'
  - 'modernize-make-unique'
  - 'modernize-pass-by-value'
  - 'modernize-use-auto'
  - 'modernize-use-equals-delete'
  - 'modernize-use-integer-sign-comparison'
  - 'modernize-use-noexcept'
  - 'modernize-use-nullptr'
  - 'modernize-use-override'
  - 'modernize-use-scoped-lock'
  - 'modernize-use-starts-ends-with'
  - 'modernize-use-std-bit'
  - 'modernize-use-std-numbers'

  - 'readability-avoid-unconditional-preprocessor-if'
  - 'readability-const-return-type'
  - 'readability-container-contains'
  - 'readability-container-data-pointer'
  - 'readability-container-size-empty'
  - 'readability-duplicate-include'
  - 'readability-identifier-naming'
  - 'readability-inconsistent-declaration-parameter-name'
  - 'readability-misleading-indentation'
  - 'readability-misplaced-array-index'
  - 'readability-non-const-parameter'
  - 'readability-redundant-casting'
  - 'readability-redundant-declaration'
  - 'readability-redundant-string-cstr'
  - 'readability-reference-to-constructed-temporary'
  - 'readability-string-compare'
  - 'readability-uniqueptr-delete-release'
  - 'readability-use-std-min-max'
  # It makes `const` what changes state through a pointer it holds, a widget's `setText` among them.
  - '-readability-make-member-function-const'
  # Each of its 27 an order meant: a transpose, a door both ways, an observer and the observed.
  - '-readability-suspicious-call-argument'

  # Style alone, whose fixes would touch most of upstream's files for no fault.
  - '-cppcoreguidelines-avoid-goto'
  - '-cppcoreguidelines-prefer-member-initializer'
  - '-cppcoreguidelines-use-enum-class'
  - '-misc-const-correctness'
  - '-modernize-avoid-c-arrays'
  - '-modernize-use-default-member-init'
  - '-modernize-use-emplace'
  - '-modernize-use-equals-default'
  - '-modernize-use-using'
  - '-readability-implicit-bool-conversion'
  - '-readability-qualified-auto'
  - '-readability-redundant-member-init'
  - '-readability-redundant-smartptr-get'
  - '-readability-simplify-boolean-expr'
  - '-readability-static-accessed-through-instance'
  - '-readability-use-anyofallof'

  # Candidates, off until `omw tidy` has counted what each finds. These should find little or nothing:
  # - 'cppcoreguidelines-interfaces-global-init'
  # - 'misc-misplaced-const'
  # - 'misc-static-initialization-cycle'
  # - 'readability-ambiguous-smartptr-reset-call'
  # - 'readability-enum-initial-value'
  # - 'readability-redundant-preprocessor'
  # - 'readability-static-definition-in-anonymous-namespace'
  # These will find some, mostly in upstream's code:
  # - 'cppcoreguidelines-avoid-non-const-global-variables'
  # - 'cppcoreguidelines-misleading-capture-default-by-value'
  # - 'google-default-arguments'
  # - 'misc-override-with-different-visibility'
WarningsAsErrors: '*'
# Either slash separates: on Windows, clang-tidy joins an include folder to the directive's path with a backslash.
HeaderFilterRegex: '(apps|components)[/\\]'
# Generated sources are their generator's, and the headers GLSL reads as well spell what GLSL can.
ExcludeHeaderFilterRegex: '(_autogen[/\\]|[/\\]shaders[/\\].*\.h$)'
CheckOptions:
  # A script that does not compile has reported why to the error handler before it throws.
  bugprone-empty-catch.AllowEmptyCatchForExceptions: 'Compiler::SourceException'
  # A product of constants is computed by the compiler, which refuses one that overflows.
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
  # What glibc's manual marks unsafe among threads: `getenv` is safe beside no `setenv`, which nothing calls once the
  # game's threads start.
  concurrency-mt-unsafe.FunctionSet: glibc
  cppcoreguidelines-init-variables.MathHeader: '<cmath>'
  # The build's definitions are the build's switches, read into `constexpr bool`s (`cpp.md`).
  cppcoreguidelines-macro-usage.IgnoreCommandLineMacros: true
  # A class that declares its destructor or a copy declares all three; one that declares a move, both. Its moves may
  # stay undeclared: a class with deleted copies is then not movable either, and a copyable one copies an rvalue
  # (Hinnant's table), which a deleted move would refuse.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions: true
  # A source may lean on its own header for what that header's interface needs (AGENTS.md), which the missing half
  # does not know. OSG's GL header brings the GL macros through the system's, and MSVC's library and the Windows SDK
  # declare each name in an inner header the check has no table of; `misc/windows.hpp` is the tree's `Windows.h`.
  misc-include-cleaner.MissingIncludes: false
  misc-include-cleaner.IgnoreHeaders: 'osg[/\\]GL;GL[/\\].*;misc[/\\]windows\.hpp;VC[/\\]Tools[/\\]MSVC[/\\].*;Windows Kits[/\\].*'
  # A source keeps to itself in an unnamed namespace, never `static`, which the fix would write.
  misc-use-internal-linkage.FixMode: None
  # Only a literal that is the constant to a float's precision: 0.435 is not log10(e), however near.
  modernize-use-std-numbers.DiffThreshold: '0.000001'
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.NamespaceIgnoredRegexp: 'bpo|osg(DB|FX|Particle|Shadow|Viewer|Util)?|crashpad'
  readability-identifier-naming.ParameterCase: camelBack
