{
  "$comment": "The libraries the tree builds against, pinned by the vcpkg registry and tool pins.py names and built static by the triplets in vcpkg/triplets: `omw deps-set` builds a set, CI publishes it, and every build downloads it. The projects the tree compiles from source itself stay in cmake/Dependencies.cmake. On Linux the set carries the Vulkan loader too, the one library built shared, which the AppImage ships and volk opens: a system's may be older than the renderer is written against.",
  "dependencies": [
    "boost-geometry",
    "boost-iostreams",
    "boost-program-options",
    {
      "name": "bullet3",
      "features": [
        "double-precision"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "freetype",
    "icu",
    "luajit",
    "lz4",
    "mygui",
    "openal-soft",
    "openmw-osg",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "concurrent",
        "doubleconversion",
        "freetype",
        "gui",
        "harfbuzz",
        "jpeg",
        "network",
        "opengl",
        "pcre2",
        "png",
        "thread",
        "widgets",
        "zstd",
        {
          "name": "egl",
          "platform": "linux"
        },
        {
          "name": "fontconfig",
          "platform": "linux"
        },
        {
          "name": "openssl",
          "platform": "linux"
        },
        {
          "name": "wayland",
          "platform": "linux"
        },
        {
          "name": "xcb",
          "platform": "linux"
        },
        {
          "name": "xcb-xlib",
          "platform": "linux"
        }
      ]
    },
    "qtsvg",
    "qttranslations",
    {
      "name": "qttools",
      "default-features": false,
      "features": [
        "linguist"
      ]
    },
    {
      "name": "qtwayland",
      "platform": "linux"
    },
    "shaderc",
    "spirv-headers",
    {
      "name": "spirv-tools",
      "features": [
        "tools"
      ]
    },
    {
      "name": "unshield",
      "platform": "linux"
    },
    "vulkan-headers",
    {
      "name": "vulkan-loader",
      "platform": "linux",
      "features": [
        "wayland",
        "xcb",
        "xlib"
      ]
    },
    "zlib"
  ]
}
